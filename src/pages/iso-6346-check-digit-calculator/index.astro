    .calc-out-a{padding:28px 30px 30px;border-right:2.5px solid var(--ink);display:flex;flex-direction:column;justify-content:center}
    .calc-out-b{padding:28px 30px 30px}
    .calc-out-k{display:block;opacity:.75;margin-bottom:12px;font-weight:700}
    .calc-big{font-family:var(--narrow);font-weight:700;font-size:clamp(30px,4.4vw,58px);text-transform:uppercase;line-height:.98;margin:0;letter-spacing:-.02em}
    /* The verdict field changes colour with the answer, and never relies on colour alone: the
       words say which it is, so a red/green confusion costs nothing. */
    .calc-out.is-pass{background:var(--c4-cost);color:var(--cream)}
    .calc-out.is-pass .calc-out-a,.calc-out.is-fail .calc-out-a,.calc-out.is-error .calc-out-a{border-right-color:var(--cream)}
    .calc-out.is-fail{background:var(--c2-cond);color:var(--cream)}
    .calc-out.is-error{background:var(--c5-permits);color:var(--ink)}
    .calc-out.is-calc{background:var(--yellow);color:var(--ink)}
    .calc-explain{margin:0;font-size:15.5px;line-height:1.62}
    .calc-parts{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:20px 0 0;border-top:2px solid currentColor}
    .calc-parts div{display:flex;flex-direction:column;gap:4px;padding:11px 0;border-bottom:1px solid currentColor}
    .calc-parts div:nth-child(odd){padding-right:16px;border-right:1px solid currentColor}
    .calc-parts div:nth-child(even){padding-left:16px}
    .calc-parts .m{opacity:.75}
    .calc-parts b{font-family:var(--mono);font-size:15px;font-weight:500;letter-spacing:.04em}
    .calc-warn{margin:18px 0 0;padding:12px 14px;background:var(--ink);color:var(--cream);font-size:13.5px;line-height:1.6;border-left:6px solid var(--yellow)}

    /* The working. Its own plate below the answer. */
    .calc-work{margin:34px 0 0;background:var(--cream);color:var(--ink);border:2.5px solid var(--ink);box-shadow:14px 14px 0 var(--c3-deliver);padding:26px 28px 28px}
    .calc-work-h{font-family:var(--narrow);font-weight:700;font-size:24px;text-transform:uppercase;margin:0 0 8px;line-height:1.05}
    .calc-work-sub{margin:0 0 18px;font-size:14px;line-height:1.55;opacity:.78}

    .calc-nojs{background:var(--cream);color:var(--ink);border:2.5px solid var(--ink);border-top:10px solid var(--ink);box-shadow:14px 14px 0 var(--yellow);padding:26px 28px;font-size:14.5px;line-height:1.65}
    .calc-nojs strong{display:block;font-family:var(--narrow);font-weight:700;font-size:20px;text-transform:uppercase;margin-bottom:12px}
    .calc-nojs ol{margin:0 0 14px;padding-left:20px}
    .calc-nojs li{margin-bottom:6px}
    .calc-nojs p{margin:0}
    /* Everything except the paper method ships hidden and is switched on by the script. */
    .calc .calc-sheet,.calc .calc-out,.calc .calc-work{display:none}
    .calc.has-js .calc-sheet,.calc.has-js .calc-out{display:block}
    .calc.has-js .calc-work{display:block}
    .calc.has-js .calc-nojs{display:none}

    /* ============ ANATOMY ============ */
    .cd-anatomy{padding:72px 0;background:var(--cream);border-bottom:1.5px solid rgba(11,15,26,.1)}
    .anat-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:48px;align-items:start}
    .anat-body p{font-size:17px;line-height:1.68;margin:0 0 20px}
    .anat-body p:last-child{margin-bottom:0}
    .anat-body a{border-bottom:2px solid var(--c3-deliver);font-weight:700}
    .anat-card{background:var(--ink);color:var(--cream);border:2.5px solid var(--ink);box-shadow:10px 10px 0 var(--c3-deliver);padding:26px 28px}
    .anat-card-k{display:block;color:var(--yellow);margin-bottom:16px}
    .anat-num{font-family:var(--mono);font-size:clamp(20px,2.6vw,30px);letter-spacing:.06em;margin:0 0 22px;line-height:1.3;word-break:break-all}
    .anat-num span{padding:2px 4px}
    .anat-owner{background:var(--yellow);color:var(--ink)}
    .anat-cat{background:var(--c5-permits);color:var(--ink)}
    .anat-serial{background:var(--cream);color:var(--ink)}
    .anat-check{background:var(--c4-cost);color:var(--cream);outline:2px solid var(--cream);outline-offset:2px}
    .anat-key{margin:0;display:grid;gap:0}
    .anat-key div{padding:11px 0;border-top:1px solid rgba(246,241,231,.18)}
    .anat-key dt{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;display:flex;align-items:center;gap:8px;margin:0 0 5px;color:var(--yellow)}
    .anat-key dd{margin:0;font-size:14.5px;line-height:1.55;opacity:.9}
    .sw{width:11px;height:11px;display:inline-block;flex:none}
    .sw-owner{background:var(--yellow)}
    .sw-cat{background:var(--c5-permits)}
    .sw-serial{background:var(--cream)}
    .sw-check{background:var(--c4-cost)}
    .anat-cats{margin:44px 0 0;max-width:900px;background:#fff;border:2px solid var(--ink);border-left:8px solid var(--c5-permits);box-shadow:8px 8px 0 var(--ink);padding:26px 28px}
    .anat-cats h3{font-family:var(--narrow);font-weight:700;font-size:22px;text-transform:uppercase;margin:0 0 10px;line-height:1.1}
    .anat-cats p{font-size:15.5px;line-height:1.62;margin:0}
    .cat-list{list-style:none;padding:0;margin:18px 0}
    .cat-list li{display:flex;gap:16px;align-items:baseline;padding:10px 0;border-top:1px solid rgba(11,15,26,.14)}
    .cat-list b{font-family:var(--narrow);font-weight:700;font-size:26px;line-height:1;width:1.2em;flex:none}
    .cat-list span{font-size:15px;line-height:1.5}
    .anat-cats-note{opacity:.85;font-size:14.5px!important}

    /* ============ METHOD ============ */
    .cd-method{padding:72px 0;background:var(--ink);color:var(--cream)}
    .cd-method .cd-h2{color:var(--cream)}
    .cd-method .cd-sh-sub{opacity:.8}
    .method-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 0 48px;align-items:start}
    .method-step{border:2px dashed rgba(246,241,231,.4);padding:22px 24px}
    .method-step .m{display:block;color:var(--yellow);margin-bottom:10px}
    .method-step h3{font-family:var(--narrow);font-weight:700;font-size:21px;text-transform:uppercase;line-height:1.12;margin:0 0 10px}
    .method-step p{margin:0;font-size:14.5px;line-height:1.62;opacity:.88}
    .method-tables{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:44px;align-items:start}
    .method-table-h{font-family:var(--narrow);font-weight:700;font-size:24px;text-transform:uppercase;line-height:1.05;margin:0 0 10px;color:var(--yellow)}
    .method-table-sub{font-size:14.5px;line-height:1.6;opacity:.82;margin:0 0 18px}
    .method-table-note{font-size:13.5px;line-height:1.6;opacity:.78;margin:16px 0 0;border-left:2.5px solid var(--yellow);padding-left:12px}
    /* align-items:start, not the grid default. The three columns hold 9, 9 and 8 letters, and a
       stretched 8-row table distributes the spare height into its rows, so the third column's
       rows stopped lining up with the other two. */
    .letter-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:start}
    .cd-table-letters tbody th{background:var(--ink);color:var(--cream);font-size:12px;font-weight:700}
    .cd-table-letters tbody td{text-align:right}
    /* No drop shadow on the letter columns: three of them side by side turns into yellow stripes. */
    .method-tables .cd-table-work{box-shadow:8px 8px 0 var(--yellow)}

    /* ============ LIMITS ============ */
    .cd-limits{padding:72px 0;background:#fff;border-bottom:1.5px solid rgba(11,15,26,.1)}
    .limits-intro{font-size:17px;line-height:1.65;margin:0 0 34px;max-width:900px;padding:26px 28px;background:var(--ink);color:var(--cream);border-left:10px solid var(--c2-cond)}
    .cd-table-limits{min-width:760px;box-shadow:12px 12px 0 var(--ink)}
    .cd-table-limits .rt-rowhead{width:28%}
    .cd-table-limits tbody th{font-family:var(--narrow);font-size:18px;font-weight:700;text-transform:uppercase;letter-spacing:0;line-height:1.14;background:var(--ink);color:var(--cream)}
    .cd-table-limits tbody td{font-family:var(--display);font-size:15px;line-height:1.58}
    .cd-table-limits tbody td a{border-bottom:2px solid var(--c3-deliver);font-weight:700}
    .limits-notes{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:40px 0 0}
    .limits-note{background:var(--cream);border:2px solid var(--ink);border-left:8px solid var(--c3-deliver);box-shadow:8px 8px 0 var(--ink);padding:24px 26px}
    .limits-note strong{display:block;font-family:var(--narrow);font-weight:700;font-size:21px;text-transform:uppercase;line-height:1.12;margin-bottom:10px}
    .limits-note p{margin:0;font-size:15px;line-height:1.62}

    /* ============ OFFICIAL ============ */
    .cd-official{padding:72px 0;background:var(--c3-deliver);color:var(--cream)}
    .cd-official .cd-h2{color:var(--cream)}
    .cd-official .cd-sh{border-top-color:var(--yellow)}
    .cd-official .cd-sh .m{color:var(--yellow);opacity:1}
    .official-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:44px;align-items:start}
    .official-body p{font-size:17px;line-height:1.66;margin:0 0 20px;opacity:.94}
    .official-body p:last-child{margin-bottom:0}
    .official-card{background:var(--cream);color:var(--ink);border:2.5px solid var(--ink);box-shadow:12px 12px 0 var(--ink);padding:28px 30px}
    .official-card-k{display:block;opacity:.7;margin-bottom:14px;font-weight:700}
    .official-card h3{font-family:var(--narrow);font-weight:700;font-size:clamp(24px,2.6vw,32px);text-transform:uppercase;line-height:1.05;margin:0 0 12px}
    .official-card p{margin:0 0 18px;font-size:15px;line-height:1.6}
    .official-link{display:inline-block;font-family:var(--mono);font-size:13px;letter-spacing:.02em;font-weight:500;border-bottom:3px solid var(--c3-deliver);word-break:break-all;padding-bottom:2px}
    .official-link:hover{color:var(--c3-deliver)}
    .official-fine{margin:18px 0 0!important;font-size:12.5px!important;line-height:1.6;opacity:.8;border-left:2.5px solid var(--ink);padding-left:12px}

    /* ============ FAQ ============ */
    .cd-faq{padding:72px 0;background:var(--cream)}
    .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
    .faq-card{background:#fff;border:2px solid var(--ink);border-left:8px solid var(--c3-deliver);box-shadow:8px 8px 0 var(--ink);padding:24px 26px}
    .faq-card h3{font-family:var(--narrow);font-weight:700;font-size:21px;text-transform:uppercase;line-height:1.15;margin:0 0 12px}
    .faq-card p{margin:0;font-size:15.5px;line-height:1.62}

    /* ============ NEXT ============ */
    .cd-next{padding:56px 0;background:var(--ink);color:var(--cream);border-top:2px solid rgba(255,255,255,.08)}
    .cd-next-intro{font-size:16.5px;line-height:1.65;max-width:860px;margin:0 0 36px;opacity:.86}
    .cd-next-intro a{border-bottom:2px solid var(--yellow);font-weight:700}
    .cd-next-label{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--yellow);margin:0 0 16px}
    .cd-next-links{display:flex;flex-wrap:wrap;gap:20px}
    .cd-next-links a{font-family:var(--narrow);font-size:17px;font-weight:600;color:var(--cream);border-bottom:2px solid rgba(255,255,255,.2);padding-bottom:2px}
    .cd-next-links a:hover{color:var(--yellow);border-color:var(--yellow)}

    /* ============ RESPONSIVE ============ */
    @media (max-width:1080px){
      .method-steps{grid-template-columns:1fr}
      .method-tables,.anat-grid,.official-grid,.limits-notes,.faq-grid{grid-template-columns:1fr}
      .method-tables,.anat-grid,.official-grid{gap:36px}
      .calc-out-grid{grid-template-columns:1fr}
      .calc-out-a{border-right:none;border-bottom:2.5px solid var(--ink)}
      .calc-out.is-pass .calc-out-a,.calc-out.is-fail .calc-out-a,.calc-out.is-error .calc-out-a{border-bottom-color:var(--cream)}
    }
    @media (max-width:960px){
      .cd-hero{padding:36px 0 48px}
      .cd-tool,.cd-anatomy,.cd-method,.cd-limits,.cd-official,.cd-faq{padding:60px 0}
      .cd-table-hint{display:block;margin-top:6px;opacity:.9}
      .letter-cols{grid-template-columns:1fr 1fr}
    }
    @media (max-width:720px){
      .cd-statement{padding:22px;box-shadow:6px 6px 0 rgba(11,15,26,.35)}
      .calc-sheet,.calc-nojs{padding:22px 20px;box-shadow:7px 7px 0 var(--yellow)}
      .calc-out{box-shadow:7px 7px 0 var(--cream)}
      .calc-out-a,.calc-out-b{padding:22px 20px}
      .calc-work{padding:22px 20px;box-shadow:7px 7px 0 var(--c3-deliver)}
      .calc-field input{font-size:19px;padding:14px}
      .calc-parts{grid-template-columns:1fr}
      .calc-parts div:nth-child(odd){padding-right:0;border-right:none}
      .calc-parts div:nth-child(even){padding-left:0}
      .anat-cats,.limits-note,.faq-card,.official-card{padding:20px}
      .limits-intro{padding:20px 22px}
      .cd-table-limits{box-shadow:6px 6px 0 var(--ink)}
      .method-tables .cd-table{box-shadow:6px 6px 0 var(--yellow)}
      .anat-card{box-shadow:6px 6px 0 var(--c3-deliver)}
    }
  </style>
</BaseLayout>
