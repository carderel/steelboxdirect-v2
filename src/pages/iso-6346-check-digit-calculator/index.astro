    .cd-table :global(tbody td){padding:12px 16px;font-family:var(--mono);font-size:14px;line-height:1.5;border-bottom:1px solid rgba(11,15,26,.12);border-left:1px solid rgba(11,15,26,.12);vertical-align:top}
