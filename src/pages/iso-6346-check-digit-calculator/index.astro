  <script>
    /* ISO 6346 check digit calculator. The arithmetic itself is NOT here: it is imported from
       src/lib/iso6346.ts, which is unit tested in src/lib/iso6346.test.ts. This file is only the
       wiring between the input field and the result panel. No network call, no storage, no
       libraries. Same bundled-script pattern as src/pages/quote/index.astro. */
    import { analyzeContainerNumber } from '../../lib/iso6346';

    const wrap = document.getElementById('cd-calc-wrap');
    if (wrap) wrap.classList.add('has-js');

    const form = document.getElementById('cd-form') as HTMLFormElement | null;
    const input = document.getElementById('cd-input') as HTMLInputElement | null;

    if (form && input) {
      const verdictEl = document.getElementById('cd-verdict') as HTMLElement;
      const explainEl = document.getElementById('cd-explain') as HTMLElement;
      const partsEl = document.getElementById('cd-parts') as HTMLElement;
      const ownerEl = document.getElementById('cd-owner') as HTMLElement;
      const categoryEl = document.getElementById('cd-category') as HTMLElement;
      const serialEl = document.getElementById('cd-serial') as HTMLElement;
      const digitEl = document.getElementById('cd-digit') as HTMLElement;
      const warnEl = document.getElementById('cd-warn') as HTMLElement;
      const workEl = document.getElementById('cd-work') as HTMLElement;
      const workSubEl = document.getElementById('cd-work-sub') as HTMLElement;
      const rowsEl = document.getElementById('cd-work-rows') as HTMLElement;
      const footEl = document.getElementById('cd-work-foot') as HTMLElement;
      const outEl = document.getElementById('cd-out') as HTMLElement;
      const resetBtn = document.getElementById('cd-reset') as HTMLButtonElement | null;

      const DEFAULT_VERDICT = verdictEl.textContent ?? '';
      const DEFAULT_EXPLAIN = explainEl.textContent ?? '';

      const n = (v: number): string => v.toLocaleString('en-US');

      /* classList rather than className: assigning className would strip the scoped style
         attribute Astro puts on this element. */
      function setState(state: 'idle' | 'pass' | 'fail' | 'calc' | 'error'): void {
        for (const s of ['is-pass', 'is-fail', 'is-calc', 'is-error']) outEl.classList.remove(s);
        if (state !== 'idle') outEl.classList.add(`is-${state}`);
      }

      function cell(tag: 'th' | 'td', text: string, cls?: string, scope?: string): HTMLElement {
        const el = document.createElement(tag);
        el.textContent = text;
        if (cls) el.className = cls;
        if (scope) el.setAttribute('scope', scope);
        return el;
      }

      function footRow(label: string, value: string, cls: string): HTMLTableRowElement {
        const tr = document.createElement('tr');
        tr.className = cls;
        const th = cell('th', label, undefined, 'row');
        th.setAttribute('colspan', '4');
        tr.appendChild(th);
        tr.appendChild(cell('td', value, 'is-hi'));
        return tr;
      }

      function clearWork(): void {
        rowsEl.replaceChildren();
        footEl.replaceChildren();
        workEl.hidden = true;
      }

      /* Hiding the parts panel is not the same as emptying it. A stale owner code sitting behind
         hidden is one CSS regression away from being a wrong answer on screen, so it gets wiped. */
      function clearParts(): void {
        for (const el of [ownerEl, categoryEl, serialEl, digitEl]) el.textContent = '-';
        partsEl.hidden = true;
      }

      function render(): void {
        const r = analyzeContainerNumber(input.value);

        if (r.error) {
          setState(r.error.code === 'empty' ? 'idle' : 'error');
          verdictEl.textContent = r.error.code === 'empty' ? DEFAULT_VERDICT : 'That is not a number this can check yet';
          explainEl.textContent = r.error.code === 'empty' ? DEFAULT_EXPLAIN : r.error.message;
          clearParts();
          warnEl.hidden = true;
          clearWork();
          return;
        }

        ownerEl.textContent = r.ownerCode ?? '-';
        categoryEl.textContent = r.categoryMeaning
          ? `${r.categoryLetter}, ${r.categoryMeaning.toLowerCase()}`
          : `${r.categoryLetter}, not an ISO category letter`;
        serialEl.textContent = r.serial ?? '-';
        digitEl.textContent = r.mode === 'validate'
          ? `${r.givenCheckDigit} given, ${r.checkDigit} computed`
          : `${r.checkDigit}, computed`;
        partsEl.hidden = false;

        if (r.warnings.length > 0) {
          warnEl.textContent = r.warnings.map((w) => w.message).join(' ');
          warnEl.hidden = false;
        } else {
          warnEl.hidden = true;
        }

        if (r.mode === 'calculate') {
          setState('calc');
          verdictEl.textContent = `Check digit ${r.checkDigit}`;
          explainEl.textContent = `The full number is ${r.normalized}${r.checkDigit}. `
            + `The ten characters you entered sum to ${n(r.sum as number)}, and ${n(r.sum as number)} `
            + `divided by 11 leaves a remainder of ${r.remainder}`
            + (r.remainder === 10 ? ', which folds to a check digit of 0.' : '.');
        } else if (r.valid) {
          setState('pass');
          verdictEl.textContent = 'Checks out';
          explainEl.textContent = `${r.normalized} is internally consistent: the arithmetic on the `
            + `first ten characters gives ${r.checkDigit}, and ${r.checkDigit} is what is in the box `
            + 'at the end. That means the number was almost certainly written down correctly. It does '
            + 'not mean anything about the container itself, which is what the rest of this page is about.';
        } else {
          setState('fail');
          verdictEl.textContent = 'Does not check out';
          explainEl.textContent = `The arithmetic on the first ten characters of ${r.normalized} gives `
            + `${r.checkDigit}, but the eleventh character is ${r.givenCheckDigit}. Read the number off `
            + 'the container again before you conclude anything: 8 and B, 0 and O, 1 and I, and 5 and S '
            + 'are all easy to confuse on a worn stencil.';
        }

        rowsEl.replaceChildren();
        for (const s of r.steps) {
          const tr = document.createElement('tr');
          tr.appendChild(cell('th', String(s.position), undefined, 'row'));
          tr.appendChild(cell('td', s.char, 'cd-char'));
          tr.appendChild(cell('td', String(s.value)));
          tr.appendChild(cell('td', n(s.weight)));
          tr.appendChild(cell('td', n(s.product), 'is-hi'));
          rowsEl.appendChild(tr);
        }

        const sum = r.sum as number;
        const quotient = Math.floor(sum / 11);
        footEl.replaceChildren();
        footEl.appendChild(footRow('Sum of the ten products', n(sum), 'cd-sum'));
        footEl.appendChild(footRow(
          `${n(sum)} divided by 11 is ${n(quotient)}, remainder`, String(r.remainder), 'cd-mod'));
        footEl.appendChild(footRow(
          r.remainder === 10
            ? 'Check digit, after a remainder of 10 folds to 0'
            : 'Check digit',
          String(r.checkDigit), 'cd-result'));

        workSubEl.textContent = r.mode === 'validate'
          ? `Every step for ${r.normalized.slice(0, 10)}, the first ten characters of ${r.normalized}.`
          : `Every step for ${r.normalized}, the ten characters you entered.`;
        workEl.hidden = false;
      }

      form.addEventListener('submit', (e) => { e.preventDefault(); render(); });
      input.addEventListener('input', render);
      resetBtn?.addEventListener('click', () => {
        input.value = '';
        render();
        input.focus();
      });
      render();
    }
  </script>

