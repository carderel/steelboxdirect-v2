  <script is:inline>
    /* Rental arithmetic. No libraries, no network, no storage. The wrapper class flips the
       JS-only block on immediately so the paper fallback does not flash. Both inputs start
       EMPTY on purpose: a seeded figure on this page reads as a Steel Box Direct price. */
    (function () {
      var wrap = document.getElementById('rent-calc-wrap');
      if (wrap) wrap.classList.add('has-js');

      var form = document.getElementById('rent-calc');
      if (!form) return;

      var rateEl = document.getElementById('calc-rate');
      var monthsEl = document.getElementById('calc-months');
      var totalEl = document.getElementById('calc-total');
      var afterEl = document.getElementById('calc-after');

      function money(n) {
        var hasCents = Math.round(n * 100) % 100 !== 0;
        return '$' + n.toLocaleString('en-US', {
          minimumFractionDigits: hasCents ? 2 : 0,
          maximumFractionDigits: 2
        });
      }

      function update() {
        var rate = parseFloat(rateEl.value);
        var months = parseFloat(monthsEl.value);

        if (!isFinite(rate) || !isFinite(months) || rate < 0 || months < 0) {
          totalEl.textContent = 'Enter both numbers';
          afterEl.textContent = 'Put in the monthly rate you were quoted and the number of months you actually need it, and the total appears here.';
          return;
        }

        var total = rate * months;
        var monthWord = (months === 1) ? 'month' : 'months';

        totalEl.textContent = money(total) + ' paid in total';
        afterEl.textContent = 'That is ' + months + ' ' + monthWord + ' at ' + money(rate) +
          ' a month. That is what you will have paid, and on the last day the container goes back on a truck.';
      }

      form.addEventListener('submit', function (e) { e.preventDefault(); update(); });
      rateEl.addEventListener('input', update);
      monthsEl.addEventListener('input', update);
    })();
  </script>

