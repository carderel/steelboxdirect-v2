                These are average starting prices, not quotes. What you pay can land above or below,
                depending mostly on how far we deliver and current market supply.
                <b>Average as of {asOfLabel}</b>
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 7. CLOSING CTA ============ -->
  <section class="rr-cta" aria-labelledby="cta-h">
    <div class="wrap rr-cta-inner">
      <p class="m rr-cta-kicker">However it came out</p>
      <h2 id="cta-h">Whatever the number said, that is the number</h2>
      <p class="rr-cta-body">
        If the break-even lands past your finish date, rent. That is the right call, our rental guide is
        the useful page for you, and we would rather you go use it than fill in a form here.
      </p>
      <p class="rr-cta-body">
        If it lands before your finish date, or your need never had a finish date to begin with, then it
        is worth getting a real purchase number instead of comparing against an average. Tell us the
        size and your delivery zip and you get one all-in delivered figure back, on a used Wind and
        Water Tight container with a Lifetime Leak Warranty, across Ohio, Indiana, Kentucky, and western
        West Virginia. If you would rather spread it, we offer rent-to-own over 12, 24, 36, or 48 months
        with no traditional credit check, subject to approval by My Container Rental, the independent
        third party that administers the program, so approval is not ours to promise.
      </p>
      <p class="rr-cta-body">No pressure either way. The arithmetic above works whether or not you ever call us.</p>
      <div class="rr-cta-btns">
        <a href="/quote/" class="btn rr-btn-yellow">Get My Quote →</a>
        <a href="/container-rental-guide/" class="btn-ghost">Where to rent instead</a>
        <a href="/rent-to-own/" class="btn-ghost">How rent-to-own works</a>
      </div>
    </div>
  </section>

  <!-- ============ 8. CONTINUE RESEARCHING ============ -->
  <section class="rr-next" aria-labelledby="next-h">
    <div class="wrap">
      <p class="rr-next-label" id="next-h">Continue researching</p>
      <div class="rr-next-links">
        <a href="/cost/">What a container costs</a>
        <a href="/size/">What size do I need</a>
        <a href="/condition/">Condition grades explained</a>
        <a href="/delivery/">How delivery works</a>
        <a href="/permits/">Do I need a permit</a>
        <a href="/shipping-container-guides/">All guides</a>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Rent vs buy break-even arithmetic. No libraries, no network, no storage.
       The wrapper class flips the JS block on immediately so the paper fallback
       never flashes. Every box starts empty on purpose. The only price channel
       into this script is the rendered option value attributes. */
    (function () {
      var wrap = document.getElementById('rvb-calc-wrap');
      if (wrap) wrap.classList.add('has-js');

      var form = document.getElementById('rvb-form');
      if (!form) return;

      var rateEl = document.getElementById('calc-rate');
      var delEl = document.getElementById('calc-rent-delivery');
      var pickEl = document.getElementById('calc-rent-pickup');
      var buyEl = document.getElementById('calc-buy');
      var sizeEl = document.getElementById('calc-size');
      var monthsEl = document.getElementById('calc-months');

      var totalEl = document.getElementById('calc-total');
      var verdictEl = document.getElementById('calc-verdict');
      var statsEl = document.getElementById('calc-stats');
      var stTotalLabel = document.getElementById('st-total-label');
      var stTotal = document.getElementById('st-total');
      var stFees = document.getElementById('st-fees');
      var stBuy = document.getElementById('st-buy');
      var afterEl = document.getElementById('calc-after');
      var seedDisc = document.getElementById('calc-seed-disc');
      var rentWins = document.getElementById('calc-rentwins');
      var honestyEl = document.getElementById('calc-honesty');
      var resetBtn = document.getElementById('calc-reset');

      var DEFAULT_HONESTY = honestyEl.textContent;
      var seeded = false;

      function money(n) {
        var hasCents = Math.round(n * 100) % 100 !== 0;
        return '$' + n.toLocaleString('en-US', {
          minimumFractionDigits: hasCents ? 2 : 0,
          maximumFractionDigits: 2
        });
      }

      function num(el) {
        var v = parseFloat(el.value);
        return (isFinite(v) && v >= 0) ? v : 0;
      }

      function monthWord(n) { return n === 1 ? 'month' : 'months'; }

      function setBig(text, isNum) {
        /* classList, not className: assigning className would strip the scoped
           style attribute Astro puts on this element. */
        if (isNum) { totalEl.classList.add('is-num'); } else { totalEl.classList.remove('is-num'); }
        totalEl.innerHTML = '';
        if (isNum) {
          var label = document.createElement('span');
          label.className = 'mo';
          /* Trailing space so a screen reader says "Month 14", not "Month14". */
          label.textContent = 'Month ';
          totalEl.appendChild(label);
          totalEl.appendChild(document.createTextNode(text));
        } else {
          totalEl.textContent = text;
        }
      }

      function emptyState(headline, body) {
        setBig(headline, false);
        verdictEl.hidden = true;
        statsEl.hidden = true;
        rentWins.hidden = true;
        afterEl.textContent = body;
        honestyEl.textContent = DEFAULT_HONESTY;
        seedDisc.hidden = !seeded;
      }

      function update() {
        var rate = parseFloat(rateEl.value);
        var buy = parseFloat(buyEl.value);
        var oneTime = num(delEl) + num(pickEl);
        var monthsRaw = parseFloat(monthsEl.value);
        var hasMonths = isFinite(monthsRaw) && monthsRaw > 0;
        var months = hasMonths ? Math.round(monthsRaw) : 0;

        var rateOk = isFinite(rate) && rate > 0;
        var buyOk = isFinite(buy) && buy > 0;

        /* Nothing usable yet, or only one of the two required figures. Never throw an error. */
        if (!rateOk && !buyOk) {
          emptyState('Enter a monthly rate and a purchase price',
            'Put in the monthly rate you were quoted and what a container would cost to buy. The month where the rental total passes the purchase price appears here.');
          return;
        }
        if (!rateOk || !buyOk) {
          emptyState('One more number to go',
            'Add the other figure and the break-even month appears here.');
          return;
        }

        seedDisc.hidden = !seeded;
        stFees.textContent = money(oneTime);
        stBuy.textContent = money(buy);

        /* Case D. The one-time fees alone already match or beat the purchase price. */
        if (oneTime >= buy) {
          setBig('Before the first monthly payment', false);
          verdictEl.hidden = true;
          statsEl.hidden = false;
          stTotalLabel.textContent = 'One-time fees alone';
          stTotal.textContent = money(oneTime);
          rentWins.hidden = true;
          honestyEl.textContent = DEFAULT_HONESTY;
          afterEl.textContent = 'The delivery and pickup fees on their own come to ' + money(oneTime)
            + ', which already matches or beats a purchase price of ' + money(buy)
            + '. Check those two figures, because that is an unusual quote. If they are right, the monthly rate is not the number deciding this.';
          return;
        }

        /* The break-even month: the first whole month at which the running rental
           total is at or above the purchase price. Round up, never down. */
        var n = Math.ceil((buy - oneTime) / rate);
        if (n < 1) n = 1;

        setBig(String(n), true);
        statsEl.hidden = false;

        var feesClause = oneTime > 0 ? ', plus ' + money(oneTime) + ' in one-time rental fees' : '';

        if (!hasMonths) {
          /* Case A. Months left blank. The default result. */
          verdictEl.hidden = true;
          stTotalLabel.textContent = 'Rental total at month ' + n;
          stTotal.textContent = money(oneTime + rate * n);
          rentWins.hidden = true;
          honestyEl.textContent = DEFAULT_HONESTY;
          afterEl.textContent = 'At ' + money(rate) + ' a month' + feesClause + ', the rental passes '
            + money(buy) + ' in month ' + n + '. Everything you pay from month ' + n
            + ' onward is money that would have bought the container outright. At the end of the rental you hand it back.';
          return;
        }

        var rentalTotal = oneTime + rate * months;
        stTotalLabel.textContent = 'Total rental over ' + months + ' ' + monthWord(months);
        stTotal.textContent = money(rentalTotal);

        if (months < n) {
          /* Case B. Renting wins on this timeline, and we say so. */
          verdictEl.hidden = false;
          verdictEl.textContent = 'Renting costs less over ' + months + ' ' + monthWord(months);
          rentWins.hidden = false;
          honestyEl.textContent = DEFAULT_HONESTY;
          afterEl.textContent = 'Over ' + months + ' ' + monthWord(months) + ', the rental comes to '
            + money(rentalTotal) + ', which is ' + money(buy - rentalTotal) + ' less than buying at '
            + money(buy) + '. Renting does not overtake buying until month ' + n
            + ', and you are done before then. On these numbers renting is the better call, and you also get to hand the container back instead of owning something you no longer need.';
          return;
        }

        /* Case C. The timeline is at or past the break-even month. */
        verdictEl.hidden = false;
        verdictEl.textContent = money(rentalTotal) + ' over ' + months + ' ' + monthWord(months)
          + '. Break-even at month ' + n + '.';
        rentWins.hidden = true;
        honestyEl.textContent = DEFAULT_HONESTY;
        afterEl.textContent = 'By month ' + months + ' the rental has cost ' + money(rentalTotal)
          + ', which is ' + money(rentalTotal - buy) + ' more than buying at ' + money(buy)
          + '. It passed the purchase price in month ' + n
          + ', and it has been passing it every month since. At the end of month ' + months
          + ' the container goes back on a truck and you own nothing.';
      }

      sizeEl.addEventListener('change', function () {
        if (sizeEl.value) {
          buyEl.value = sizeEl.value;
          seeded = true;
        } else {
          seeded = false;
        }
        update();
      });

      buyEl.addEventListener('input', function () {
        /* Typing over the seeded figure means it is the reader's number now. */
        if (seeded && buyEl.value !== sizeEl.value) {
          seeded = false;
          sizeEl.value = '';
        }
        update();
      });

      [rateEl, delEl, pickEl, monthsEl].forEach(function (el) {
        el.addEventListener('input', update);
      });

      form.addEventListener('submit', function (e) { e.preventDefault(); update(); });

      resetBtn.addEventListener('click', function () {
        form.reset();
        seeded = false;
        emptyState('Enter a monthly rate and a purchase price',
          'Put in the monthly rate you were quoted and what a container would cost to buy. The month where the rental total passes the purchase price appears here.');
        rateEl.focus();
      });
    })();
  </script>

</BaseLayout>

<style>
  /* The user-agent [hidden] rule loses to the author rules below, so the four result slots
     that ship hidden would render in their empty state on first paint without this. */
  [hidden]{display:none!important}

  .rr-btn-yellow{background:var(--yellow);color:var(--ink);border-color:var(--yellow)}
  .rr-btn-yellow:hover{background:transparent;color:var(--yellow)}

  /* ============ SHARED SECTION HEADER ============ */
  .rr-sh{border-top:4px solid var(--ink);padding-top:18px;margin-bottom:40px}
  .rr-sh .m{display:block;opacity:.65;margin-bottom:10px}
  .rr-sh-dark{border-top-color:var(--yellow)}
  .rr-sh-dark .m{color:var(--yellow);opacity:1}
  .rr-h2{font-family:var(--narrow);font-weight:700;text-transform:uppercase;font-size:clamp(30px,4.5vw,48px);line-height:1;letter-spacing:-.01em;margin:0}
  .rr-sh-sub{font-size:17px;line-height:1.55;max-width:820px;margin:18px 0 0;opacity:.82}

  /* ============ HERO ============ */
  .rr-hero{background:var(--c3-deliver);color:var(--cream);padding:44px 0 56px;border-bottom:2.5px solid var(--ink)}
  .rr-crumbs{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.9;margin:0 0 24px}
  .rr-crumbs a{border-bottom:1px solid rgba(246,241,231,.4)}
  .rr-eyebrow{display:inline-flex;align-items:center;gap:14px;flex-wrap:wrap;border:2px solid var(--cream);padding:8px 14px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .rr-eyebrow .idx{font-weight:700}
  .rr-eyebrow .tg{opacity:.9}
  .rr-headline{font-family:var(--narrow);font-weight:700;text-transform:uppercase;font-size:clamp(38px,5.6vw,78px);line-height:1.02;letter-spacing:-.02em;margin:24px 0 0;max-width:18ch}
  .rr-headline .nb{white-space:nowrap}
  .rr-headline em{font-style:normal;background:var(--ink);color:var(--cream);padding:0 .1em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  .rr-statement{background:var(--ink);color:var(--cream);border:2.5px solid var(--ink);box-shadow:10px 10px 0 rgba(11,15,26,.35);padding:30px 32px;margin:34px 0 0;max-width:900px}
  .rr-statement .rr-statement-k{display:block;color:var(--yellow);margin-bottom:14px}
  .rr-statement p{margin:0;font-size:clamp(18px,2.1vw,24px);line-height:1.35;font-family:var(--narrow);font-weight:700;text-transform:uppercase;letter-spacing:-.01em}
  .rr-statement p.rr-statement-body{font-family:var(--display);font-weight:400;text-transform:none;letter-spacing:0;font-size:16.5px;line-height:1.6;opacity:.88;margin-top:16px}
  .rr-hero-jump{display:flex;flex-wrap:wrap;gap:12px;margin:28px 0 0;padding:0;list-style:none}
  .rr-hero-jump a{display:inline-block;border:2px solid var(--cream);padding:9px 14px;font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase}
  .rr-hero-jump a:hover{background:var(--cream);color:var(--c3-deliver)}

  /* ============ FIGURES (treatment lifted from the rental guide) ============ */
  .rr-fig{margin:0;border:2.5px solid var(--ink);background:#fff;box-shadow:8px 8px 0 var(--ink)}
  .rr-fig img{width:100%;height:auto;display:block;aspect-ratio:1200/654;object-fit:cover}
  .rr-fig figcaption{padding:15px 20px;border-top:2.5px solid var(--ink);font-size:14.5px;line-height:1.55;opacity:.88}
  .rr-fig figcaption b{font-family:var(--narrow);font-weight:700;text-transform:uppercase;letter-spacing:.01em;opacity:1}
  .rr-fig-dark{border-color:var(--cream);background:rgba(246,241,231,.06);box-shadow:8px 8px 0 var(--yellow)}
  .rr-fig-dark figcaption{border-top-color:var(--cream);color:var(--cream);opacity:.86}
  /* Letterbox band: the photo works as a horizontal rule that happens to be a photograph. */
  .rr-fig-band img{aspect-ratio:1320/430;object-position:center 58%}

  /* ============ THE TOOL ============ */
  /* The ink field is treated as graph paper rather than a slab of black: the working
     (cream sheet) and the answer (yellow stamp) are laid on top of it, not built from it. */
  .rr-tool{padding:84px 0 96px;background-color:var(--ink);color:var(--cream);
    background-image:
      repeating-linear-gradient(0deg,rgba(246,241,231,.05) 0 1px,transparent 1px 68px),
      repeating-linear-gradient(90deg,rgba(246,241,231,.05) 0 1px,transparent 1px 68px);
    background-position:0 0}
  .rr-tool .rr-h2{color:var(--cream)}
  .rr-tool .rr-sh-sub{opacity:.85}
  .tool-fig{margin:0 0 34px}
  .calc{margin:0}

  /* The asymmetry block: the single most useful honest thing on the page.
     Two solid grounds, because they are two different deals and should not look alike. */
  .asym{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 0 34px}
  .asym-card{border:2.5px solid var(--ink);padding:20px 22px;box-shadow:8px 8px 0 rgba(11,15,26,.55)}
  .asym-card.is-rent{background:var(--c3-deliver);color:var(--cream);border-color:var(--cream)}
  .asym-card.is-buy{background:var(--yellow);color:var(--ink)}
  .asym-card .m{display:block;opacity:.85;margin-bottom:9px;font-weight:700}
  .asym-card h3{font-family:var(--narrow);font-weight:700;font-size:20px;text-transform:uppercase;line-height:1.14;margin:0 0 9px}
  .asym-card p{margin:0;font-size:14.5px;line-height:1.58}
  .asym-card.is-rent p{opacity:.95}

  /* The working sheet. Inputs come off the ink and onto cream so the form reads as paper. */
  .calc-sheet{background:var(--cream);color:var(--ink);border:2.5px solid var(--ink);border-top:10px solid var(--ink);box-shadow:14px 14px 0 var(--yellow);padding:30px 32px 32px}
  .calc-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px 24px;margin:26px 0 0;align-items:start}
  .calc-field{display:flex;flex-direction:column;gap:7px}
  .calc-field label{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;line-height:1.5;font-weight:700}
