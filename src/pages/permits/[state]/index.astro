---
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { permitStates, PERMIT_DISCLAIMER, MUNICIPAL_CARVE_OUT, type PermitState } from '../../../data/permitCounties';

// One index per state that has at least one county record, derived from the same module the county
// pages come from. A state with no counties cannot get an empty index, because the grouping is
// built from the counties themselves.
export function getStaticPaths() {
  return permitStates.map((entry) => ({
    params: { state: entry.stateSlug },
    props: { entry },
  }));
}

interface Props { entry: PermitState }
const { entry } = Astro.props;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Permits', path: '/permits/' },
  { name: entry.state },
];

// No date props, for the reason spelled out in the county template: dateModified comes from the
// committed route lastmod table, this module has no commit yet, and silence is the honest answer.
// The noun in the title is read off the data rather than assumed. Virginia's seven Hampton Roads
// entries are INDEPENDENT CITIES that sit in no county, so a title reading "by County in Virginia"
// over a list of seven cities is wrong on its face. entry.jurisdictionNoun is City there and County
// everywhere else. See PermitState in src/data/permitCounties.ts.
const title = `Shipping Container Permits by ${entry.jurisdictionNoun} in ${entry.state} | Steel Box Direct`;
const description = `The county and city offices to ask about a shipping container in ${entry.state}, with a link to each. Requirements vary by jurisdiction and intended use, and confirming them is the buyer's responsibility.`;
---

<BaseLayout
  pageType="guide"
  title={title}
  description={description}
  breadcrumbs={crumbs}
  schema={{
    kind: 'collection',
    title: `Shipping Container Permits by ${entry.jurisdictionNoun} in ${entry.state}`,
    items: entry.counties.map((county) => ({
      name: county.headingPlace,
      url: `https://steelboxdirect.com${county.path}`,
    })),
    faqs: [],
  }}
>
  <section class="state-hero" style="background: var(--c5-permits); color: var(--ink);">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="sh state_eyebrow" style="border-color: var(--ink);">
        <span class="idx">§ 05</span>
        <span class="nm">{entry.state}</span>
        <span class="tg">{entry.counties.length} jurisdictions listed</span>
      </div>
      <h1 class="state_headline">Who to ask about a container in <em>{entry.state}.</em></h1>
      <div class="state-disclaimer">
        <p class="m state_disclaimer_label">Read this first</p>
        <p class="state_disclaimer_body">{PERMIT_DISCLAIMER.lede}</p>
      </div>
    </div>
  </section>

  <section class="state-list">
    <div class="wrap">
      <h2>Jurisdictions we list in {entry.state}</h2>
      <p class="state_list_intro">
        These are the offices we already name on our {entry.state} delivery pages, one page each, with
        the questions to put to them. The list follows where we deliver rather than every jurisdiction
        in the state, so one missing here is one we have not researched yet. Each page is a starting
        point. {MUNICIPAL_CARVE_OUT}
      </p>
      <ul class="county-grid">
        {entry.counties.map((county) => (
          <li class="county-tile">
            <a href={county.path}>
              <span class="county_tile_name">{county.name}</span>
              <span class="county_tile_office">{county.offices[0]?.name}</span>
              <span class="county_tile_go">Who decides &amp; what to ask</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="state-next">
    <div class="wrap">
      <p class="state-next-label">Where to go next</p>
      <div class="state-next-links">
        <a href="/permits/">Permits and zoning: the general guide</a>
        <a href="/locations/">Every city we deliver to</a>
        <a href="/delivery/">How delivery works</a>
        <a href="/quote/">Get a quote</a>
      </div>
    </div>
  </section>

  <style>
    .state-hero { padding: 64px 0 56px; border-bottom: 2.5px solid var(--ink); }
    .sh { display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: center; padding: 18px 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); margin-bottom: 40px; }
    .sh .idx { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: .08em; text-transform: uppercase; }
    .sh .nm { font-family: var(--narrow); font-weight: 700; font-size: 22px; text-transform: uppercase; letter-spacing: -.01em; }
    .sh .tg { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: .08em; text-transform: uppercase; opacity: .55; text-align: right; }

    .state_headline { font-family: var(--narrow); font-weight: 700; font-size: clamp(34px, 6.4vw, 66px); line-height: .95; letter-spacing: -.02em; text-transform: uppercase; margin: 0; max-width: 900px; }
    .state_headline em { font-style: italic; font-weight: 700; }

    .state-disclaimer { margin: 36px 0 0; max-width: 760px; background: var(--ink); color: var(--cream); border: 2.5px solid var(--ink); padding: 24px 28px; box-shadow: 8px 8px 0 rgba(11,15,26,.25); }
    .state_disclaimer_label { color: var(--yellow); margin: 0 0 10px; }
    .state_disclaimer_body { font-size: 16px; line-height: 1.6; margin: 0; }

    .state-list { padding: 72px 0; background: var(--cream); }
    .state-list h2 { font-family: var(--narrow); font-weight: 700; font-size: clamp(28px, 4vw, 40px); text-transform: uppercase; letter-spacing: -.01em; line-height: 1; margin: 0 0 20px; }
    .state_list_intro { font-size: 17px; line-height: 1.6; max-width: 760px; margin: 0 0 36px; }

    .county-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .county-tile a { display: grid; gap: 10px; height: 100%; background: white; border: 2.5px solid var(--ink); padding: 22px; box-shadow: 6px 6px 0 var(--ink); text-decoration: none; color: var(--ink); transition: transform .15s, box-shadow .15s; }
    .county-tile a:hover { transform: translate(-2px,-2px); box-shadow: 8px 8px 0 var(--c5-permits); }
    .county_tile_name { font-family: var(--narrow); font-weight: 700; font-size: 22px; text-transform: uppercase; line-height: 1.02; }
    .county_tile_office { font-size: 14px; line-height: 1.45; opacity: .8; }
    .county_tile_go { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--c5-permits); }

    .state-next { padding: 48px 0; background: var(--ink); border-top: 2px solid rgba(255,255,255,.08); }
    .state-next-label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--yellow); margin-bottom: 16px; }
    .state-next-links { display: flex; flex-wrap: wrap; gap: 20px; }
    .state-next-links a { font-family: var(--narrow); font-size: 17px; font-weight: 600; color: var(--cream); text-decoration: none; border-bottom: 2px solid rgba(255,255,255,.2); padding-bottom: 2px; }
    .state-next-links a:hover { color: var(--yellow); border-color: var(--yellow); }

    @media (max-width: 768px) {
      .sh { grid-template-columns: auto 1fr; row-gap: 6px; }
      .sh .tg { grid-column: 1 / -1; text-align: left; opacity: .5; }
      .state-hero { padding: 48px 0 40px; }
      .state-disclaimer { padding: 20px; }
    }
  </style>
</BaseLayout>
