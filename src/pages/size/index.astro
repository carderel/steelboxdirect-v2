---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { containerBySlug, CONTAINER_SLUGS, dimAxes, interiorFloorSqFt, formatSqFt } from '../../data/containers';
import { asOfLabel, nationalBasisScope } from '../../data/pricing';
import { pctCheaperPerCuFt } from '../../data/sizeComparison';

// Every figure on this page is read from src/data/containers.ts or computed from the price feed.
// The size cards once said "Floor Space ~160 / ~320 sq ft", which is the OUTSIDE footprint; the
// floor inside is interior length x width. The sidebar once carried two statistics with no source
// anywhere ("73%", "1 in 3") and a typed per-cubic-foot percentage that the feed had left behind.
const interiorText = (slug: string) => {
  const a = dimAxes(containerBySlug(slug).specs.internalDims);
  return `${a.L} \u00D7 ${a.W} \u00D7 ${a.H}`;
};
const floorText = (slug: string) => `~${formatSqFt(interiorFloorSqFt(containerBySlug(slug)))} sq ft`;
const sizes = {
  s20:   { interior: interiorText(CONTAINER_SLUGS['20ft']),   floor: floorText(CONTAINER_SLUGS['20ft']) },
  s40:   { interior: interiorText(CONTAINER_SLUGS['40ft']),   floor: floorText(CONTAINER_SLUGS['40ft']) },
  s40hc: { interior: interiorText(CONTAINER_SLUGS['40ftHC']), floor: floorText(CONTAINER_SLUGS['40ftHC']) },
};
// /size/ is a size page, so a price-derived figure may render here under the pricing policy in
// CLAUDE.md: computed from pricing.ts, with the as-of date and the average-price disclaimer beside it.
// Gated on the direction actually holding, so a feed that inverted it would drop the line.
const cuFtSaving = pctCheaperPerCuFt('40ftStandard', '20ftCargo');
---

<BaseLayout
  title="What Size Shipping Container Do You Need?"
  description="Find the right container size for your needs. Compare 20ft, 40ft, and 40ft high cube containers with dimensions, use cases, and our interactive calculator."
  pageType="guide"
  guideTopic="size"
  floatingSidebar={false}
  datePublished="2026-05-19"
  dateModified="2026-08-25"
  schema={{ kind: 'guide', topic: 'size', title: 'What Size Shipping Container Do You Need?', specs: [], faqs: [] }}
>
  <div class="guide-header guide_header">
    <div class="wrap">
      <div class="sh guide_eyebrow">
        <span class="idx">§ 01</span>
        <span class="nm">Decision: Size</span>
        <span class="tg">ISO 668 Standards</span>
      </div>
      <h1 class="big guide_headline">Right Size =<br><em>Perfect Fit.</em></h1>
      <p class="guide-lede guide_lede">
        Size is the first decision: get it wrong and your equipment won't fit or you'll pay for space you don't need.
        A 20-foot container fits one tractor. A 40-foot holds farm equipment, workshop tools, or business inventory.
      </p>
    </div>
  </div>

  <section class="guide-content guide_content">
    <div class="wrap">
      <div class="row guide_main_row">
        <div class="main-col guide_main_col">
          <h2>The Three Standard Sizes</h2>
          <p>Shipping containers were built for international cargo, so dimensions are standardized worldwide. A "20-foot container" is the same size whether it comes from our yard or anywhere else.</p>
          <p>Shopping for a small shipping container? The 20ft is the smallest container we sell. Smaller ISO sizes like the 10ft exist, and our <a href="/container-reference/#dimensions">Container Reference</a> lists their dimensions for reference only; we do not stock them.</p>

          <div class="size-card guide_comparison_item" style="border-left-color: var(--c1-size);">
            <h3>20-Foot Container</h3>
            <div class="specs guide_callout_specs">
              <div class="spec-bit guide_callout_value"><span class="lbl">Interior</span><span class="val">{sizes.s20.interior}</span></div>
              <div class="spec-bit guide_callout_value"><span class="lbl">Floor Space</span><span class="val">{sizes.s20.floor}</span></div>
            </div>
            <p><strong>Perfect for:</strong> One tractor + attachment storage, horse trailers, or a small workshop.</p>
            <div class="tag-row guide_comparison_item_tag"><span class="m">→ Tom · 40-ft primary</span></div>
          </div>

          <div class="size-card guide_comparison_item" style="border-left-color: var(--c3-deliver);">
            <h3>40-Foot Container</h3>
            <div class="specs guide_callout_specs">
              <div class="spec-bit guide_callout_value"><span class="lbl">Interior</span><span class="val">{sizes.s40.interior}</span></div>
              <div class="spec-bit guide_callout_value"><span class="lbl">Floor Space</span><span class="val">{sizes.s40.floor}</span></div>
            </div>
            <p><strong>Perfect for:</strong> Complete farm equipment lineup, multiple vehicles, or business inventory.</p>
          </div>

          <div class="size-card guide_comparison_item" style="border-left-color: var(--c5-permits);">
            <h3>40-Foot High Cube</h3>
            <div class="specs guide_callout_specs">
              <div class="spec-bit guide_callout_value"><span class="lbl">Interior</span><span class="val">{sizes.s40hc.interior}</span></div>
              <div class="spec-bit guide_callout_value"><span class="lbl">Floor Space</span><span class="val">{sizes.s40hc.floor}</span></div>
            </div>
            <p><strong>The extra 12" height:</strong> Fits tall equipment like combines or stacked inventory.</p>
          </div>

          <p class="ref-crosslink">
            For exact interior/exterior figures on every ISO size, see the
            <a href="/container-reference/#dimensions">Container Reference</a> or
            <a href="/blog/shipping-container-dimensions-size-chart/">the full container size chart</a>.
            Torn between the two lengths? Read <a href="/blog/20ft-vs-40ft-shipping-container/">20ft vs 40ft: the full trade-off</a>.
          </p>
        </div>

        <aside class="sidebar-col guide_sidebar_col">
          {cuFtSaving > 0 && (
            <div class="authority-card guide_callout">
              <div class="m guide_callout_label">Price per Cubic Foot</div>
              <ul>
                <li><strong>40-ft</strong> costs about {cuFtSaving}% less per cubic foot than two 20-ft units, at our average starting prices.</li>
              </ul>
              <p class="price-basis">Averages across our {nationalBasisScope}, as of {asOfLabel}. These are average starting prices, not quotes; yours may be more or less.</p>
            </div>
          )}

          <div class="cta-card guide_cta">
            <h4 class="guide_cta_headline">Still unsure?</h4>
            <p>Use our interactive tool to get a recommendation.</p>
            <a href="/size/calculator/" class="btn guide_cta_btn">Open Calculator <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <style>
    .guide-header {
      background: var(--yellow);
      padding: 64px 0 56px;
      border-bottom: 2.5px solid var(--ink);
    }
    .guide-lede {
      font-size: 22px;
      line-height: 1.45;
      margin: 40px 0 0;
      max-width: 720px;
      font-weight: 500;
    }

    .guide-content {
      padding: 72px 0;
      background: var(--cream);
    }

    .row {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 80px;
      align-items: start;
    }

    .size-card {
      background: white;
      border: 2px solid var(--ink);
      border-left: 8px solid var(--ink);
      padding: 32px;
      margin-top: 40px;
      box-shadow: 8px 8px 0 var(--ink);
    }
    .size-card h3 {
      font-family: var(--narrow);
      font-weight: 700;
      font-size: 28px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .specs {
      display: flex;
      gap: 32px;
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(11,15,26,.1);
    }
    .spec-bit .lbl {
      display: block;
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
      opacity: .5;
    }
    .spec-bit .val {
      font-family: var(--narrow);
      font-weight: 700;
      font-size: 20px;
    }

    .authority-card {
      background: var(--ink);
      color: var(--cream);
      padding: 32px;
      border: 2px solid var(--ink);
    }
    .authority-card .m { color: var(--yellow); margin-bottom: 16px; }
    .authority-card ul { list-style: none; padding: 0; margin: 0; }
    .authority-card li { margin-bottom: 16px; font-size: 15px; line-height: 1.45; border-bottom: 1px solid rgba(246,241,231,.1); padding-bottom: 16px; }
    .authority-card li:last-child { border: none; }
    .authority-card .price-basis { font-family: var(--mono); font-size: 11px; line-height: 1.5; letter-spacing: .03em; opacity: .7; margin: 0; }

    .cta-card {
      margin-top: 40px;
      background: white;
      border: 2px solid var(--ink);
      padding: 32px;
      box-shadow: 8px 8px 0 var(--c5-permits);
    }
    .cta-card h4 { font-family: var(--narrow); font-size: 24px; text-transform: uppercase; margin-bottom: 8px; }
    .cta-card p { font-size: 15px; margin-bottom: 20px; }

    .ref-crosslink { margin: 24px 0; font-size: 15px; }
    .ref-crosslink a { border-bottom: 2px solid var(--yellow-d); font-weight: 600; }

    @media (max-width: 960px) {
      .row { grid-template-columns: 1fr; gap: 48px; }
      .guide-header { padding: 48px 0; }
      .big { font-size: clamp(48px, 10vw, 80px); }
    }
    .guide-next { padding: 48px 0; background: var(--ink); border-top: 2px solid rgba(255,255,255,.08); }
    .guide-next-label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--yellow); margin-bottom: 16px; }
    .guide-next-links { display: flex; flex-wrap: wrap; gap: 20px; }
    .guide-next-links a { font-family: var(--narrow); font-size: 17px; font-weight: 600; color: var(--cream); text-decoration: none; border-bottom: 2px solid rgba(255,255,255,.2); padding-bottom: 2px; }
    .guide-next-links a:hover { color: var(--yellow); border-color: var(--yellow); }
  </style>

  <section class="guide-next">
    <div class="wrap">
      <p class="guide-next-label">Continue researching</p>
      <div class="guide-next-links">
        <a href="/delivery/">How is it delivered?</a>
        <a href="/condition/">New vs. used condition grades</a>
        <a href="/cost/">What does a container cost?</a>
        <a href="/shipping-containers-for-sale/">Browse container specs</a>
      </div>
    </div>
  </section>

  <section class="guide-product-cta" style="padding: 64px 0; background: var(--ink); color: var(--cream);">
    <div class="wrap" style="display: flex; flex-direction: column; align-items: flex-start; gap: 24px; max-width: 680px;">
      <p class="m" style="color: var(--yellow); margin: 0;">Ready to buy?</p>
      <h2 style="font-family: var(--narrow); font-size: clamp(28px, 4vw, 44px); font-weight: 700; text-transform: uppercase; margin: 0; line-height: 1.05;">Browse containers by size</h2>
      <p style="font-size: 17px; opacity: .75; margin: 0; line-height: 1.5;">See specs, dimensions, and availability for 20ft, 40ft, and 40ft High Cube containers.</p>
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="/shipping-containers-for-sale/" class="btn" style="background: var(--yellow); color: var(--ink); border-color: var(--yellow);">View All Containers →</a>
        <a href="/shipping-containers-for-sale/20-foot-shipping-container/" class="btn-ghost" style="color: var(--cream);">20ft details</a>
        <a href="/shipping-containers-for-sale/40-foot-shipping-container/" class="btn-ghost" style="color: var(--cream);">40ft details</a>
      </div>
    </div>
  </section>
</BaseLayout>
