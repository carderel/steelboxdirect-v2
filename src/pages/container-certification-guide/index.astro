  .cg-sub-hd p{font-size:15.5px;line-height:1.6;opacity:.75;margin:10px 0 0;max-width:760px}

  /* ---- 1. HERO ---- */
  .cg-hero{background:var(--ink);color:var(--cream);padding:44px 0 56px;border-bottom:2.5px solid var(--ink)}
  .cg-eyebrow{display:inline-flex;align-items:center;gap:14px;flex-wrap:wrap;border:2px solid var(--cream);padding:8px 14px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .cg-eyebrow .idx{font-weight:700}
  .cg-eyebrow .tg{opacity:.7}
