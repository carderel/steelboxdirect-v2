---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Container Buying Guide' },
];

interface ChecklistItem { n: string; title: string; body: string; link?: { href: string; label: string } }

const checklist: ChecklistItem[] = [
  {
    n: '01',
    title: 'Verify a real, accountable business behind the sale',
    body: `Before you send a deposit, find out who you're actually buying from. A legitimate dealer is a traceable business — a registered company, a real address, and a track record — not just a phone number and a stock photo of a container yard. Steel Box Direct is the authorized independent agent of Freedom Conex LLC, an operating company that's sold containers since 2009.`,
  },
  {
    n: '02',
    title: 'Get the warranty in writing',
    body: `Any seller can say a container is "leak-free." A legitimate one puts it in writing, with terms you can read before you pay — what's covered, for how long, and how a claim gets resolved. Steel Box Direct backs every unit with a written Lifetime Leak Warranty, spelled out in our terms, not a verbal promise made over the phone.`,
  },
  {
    n: '03',
    title: 'Verify the actual unit, not stock photos',
    body: `Scam listings often reuse photos scraped from real container yards to sell units that don't exist. Ask for photos of the specific container you're buying, including its CSC Safety Approval Plate — the stamped ID that proves the unit is real and traceable. Here's `,
    link: { href: '/container-reference/#markings', label: 'how to read a container\'s markings & CSC plate' },
  },
  {
    n: '04',
    title: 'Know exactly what grade you\'re buying',
    body: `Bait-and-switch grading is one of the most common tactics in this market — a seller quotes a nicer grade, then delivers something worse. Get the exact condition grade in writing before you commit. Steel Box Direct sells one honest grade — Wind & Water Tight (used) — no upsell games, no surprise downgrade at delivery. See `,
    link: { href: '/condition/', label: 'our condition guide' },
  },
  {
    n: '05',
    title: 'Confirm real, local delivery',
    body: `An anonymous reseller model can leave you with no real delivery operation — and no accountability if something goes wrong on drop-off day. Ask exactly where the truck comes from and how far the seller actually delivers. Steel Box Direct delivers within roughly 250 miles of Cincinnati, across Ohio, Indiana, Kentucky, and western West Virginia, from real regional depots. See `,
    link: { href: '/locations/', label: 'where we deliver' },
  },
  {
    n: '06',
    title: 'Use a payment method with buyer protection',
    body: `This one applies to any seller, anywhere: be cautious if you're pressured to wire money, send Zelle, or pay in cryptocurrency up front, especially before you've verified who you're dealing with. Favor payment methods that carry some form of buyer protection or a paper trail, and treat manufactured urgency — "today only," "another buyer is waiting" — as a reason to slow down, not skip your other checks.`,
  },
  {
    n: '07',
    title: 'Ask whether the price includes delivery',
    body: `A cheap container price often leaves out freight — and shipping a steel box isn't cheap, so a low headline number can hide hundreds of dollars in delivery cost. Always ask for the all-in delivered total, and compare that number across sellers instead of the sticker price. Steel Box Direct quotes all-in from the start: the container, delivery to your ZIP, and placement on flat ground. See `,
    link: { href: '/cost/', label: 'what really drives container cost' },
  },
];

interface RecapRow { check: string; sbd: string }
const recap: RecapRow[] = [
  { check: 'Real, accountable business', sbd: 'Authorized independent agent of Freedom Conex LLC, operating since 2009' },
  { check: 'Warranty in writing', sbd: 'Lifetime Leak Warranty, spelled out in our terms' },
  { check: 'One honest condition grade', sbd: 'Wind & Water Tight (used) — the only grade we sell' },
  { check: 'Real, local delivery', sbd: '~250 miles of Cincinnati, across Ohio, Indiana, Kentucky & western WV' },
  { check: 'Verifiable unit identity', sbd: 'CSC plate & markings you can check yourself — see our reference guide' },
  { check: 'Delivery included in the price', sbd: 'All-in quotes — container, delivery to your ZIP & flat-ground placement, no surprise freight' },
];

interface Faq { q: string; a: string }
const faqs: Faq[] = [
  {
    q: 'How do I avoid shipping container scams?',
    a: `Verify the business behind the sale, get the warranty in writing, ask for photos of the actual unit and its CSC plate, confirm the exact condition grade before you pay, confirm the seller genuinely delivers to your area, and be cautious of any payment request that offers no buyer protection or leaves no paper trail.`,
  },
  {
    q: 'How can I tell if a container seller is legitimate?',
    a: `A legitimate seller is a traceable business, not just a phone number — they can point to a registered company, a track record, and a location they actually operate from. They put warranty terms in writing, will verify the specific unit you're buying rather than lean on generic yard photos, and are upfront about exactly what condition grade you're paying for.`,
  },
  {
    q: 'What is a CSC plate and why does it matter?',
    a: `The CSC Safety Approval Plate, required under the IMO International Convention for Safe Containers, is a container's structural passport — it records approval and inspection history and stays with the unit for its working life. Asking to see a specific container's CSC plate is one of the simplest ways to confirm you're buying a real, identifiable unit and not a photo pulled from someone else's yard.`,
  },
  {
    q: 'Is Steel Box Direct a broker or a real dealer?',
    a: `Steel Box Direct is not an anonymous broker. We're the authorized independent agent of Freedom Conex LLC, an operating company that's sold containers since 2009 — an accountable business you can verify, not a middleman reselling someone else's inventory under a different name each time.`,
  },
  {
    q: 'What condition are the containers?',
    a: `Every container Steel Box Direct sells is Wind & Water Tight (used) — one honest grade, sealed against rain, wind, snow, and pests, and structurally sound for storage and on-site use. We don't sell multiple grades with upsell pressure; what you're quoted is what gets delivered.`,
  },
  {
    q: 'Does the container price include delivery?',
    a: `Always ask, because often it doesn't. A cheap container price frequently excludes freight, and shipping a steel box can add hundreds of dollars — so the lowest sticker price isn't always the lowest delivered cost. Compare the all-in delivered total across sellers, not the container price alone. Steel Box Direct quotes all-in: the number we give you covers the container, delivery to your ZIP, and placement on flat ground.`,
  },
];

---

<BaseLayout
  pageType="guide"
  title="How to Buy a Shipping Container Safely (Buyer's Guide) | Steel Box Direct"
  description="Real scams exist in the used-container market — ghost sellers, bait-and-switch grading, and stolen photos. This buyer's guide shows how to vet a seller, and how a legitimate dealer should measure up."
  datePublished="2026-07-04"
  dateModified="2026-07-04"
  breadcrumbs={breadcrumbs}
  schema={{ kind: 'guide', title: 'How to Buy a Shipping Container Safely', specs: [], faqs: faqs.map((f) => ({ q: f.q, a: f.a })) }}
>
  <!-- HERO -->
  <section class="bg-hero">
    <div class="wrap">
      <div class="sh">
        <span class="idx">§ Buyer's Guide</span>
        <span class="nm">Steel Box Direct</span>
        <span class="tg">Vetting Checklist</span>
      </div>
      <h1 class="big">How to Buy a Container<br><em>Without Getting Scammed.</em></h1>
      <p class="lede">The used shipping container market has real scams: ghost sellers who take a deposit and vanish, bait-and-switch grading, photos scraped from a real yard to sell a unit that doesn't exist, and pressure to pay by an untraceable method. This guide shows how to protect yourself — and exactly how a legitimate seller should measure up.</p>
      <nav class="bg-jump">
        <a href="#checklist">The vetting checklist</a>
        <a href="#recap">How SBD measures up</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </section>

  <!-- CHECKLIST -->
  <section id="checklist" class="bg-section bg-checklist">
    <div class="wrap">
      <h2 class="section-title">The Vetting Checklist</h2>
      <p class="section-intro">Seven things to check before you send anyone a deposit on a shipping container. Each one is a real scam vector — and a real question you can ask.</p>
      <div class="check-list">
        {checklist.map((c) => (
          <div class="check-item">
            <span class="check-n">{c.n}</span>
            <div class="check-body">
              <h3>{c.title}</h3>
              <p>{c.body}{c.link && <a href={c.link.href}>{c.link.label}</a>}{c.link ? '.' : ''}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECAP -->
  <section id="recap" class="bg-section bg-recap">
    <div class="wrap">
      <h2 class="section-title">How Steel Box Direct Measures Up</h2>
      <p class="section-intro">We're not asking you to take our word for it — every claim below is something you can verify. Here's how we stack up against the checklist above.</p>
      <div class="table-wrap">
        <table class="bg-table">
          <thead><tr><th>Check</th><th>Steel Box Direct</th></tr></thead>
          <tbody>
            {recap.map((r) => (
              <tr><th scope="row">{r.check}</th><td>{r.sbd}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="bg-callout">
        <h4>What we won't claim</h4>
        <p>We sell one condition grade (Wind &amp; Water Tight, used) — never presented as new or a higher grade. Permit and zoning requirements are always the buyer's responsibility to confirm locally. And we won't tell you what specific payment method to use here; that's between you and whichever seller you choose to work with — just apply the buyer-protection check above to anyone you're buying from.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-section bg-faq">
    <div class="wrap">
      <h2 class="section-title">Buyer's Guide FAQ</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-section bg-cta-wrap">
    <div class="wrap">
      <div class="spoke-row">
        <a href="/container-reference/">Container Reference →</a>
        <a href="/condition/">Condition Guide →</a>
        <a href="/locations/">Delivery Areas →</a>
        <a href="/blog/wind-and-water-tight-explained/">Wind &amp; Water Tight explained →</a>
        <a href="/blog/how-to-read-container-id-number-iso-6346/">Read the container markings yourself →</a>
      </div>
      <div class="cta-box">
        <h2>Bought your due diligence. Now get a real quote.</h2>
        <p>Tell us your size, zip code, and intended use — we'll get back to you within 4 business hours.</p>
        <a href="/quote/" class="btn">Get My Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bg-hero { padding: 120px 0 72px; background: var(--yellow); border-bottom: 2.5px solid var(--ink); }
  .sh { display: flex; gap: 16px; flex-wrap: wrap; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .7; margin-bottom: 20px; }
  .bg-hero .big { font-family: var(--narrow); font-size: var(--t-big); text-transform: uppercase; line-height: .95; font-weight: 800; }
  .bg-hero .lede { font-size: 20px; line-height: 1.45; max-width: 740px; font-weight: 500; margin-top: 24px; }
  .bg-jump { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .bg-jump a { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; background: var(--ink); color: var(--yellow); padding: 8px 14px; }
  .bg-jump a:hover { background: var(--cream); color: var(--ink); }

  .bg-section { padding: 80px 0; border-bottom: 1.5px solid rgba(11,15,26,.1); scroll-margin-top: 120px; }
  .bg-checklist { background: var(--cream); }
  .bg-recap { background: white; }
  .bg-faq { background: var(--cream); }
  .bg-cta-wrap { background: white; }
  .section-title { font-family: var(--narrow); font-size: 36px; text-transform: uppercase; margin-bottom: 12px; }
  .section-intro { font-size: 17px; line-height: 1.6; max-width: 760px; opacity: .8; margin-bottom: 32px; }

  .check-list { border: 2.5px solid var(--ink); background: white; }
  .check-item { display: flex; gap: 24px; padding: 28px 32px; border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .check-item:last-child { border-bottom: none; }
  .check-n { font-family: var(--narrow); font-size: 32px; font-weight: 800; color: var(--yellow-d); flex-shrink: 0; width: 48px; -webkit-text-stroke: 1.5px var(--ink); }
  .check-body h3 { font-family: var(--narrow); font-size: 20px; text-transform: uppercase; margin-bottom: 10px; }
  .check-body p { line-height: 1.65; opacity: .85; max-width: 780px; }
  .check-body p a { border-bottom: 2px solid var(--yellow-d); font-weight: 600; opacity: 1; }

  .table-wrap { overflow-x: auto; border: 2.5px solid var(--ink); background: white; }
  .bg-table { width: 100%; border-collapse: collapse; min-width: 620px; }
  .bg-table th, .bg-table td { padding: 14px 18px; text-align: left; border-bottom: 1.5px solid rgba(11,15,26,.1); font-size: 14px; }
  .bg-table thead th { font-family: var(--narrow); font-size: 14px; font-weight: 700; text-transform: uppercase; background: var(--ink); color: var(--yellow); }
  .bg-table tbody th { font-family: var(--narrow); font-weight: 700; font-size: 15px; }
  .bg-table tr:last-child td, .bg-table tr:last-child th { border-bottom: none; }

  .bg-callout { margin-top: 32px; background: var(--ink); color: var(--cream); padding: 32px; border: 2.5px solid var(--ink); }
  .bg-callout h4 { font-family: var(--narrow); font-size: 22px; text-transform: uppercase; margin-bottom: 10px; color: var(--yellow); }
  .bg-callout p { line-height: 1.6; opacity: .85; max-width: 780px; }

  .faq-list { border: 2.5px solid var(--ink); }
  .faq-item { padding: 28px 32px; border-bottom: 1.5px solid rgba(11,15,26,.1); background: white; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item h3 { font-family: var(--narrow); font-size: 20px; text-transform: uppercase; margin-bottom: 10px; }
  .faq-item p { opacity: .8; line-height: 1.6; max-width: 780px; }

  .spoke-row { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 48px; }
  .spoke-row a { font-family: var(--narrow); font-weight: 700; font-size: 16px; text-transform: uppercase; border: 2.5px solid var(--ink); padding: 12px 18px; background: white; }
  .spoke-row a:hover { background: var(--ink); color: var(--yellow); }
  .cta-box { background: var(--ink); color: var(--cream); padding: 56px; text-align: center; box-shadow: 12px 12px 0 var(--yellow); }
  .cta-box h2 { font-family: var(--narrow); font-size: 40px; text-transform: uppercase; margin-bottom: 14px; }
  .cta-box p { font-size: 17px; opacity: .8; margin-bottom: 32px; }

  @media (max-width: 960px) {
    .bg-section { scroll-margin-top: 240px; }
  }
  @media (max-width: 768px) {
    .bg-section { padding: 56px 0; }
    .check-item { flex-direction: column; gap: 12px; padding: 24px 20px; }
    .check-n { width: auto; font-size: 24px; }
    .cta-box { padding: 36px 22px; }
    .cta-box h2 { font-size: 28px; }
  }
</style>
