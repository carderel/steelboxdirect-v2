---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { containers, type Container } from '../../data/containers';
import { CONDITION } from '../../data/condition';
import { DELIVERY_ACCESS } from '../../data/permitCounties';

/**
 * THE FOUR DECISIONS SECTION, and why not one figure in it is typed on this page.
 *
 * WHY THE SECTION EXISTS. This page was a seller-vetting checklist and nothing else. A reader who
 * searches for a container buying guide is one stage EARLIER than vetting: they do not yet know
 * what they are buying, so a checklist of questions to ask a seller answers a question they have
 * not reached. The four decisions (size, condition, delivery, cost) are that earlier stage, they
 * each already have a full guide on this site, and this page linked to those guides without ever
 * saying what was in them. Four short summaries fix that and nothing more; each one is capped at a
 * handful of sentences on purpose, because the deeper page is the destination and a summary that
 * tries to replace it just splits the topic across two URLs.
 *
 * WHERE EVERY FIGURE COMES FROM, in order of appearance:
 *   - Size: src/data/containers.ts, read through containerBySlug below. The dimension strings are
 *     rendered whole rather than rekeyed, and the two figures that are NOT carried as their own
 *     field (interior headroom, door width) are sliced off the spec strings by firstFigure and
 *     lastFigure rather than typed. So a spec correction upstream rewrites this section, and a
 *     spec that disagrees with the product page is impossible rather than merely unlikely.
 *   - Condition: CONDITION.blurb from src/data/condition.ts, the single source of truth for grade
 *     messaging, interpolated verbatim. The one-trip contrast restates what /condition/ already
 *     publishes: we do not sell one-trip today, and this page must not imply otherwise.
 *   - Delivery: DELIVERY_ACCESS from src/data/permitCounties.ts, both strings verbatim. That
 *     module's own header calls this locked copy and forbids paraphrasing it per page, and
 *     src/lib/compliance/permit-county-guard.test.ts holds the delivery page to the same strings.
 *     Writing a shorter version here would have been a second, drifting statement of the same
 *     promise, which is the exact failure the lock exists to prevent.
 *   - Cost: NO FIGURE, and that is a decision rather than an omission. This summary states the
 *     mechanism (size and distance) and sends the reader to /cost/, which publishes a delivered
 *     total per metro with the ZIP it was priced from and the date it last changed. A national
 *     average could have been interpolated from src/data/pricing.ts here, correctly labelled and
 *     disclaimed, but CLAUDE.md enumerates the surfaces cleared to render an average (homepage,
 *     product and size pages, use case pages, city pages) and a guide page is not among them. A
 *     surface not on that list is an owner ruling, not a writer's call, so the figure is left to
 *     the page that already carries it with full provenance. If the owner scopes guide pages in,
 *     the block belongs right here, with nationalPriceLabel beside the figure and the average,
 *     not a quote, disclaimer under it, exactly as home/PriceSection.astro renders it.
 *
 * WHAT IS DELIBERATELY ABSENT. Permits. They are the fifth decision guide on this site and they do
 * not appear in this section, because a summary is an atomic surface with no room for the deferral
 * that a permit sentence requires, and a page that names a requirement outcome in a four sentence
 * block is one quote away from determining it for the reader. The recap callout below already
 * states the only thing this site says on the subject, which is that confirming it locally is the
 * buyer's responsibility.
 */

function containerBySlug(slug: string): Container {
  const found = containers.find((c) => c.slug === slug);
  if (!found) throw new Error(`container-buying-guide: no container with slug ${slug}`);
  return found;
}

const c20 = containerBySlug('20-foot-shipping-container');
const c40 = containerBySlug('40-foot-shipping-container');
const c40hc = containerBySlug('40-foot-high-cube-container');

/**
 * Spec strings run "length x width x height", so the height is the second to last token and the
 * length (or, for a door opening, the width) is the first. Sliced rather than retyped so the
 * numbers here cannot drift from the product pages that render the same strings whole.
 */
const lastFigure = (spec: string): string => {
  const parts = spec.trim().split(/\s+/);
  return parts[parts.length - 2] ?? '';
};
const firstFigure = (spec: string): string => spec.trim().split(/\s+/)[0] ?? '';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Container Buying Guide' },
];

interface ChecklistItem { n: string; title: string; body: string; link?: { href: string; label: string } }

const checklist: ChecklistItem[] = [
  {
    n: '01',
    title: 'Verify a real, accountable business behind the sale',
    body: `Before you send a deposit, find out who you're actually buying from. A legitimate dealer is a traceable business (a registered company, a real address, and a track record), not just a phone number and a stock photo of a container yard. Steel Box Direct is the authorized independent agent of Freedom Conex LLC, an operating company that sells containers.`,
  },
  {
    n: '02',
    title: 'Get the warranty in writing',
    body: `Any seller can say a container is "leak-free." A legitimate one puts it in writing, with terms you can read before you pay: what's covered, for how long, and how a claim gets resolved. Steel Box Direct backs every unit with a written Lifetime Leak Warranty, spelled out in our terms, not a verbal promise made over the phone. Read what the remedy actually is before you pay, on any seller's site including ours: on a leak claim we send an industry-approved fiberglass patch kit with instructions and you apply it to the container. Most sellers in this category leave that part for after the sale.`,
  },
  {
    n: '03',
    title: 'Verify the actual unit, not stock photos',
    body: `Scam listings often reuse photos scraped from real container yards to sell units that don't exist. Ask for photos of the specific container you're buying, including its CSC Safety Approval Plate, the stamped ID that proves the unit is real and traceable. Here's `,
    link: { href: '/container-reference/#markings', label: 'how to read a container\'s markings & CSC plate' },
  },
  {
    n: '04',
    title: 'Know exactly what grade you\'re buying',
    body: `Bait-and-switch grading is one of the most common tactics in this market: a seller quotes a nicer grade, then delivers something worse. Get the exact condition grade in writing before you commit. Steel Box Direct sells one honest grade, Wind & Water Tight (used): no upsell games, no surprise downgrade at delivery. See `,
    link: { href: '/condition/', label: 'our condition guide' },
  },
  {
    n: '05',
    title: 'Confirm real, local delivery',
    body: `An anonymous reseller model can leave you with no real delivery operation, and no accountability if something goes wrong on drop-off day. Ask exactly where the truck comes from and how far the seller actually delivers. Steel Box Direct delivers within roughly 250 miles of Cincinnati, across Ohio, Indiana, Kentucky, and western West Virginia, from real regional depots. See `,
    link: { href: '/locations/', label: 'where we deliver' },
  },
  {
    n: '06',
    title: 'Use a payment method with buyer protection',
    body: `This one applies to any seller, anywhere: be cautious if you're pressured to wire money, send Zelle, or pay in cryptocurrency up front, especially before you've verified who you're dealing with. Favor payment methods that carry some form of buyer protection or a paper trail, and treat manufactured urgency ("today only," "another buyer is waiting") as a reason to slow down, not skip your other checks.`,
  },
  {
    n: '07',
    title: 'Ask whether the price includes delivery',
    body: `A cheap container price often leaves out freight, and shipping a steel box isn't cheap, so a low headline number can hide hundreds of dollars in delivery cost. Always ask for the all-in delivered total, and compare that number across sellers instead of the sticker price. Steel Box Direct quotes all-in from the start: the container, delivery to your ZIP, and placement on flat ground. See `,
    link: { href: '/cost/', label: 'what really drives container cost' },
  },
];

interface RecapRow { check: string; sbd: string }
const recap: RecapRow[] = [
  { check: 'Real, accountable business', sbd: 'Authorized independent agent of Freedom Conex LLC, an operating company you can verify' },
  { check: 'Warranty in writing', sbd: 'Lifetime Leak Warranty, spelled out in our terms: on a leak claim we send a patch kit you apply yourself' },
  { check: 'One honest condition grade', sbd: 'Wind & Water Tight (used), the only grade we sell' },
  { check: 'Real, local delivery', sbd: '~250 miles of Cincinnati, across Ohio, Indiana, Kentucky & western WV' },
  { check: 'Verifiable unit identity', sbd: 'CSC plate & markings you can check yourself; see our reference guide' },
  { check: 'Delivery included in the price', sbd: 'All-in quotes: container, delivery to your ZIP & flat-ground placement, no surprise freight' },
];

interface Faq { q: string; a: string }
const faqs: Faq[] = [
  {
    q: 'How do I avoid shipping container scams?',
    a: `Verify the business behind the sale, get the warranty in writing, ask for photos of the actual unit and its CSC plate, confirm the exact condition grade before you pay, confirm the seller genuinely delivers to your area, and be cautious of any payment request that offers no buyer protection or leaves no paper trail.`,
  },
  {
    q: 'How can I tell if a container seller is legitimate?',
    a: `A legitimate seller is a traceable business, not just a phone number: they can point to a registered company, a track record, and a location they actually operate from. They put warranty terms in writing, will verify the specific unit you're buying rather than lean on generic yard photos, and are upfront about exactly what condition grade you're paying for.`,
  },
  {
    q: 'What is a CSC plate and why does it matter?',
    a: `The CSC Safety Approval Plate, required under the IMO International Convention for Safe Containers, is a container's structural passport: it records approval and inspection history and stays with the unit for its working life. Asking to see a specific container's CSC plate is one of the simplest ways to confirm you're buying a real, identifiable unit and not a photo pulled from someone else's yard.`,
  },
  {
    q: 'Is Steel Box Direct a broker or a real dealer?',
    a: `Steel Box Direct is not an anonymous broker. We're the authorized independent agent of Freedom Conex LLC, an operating container company: an accountable business you can verify, not a middleman reselling someone else's inventory under a different name each time.`,
  },
  {
    q: 'What condition are the containers?',
    a: `Every container Steel Box Direct sells is Wind & Water Tight (used): one honest grade, sealed against rain, wind, snow, and pests, and structurally sound for storage and on-site use. We don't sell multiple grades with upsell pressure; what you're quoted is what gets delivered.`,
  },
  {
    q: 'Does the container price include delivery?',
    a: `Always ask, because often it doesn't. A cheap container price frequently excludes freight, and shipping a steel box can add hundreds of dollars, so the lowest sticker price isn't always the lowest delivered cost. Compare the all-in delivered total across sellers, not the container price alone. Steel Box Direct quotes all-in: the number we give you covers the container, delivery to your ZIP, and placement on flat ground.`,
  },
];

---

<BaseLayout
  pageType="guide"
  title="Shipping Container Buying Guide: How Not to Get Scammed | Steel Box Direct"
  description="A shipping container buying guide: the four decisions (size, condition, delivery, cost) and the seven checks that tell a real dealer from a ghost seller."
  datePublished="2026-07-04"
  dateModified="2026-07-04"
  breadcrumbs={breadcrumbs}
  schema={{ kind: 'guide', title: 'Shipping Container Buying Guide: How Not to Get Scammed', specs: [], faqs: faqs.map((f) => ({ q: f.q, a: f.a })) }}
>
  <!-- HERO -->
  <section class="bg-hero">
    <div class="wrap">
      <div class="sh">
        <span class="idx">§ Buyer's Guide</span>
        <span class="nm">Steel Box Direct</span>
        <span class="tg">Decisions + Vetting</span>
      </div>
      <h1 class="big">The Shipping Container Buying Guide:<br><em>How Not to Get Scammed.</em></h1>
      <p class="lede">Buying a shipping container is four decisions (size, condition, delivery, and cost) plus one judgment call about who you buy it from. The used market has real scams: ghost sellers who take a deposit and vanish, bait-and-switch grading, photos scraped from a real yard to sell a unit that doesn't exist, and pressure to pay by an untraceable method. This guide covers the four decisions first, then how to protect yourself, and exactly how a legitimate seller should measure up.</p>
      <nav class="bg-jump">
        <a href="#decisions">The four decisions</a>
        <a href="#checklist">The vetting checklist</a>
        <a href="#recap">How SBD measures up</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </section>

  <!-- THE FOUR DECISIONS. Placed ahead of the checklist because it is the earlier stage of the
       same journey: you decide what you are buying, then you decide who to buy it from. Every
       figure below is interpolated; see the provenance note in the frontmatter. -->
  <section id="decisions" class="bg-section bg-decisions">
    <div class="wrap">
      <h2 class="section-title">The Four Decisions, Before You Vet Anyone</h2>
      <p class="section-intro">Every container purchase comes down to the same four questions, and they are worth settling before you start collecting quotes. Settle them and the numbers you gather all describe the same thing. Skip them and they do not.</p>
      <div class="dec-grid">

        <article class="dec-item">
          <span class="dec-n">Decision 01</span>
          <h3>Size</h3>
          <p class="dec-body">Three sizes cover nearly every job. A 20ft is {c20.specs.externalDims} and holds {c20.specs.cubicCap}, and it fits a standard driveway. A 40ft doubles the length for {c40.specs.cubicCap} at the same {lastFigure(c40.specs.externalDims)} exterior height. The 40ft High Cube keeps that footprint and adds a foot on top: {c40hc.specs.cubicCap}, with {lastFigure(c40hc.specs.internalDims)} of interior headroom instead of {lastFigure(c40.specs.internalDims)}, which is what matters if you plan to shelve it or finish the inside. Door width is {firstFigure(c20.specs.doorOpening)} on all three, so what you are really choosing between is length and headroom.</p>
          <a class="dec-more" href="/size/">Compare the three sizes</a>
        </article>

        <article class="dec-item">
          <span class="dec-n">Decision 02</span>
          <h3>Condition</h3>
          <p class="dec-body">This one is simpler here than at most sellers, because we sell a single grade. {CONDITION.blurb} What that buys you is the seal: rain, wind, snow, and pests stay out, and what you accept in exchange is the surface rust, scratches, and dents of a working life. The grade above it is one-trip, a container built overseas, loaded once for a single ocean crossing and sold on arrival at a premium, and we do not carry it today. Decide which of the two you need before you shop, because it is the one variable we do not price.</p>
          <a class="dec-more" href="/condition/">What Wind &amp; Water Tight means</a>
        </article>

        <article class="dec-item">
          <span class="dec-n">Decision 03</span>
          <h3>Delivery</h3>
          <p class="dec-body">Delivery is the constraint most buyers discover last, and it is a question about your site rather than about the container. {DELIVERY_ACCESS.clearance} {DELIVERY_ACCESS.timing}</p>
          <a class="dec-more" href="/delivery/">What delivery day looks like</a>
        </article>

        <article class="dec-item">
          <span class="dec-n">Decision 04</span>
          <h3>Cost</h3>
          <p class="dec-body">Two things move a delivered total more than anything else: the size you pick and how far the truck drives. Containers arrive by ship, so the further inland the drop, the more of the number is trucking rather than steel, and the same box at the same grade can differ by hundreds of dollars between two metros. Condition is the third lever everywhere else, and here it is fixed, because there is one grade. So the number to compare between sellers is the delivered total, container plus freight plus placement on flat ground, rather than the sticker, and that total is what our cost guide is built around.</p>
          <a class="dec-more" href="/cost/">Delivered totals, metro by metro</a>
        </article>

      </div>
    </div>
  </section>

  <!-- CHECKLIST -->
  <section id="checklist" class="bg-section bg-checklist">
    <div class="wrap">
      <h2 class="section-title">The Vetting Checklist</h2>
      <p class="section-intro">Seven things to check before you send anyone a deposit on a shipping container. Each one is a real scam vector, and a real question you can ask.</p>
      <div class="check-list">
        {checklist.map((c) => (
          <div class="check-item">
            <span class="check-n">{c.n}</span>
            <div class="check-body">
              <h3>{c.title}</h3>
              <p>{c.body}{c.link && <a href={c.link.href}>{c.link.label}</a>}{c.link ? '.' : ''}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECAP -->
  <section id="recap" class="bg-section bg-recap">
    <div class="wrap">
      <h2 class="section-title">How Steel Box Direct Measures Up</h2>
      <p class="section-intro">We're not asking you to take our word for it; every claim below is something you can verify. Here's how we stack up against the checklist above.</p>
      <div class="table-wrap">
        <table class="bg-table">
          <thead><tr><th>Check</th><th>Steel Box Direct</th></tr></thead>
          <tbody>
            {recap.map((r) => (
              <tr><th scope="row">{r.check}</th><td>{r.sbd}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="bg-callout">
        <h4>What we won't claim</h4>
        <p>We sell one condition grade (Wind &amp; Water Tight, used), never presented as new or a higher grade. Permit and zoning requirements are always the buyer's responsibility to confirm locally. And we won't tell you what specific payment method to use here; that's between you and whichever seller you choose to work with. Just apply the buyer-protection check above to anyone you're buying from.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-section bg-faq">
    <div class="wrap">
      <h2 class="section-title">Buyer's Guide FAQ</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-section bg-cta-wrap">
    <div class="wrap">
      <div class="spoke-row">
        <a href="/container-reference/">Container Reference →</a>
        <a href="/condition/">Condition Guide →</a>
        <a href="/locations/">Delivery Areas →</a>
        <a href="/blog/wind-and-water-tight-explained/">Wind &amp; Water Tight explained →</a>
        <a href="/blog/how-to-read-container-id-number-iso-6346/">Read the container markings yourself →</a>
      </div>
      <div class="cta-box">
        <h2>Bought your due diligence. Now get a real quote.</h2>
        <p>Tell us your size, zip code, and intended use, and we'll get back to you within 4 business hours.</p>
        <a href="/quote/" class="btn">Get My Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bg-hero { padding: 80px 0 64px; background: var(--yellow); border-bottom: 2.5px solid var(--ink); }
  .sh { display: flex; gap: 16px; flex-wrap: wrap; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .7; margin-bottom: 20px; }
  .bg-hero .big { font-family: var(--narrow); font-size: var(--t-big); text-transform: uppercase; line-height: .95; font-weight: 800; }
  .bg-hero .lede { font-size: 20px; line-height: 1.45; max-width: 740px; font-weight: 500; margin-top: 24px; }
  .bg-jump { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .bg-jump a { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; background: var(--ink); color: var(--yellow); padding: 8px 14px; }
  .bg-jump a:hover { background: var(--cream); color: var(--ink); }

  .bg-section { padding: 64px 0; border-bottom: 1.5px solid rgba(11,15,26,.1); scroll-margin-top: 120px; }
  .bg-decisions { background: white; }
  .bg-checklist { background: var(--cream); }
  .bg-recap { background: white; }
  .bg-faq { background: var(--cream); }
  .bg-cta-wrap { background: white; }
  .section-title { font-family: var(--narrow); font-size: 36px; text-transform: uppercase; margin-bottom: 12px; }
  .section-intro { font-size: 17px; line-height: 1.6; max-width: 760px; opacity: .8; margin-bottom: 32px; }

  /* The four decisions. Two-up on desktop so the block reads as a set rather than a list, and the
     internal rules are drawn with nth-child so adding or removing a decision needs no class. */
  .dec-grid { display: grid; grid-template-columns: repeat(2, 1fr); border: 2.5px solid var(--ink); background: white; }
  .dec-item { padding: 28px 32px; border-right: 1.5px solid rgba(11,15,26,.1); border-bottom: 1.5px solid rgba(11,15,26,.1); display: flex; flex-direction: column; align-items: flex-start; }
  .dec-item:nth-child(2n) { border-right: none; }
  .dec-item:nth-last-child(-n+2) { border-bottom: none; }
  .dec-n { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .55; }
  .dec-item h3 { font-family: var(--narrow); font-size: 26px; text-transform: uppercase; margin: 8px 0 12px; }
  .dec-body { line-height: 1.65; opacity: .85; }
  .dec-more { margin-top: auto; padding-top: 18px; font-family: var(--mono); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; border-bottom: 2px solid var(--yellow-d); }
  .dec-more:hover { background: var(--yellow); }

  .check-list { border: 2.5px solid var(--ink); background: white; }
  .check-item { display: flex; gap: 24px; padding: 28px 32px; border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .check-item:last-child { border-bottom: none; }
  .check-n { font-family: var(--narrow); font-size: 32px; font-weight: 800; color: var(--yellow-d); flex-shrink: 0; width: 48px; -webkit-text-stroke: 1.5px var(--ink); }
  .check-body h3 { font-family: var(--narrow); font-size: 20px; text-transform: uppercase; margin-bottom: 10px; }
  .check-body p { line-height: 1.65; opacity: .85; max-width: 780px; }
  .check-body p a { border-bottom: 2px solid var(--yellow-d); font-weight: 600; opacity: 1; }

  .table-wrap { overflow-x: auto; border: 2.5px solid var(--ink); background: white; }
  .bg-table { width: 100%; border-collapse: collapse; min-width: 620px; }
  .bg-table th, .bg-table td { padding: 14px 18px; text-align: left; border-bottom: 1.5px solid rgba(11,15,26,.1); font-size: 14px; }
  .bg-table thead th { font-family: var(--narrow); font-size: 14px; font-weight: 700; text-transform: uppercase; background: var(--ink); color: var(--yellow); }
  .bg-table tbody th { font-family: var(--narrow); font-weight: 700; font-size: 15px; }
  .bg-table tr:last-child td, .bg-table tr:last-child th { border-bottom: none; }

  .bg-callout { margin-top: 32px; background: var(--ink); color: var(--cream); padding: 32px; border: 2.5px solid var(--ink); }
  .bg-callout h4 { font-family: var(--narrow); font-size: 22px; text-transform: uppercase; margin-bottom: 10px; color: var(--yellow); }
  .bg-callout p { line-height: 1.6; opacity: .85; max-width: 780px; }

  .faq-list { border: 2.5px solid var(--ink); }
  .faq-item { padding: 28px 32px; border-bottom: 1.5px solid rgba(11,15,26,.1); background: white; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item h3 { font-family: var(--narrow); font-size: 20px; text-transform: uppercase; margin-bottom: 10px; }
  .faq-item p { opacity: .8; line-height: 1.6; max-width: 780px; }

  .spoke-row { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 48px; }
  .spoke-row a { font-family: var(--narrow); font-weight: 700; font-size: 16px; text-transform: uppercase; border: 2.5px solid var(--ink); padding: 12px 18px; background: white; }
  .spoke-row a:hover { background: var(--ink); color: var(--yellow); }
  .cta-box { background: var(--ink); color: var(--cream); padding: 56px; text-align: center; box-shadow: 12px 12px 0 var(--yellow); }
  .cta-box h2 { font-family: var(--narrow); font-size: 40px; text-transform: uppercase; margin-bottom: 14px; }
  .cta-box p { font-size: 17px; opacity: .8; margin-bottom: 32px; }

  @media (max-width: 960px) {
    .bg-section { scroll-margin-top: 240px; }
  }
  @media (max-width: 860px) {
    .dec-grid { grid-template-columns: 1fr; }
    .dec-item { border-right: none; }
    .dec-item:nth-last-child(-n+2) { border-bottom: 1.5px solid rgba(11,15,26,.1); }
    .dec-item:last-child { border-bottom: none; }
  }
  @media (max-width: 768px) {
    .bg-section { padding: 56px 0; }
    .dec-item { padding: 24px 20px; }
    .check-item { flex-direction: column; gap: 12px; padding: 24px 20px; }
    .check-n { width: auto; font-size: 24px; }
    .cta-box { padding: 36px 22px; }
    .cta-box h2 { font-size: 28px; }
  }
</style>
