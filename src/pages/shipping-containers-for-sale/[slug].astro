  .cond-body { font-size: 15.5px; line-height: 1.65; margin: 0 0 20px; opacity: .85; }
  .cond-body a { border-bottom: 2px solid var(--yellow-d); font-weight: 600; }
  .cond-claim { border: 2.5px solid var(--ink); background: white; box-shadow: 8px 8px 0 var(--yellow); padding: 22px; }
