  .listing-lede { font-size: 19px; line-height: 1.4; font-weight: 600; margin: 0 0 20px; }

  /* BUY BOX: the only place in the visible body a dollar figure renders; the disclaimer
     is its adjacent sibling per the standing pricing policy. Figures flow from
     src/data/pricing.ts only. */
  .buy-box { background: white; border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); padding: 24px 24px 22px; max-width: 480px; }
  .buy-box-label { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .6; margin: 0 0 8px; }
  .buy-box-price { font-family: var(--narrow); font-size: clamp(42px, 9vw, 54px); font-weight: 800; line-height: .95; letter-spacing: -.02em; margin: 0 0 10px; }
  .buy-box-disclaimer { font-size: 13px; line-height: 1.5; opacity: .8; margin: 0 0 16px; }
  .buy-box-note { font-family: var(--mono); font-size: 11px; line-height: 1.55; letter-spacing: .02em; opacity: .6; margin: -8px 0 16px; }
  .buy-box-ctas { display: grid; gap: 10px; }
  .buy-box-ctas .btn { justify-content: center; padding: 15px 22px; }
  .buy-btn-primary { background: var(--yellow); color: var(--ink); }
  .buy-btn-primary:hover { background: var(--ink); color: var(--yellow); }
  /* The demoted quote link and the surviving /locations/ bridge. Mono and small so neither
     competes with the single button above them. */
  .buy-alt { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; margin: 14px 0 0; opacity: .7; }
  .buy-alt + .buy-alt { margin-top: 8px; }
  .buy-alt a { border-bottom: 1.5px solid var(--ink); font-weight: 700; }

  /* Rent-to-own footer of the plate. A hairline rule separates it from the CTA so it reads as a
     second path rather than a second button, and the condition sits immediately under the offer at
     the same small size as .buy-box-disclaimer, inside the same bordered block. */
  .buy-box-rto { border-top: 1.5px solid rgba(0, 0, 0, .14); margin: 16px 0 0; padding: 14px 0 0; }
  .buy-box-rto-offer { font-size: 14px; line-height: 1.5; margin: 0 0 6px; }
