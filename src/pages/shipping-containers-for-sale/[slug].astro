</BaseLayout>

<style>
  /* ============================================================================
     LISTING HEAD. The base styles ARE the mobile layout: the DOM order is H1,
     photo, body (lede + buy box + dimensions), delivery aside, and the >=961px
     query regrids the same children into photo-left, decision-right with the
     aside lifted back into the empty left column under the photo.
     ============================================================================ */
  .prod-head { padding: 32px 0 52px; background: var(--yellow); border-bottom: 2.5px solid var(--ink); }
  .breadcrumb-nav { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .6; margin-bottom: 22px; display: flex; align-items: center; gap: 8px; }
  .breadcrumb-nav a { color: inherit; text-decoration: none; }
  .breadcrumb-nav a:hover { opacity: 1; }
  .listing { display: grid; grid-template-columns: minmax(0, 1fr); }
  .listing-h1 { font-family: var(--narrow); font-size: clamp(30px, 4.4vw, 46px); font-weight: 800; line-height: 1.02; text-transform: uppercase; letter-spacing: -.015em; margin: 0 0 14px; }
  .listing-media { margin: 0 0 24px; }
  .listing-frame { border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: white; }
  .listing-frame img { display: block; width: 100%; height: auto; }
