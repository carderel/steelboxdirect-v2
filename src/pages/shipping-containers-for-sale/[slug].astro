---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CallbackForm from '../../components/CallbackForm.astro';
import { Image } from 'astro:assets';
import { containers } from '../../data/containers';
import type { Container } from '../../data/containers';
import { CONDITION } from '../../data/condition';
import { priceBySlug, formatPrice, asOfLabel, nationalPriceLabel } from '../../data/pricing';
import { RTO_TERMS, RTO_DOWN_CONDITION } from '../../data/rtoTerms';
import { DELIVERY_ACCESS } from '../../data/permitCounties';

// MOCK A RESTRUCTURE, 2026-09-16, owner approved build and ship.
//
// The page is now an ordered proof document in three acts. Listing head, then the 3D viewer
// UNNUMBERED above the acts, then 01 to 07 with no gap:
//   ACT ONE / WHAT IT IS              01 specs + compare merged, 02 what Wind and Water Tight means
//   ACT TWO / HOW YOU GET IT          03 when it arrives and where it lands, 04 the single ask
//   ACT THREE / WHERE AND WHO IT COMES FROM  05 is this a real company, 06 guides, 07 FAQ
// Cut in this pass: prod-uses, the closing cta-section, prod-pricing as a band (it survives as one
// link inside the buy box), and the three spec chips under the H1 (the dimensions block states
// those numbers properly). New: the dimensions block, the delivery block under the hero photo, the
// seven question FAQ and its FAQPage markup, and the act band markers.
//
// THE VISIBLE DATE STAYS AT MONTH PRECISION, and it is a decision rather than an oversight.
//
// The feed now carries day precision, and effectiveSinceLabel in src/data/pricing.ts renders it, so
// the copy below could say in effect since August 18 instead of as of August 2026. Open Question O4 of
// docs/superpowers/specs/2026-08-17-geo-pricing-feed-design.md proposed exactly that and it is
// unanswered, so the weaker claim ships.
//
// It is not only a sign off question. pricing.asOf is ONE date for all three product pages: see
// nationalEffectiveSince in src/data/pricing.ts, which takes the latest effectiveSince across every
// metro and every SKU. On a day the 20ft moves in one metro and the two 40ft figures do not, that one
// date advances for all three pages, so a day precision sentence on the 40ft pages would name a day on
// which their own figure did not move. Month precision absorbs that. Day precision would not.
//
// So making O4 a yes needs a per SKU change date first, meaning a national effective date computed for
// the SKU being rendered, and then the copy change. Doing the copy change alone would publish a
// sharper number that is wrong more often than the blurry one it replaced.

export function getStaticPaths() {
  return containers.map((c) => ({ params: { slug: c.slug }, props: { container: c } }));
}

interface Props { container: Container }
const { container: c } = Astro.props;
const others = containers.filter((x) => x.slug !== c.slug);
const price = priceBySlug[c.slug];
// Clearance plate hidden pending the owner-approved illustration; flip to re-enable.
// The plate itself is still rejected (v1 and v2, 2026-08-26), so this gate stays false and the
// clearance FIGURES ship as text in section 03 instead, derived from DELIVERY_ACCESS below.
const SHOW_CLEARANCE_PLATE = false;

// Maps each product slug to the quote form's size_preference select value, which the
// quote page already reads from /quote/?size= (see the sizeMap in src/pages/quote/index.astro).
// Keep in sync with the <option> values there and SIZE_LABELS in src/pages/api/submit-quote.ts.
function sizeParamFor(slug: string): string {
  const map: Record<string, string> = {
    '20-foot-shipping-container': '20ft',
    '40-foot-shipping-container': '40ft',
    '40-foot-high-cube-container': '40ft_hc',
  };
  return map[slug] ?? '';
}
const sizeParam = sizeParamFor(c.slug);

// 3D VIEWER REGISTRY. One entry per product that has a model built for it; the section markup
// below renders only when the current slug has an entry, so adding a fourth product is a data
// change here and nothing else, and a product with no model renders no band at all rather than
// a broken frame. Each embed HTML in public/3d/ loads the SAME engine (embed-core.js) and the
// SAME stylesheet (embed.css) and differs only in its init block, so the second and third
// products cost a small HTML file and one JPG each, not another copy of the renderer.
// isoCode and modelLabel exist because the figure's head bar names the exact unit modeled:
// a 40ft high cube is 45G1 and is not "standard", so neither string can be derived from
// shortName without a special case. The dimensions block head reads the same two fields, with a
// fallback to shortName, so a future product with no model still gets a titled block.
// The still images are all 1376x768, which is why the width/height attributes below are literal.
interface ViewerModel {
  embed: string;
  still: string;
  modelLabel: string;
  isoCode: string;
}
const VIEWER_MODELS: Record<string, ViewerModel> = {
  '20-foot-shipping-container': {
    embed: '/3d/embed-20ft.html',
    still: '/3d/container-20ft-exploded.jpg',
    modelLabel: '20ft standard',
    isoCode: '22G1',
  },
  '40-foot-shipping-container': {
    embed: '/3d/embed-40ft.html',
    still: '/3d/container-40ft-exploded.jpg',
    modelLabel: '40ft standard',
    isoCode: '42G1',
  },
  '40-foot-high-cube-container': {
    embed: '/3d/embed-40ft-hc.html',
    still: '/3d/container-40ft-hc-exploded.jpg',
    modelLabel: '40ft high cube',
    isoCode: '45G1',
  },
};
const viewer: ViewerModel | undefined = VIEWER_MODELS[c.slug];
const dimsTitle = viewer ? `${viewer.modelLabel}, ISO ${viewer.isoCode}` : c.shortName;

// THE DIMENSIONS BLOCK, and why it parses strings instead of reading new fields.
//
// containers.ts stores each measurement as ONE sentence-shaped string, "20' L x 8' W x 8'6\" H".
// That is the right shape for the spec table, the markdown twin and the Product schema, all of
// which want the whole measurement in one cell, and it is the wrong shape for a reference block
// whose entire job is that a buyer can read 8' against 7'8" straight down a column. Rather than
// add three more fields to containers.ts and have two sources for one fact that can then
// disagree, the strings are split here and the split is checked: an unparseable segment throws
// at build time rather than rendering a blank cell. So there is still exactly one source for
// every number on this page, and a malformed edit to containers.ts fails the build loudly.
// The separator is U+00D7 (multiplication sign), written as an escape to keep this file ASCII.
const DIM_SEP = '\u00D7';
type Axis = 'L' | 'W' | 'H';
function splitDims(value: string, field: string): Partial<Record<Axis, string>> {
  const out: Partial<Record<Axis, string>> = {};
  for (const part of value.split(DIM_SEP)) {
    const m = part.trim().match(/^(.+?)\s+([LWH])$/);
    if (!m) {
      throw new Error(
        `containers.ts ${c.slug}.specs.${field}: cannot read an axis out of "${part.trim()}". ` +
        `Each segment must end in L, W or H, for example "8'6\\" H".`,
      );
    }
    out[m[2] as Axis] = m[1];
  }
  return out;
}
const dimRows: { label: string; note: string; axes: Partial<Record<Axis, string>> }[] = [
  { label: 'External',     note: 'What your pad has to take',  axes: splitDims(c.specs.externalDims, 'externalDims') },
  { label: 'Internal',     note: 'The space you get to fill',  axes: splitDims(c.specs.internalDims, 'internalDims') },
  { label: 'Door opening', note: 'What has to fit through it', axes: splitDims(c.specs.doorOpening, 'doorOpening') },
];
// Capacity, payload and tare split into figure and unit so the footer strip can set the numeral
// at display size and the unit at label size. A value that does not start with a numeral renders
// whole, which is the honest fallback rather than a throw: nothing is lost, only the styling.
function splitFigure(value: string): { n: string; u: string } {
  const m = value.match(/^([\d,.]+)\s*(.*)$/);
  return m ? { n: m[1], u: m[2] } : { n: value, u: '' };
}
const dimFigures = [
  { k: 'Capacity',    ...splitFigure(c.specs.cubicCap) },
  { k: 'Payload',     ...splitFigure(c.specs.payload) },
  { k: 'Tare (empty)', ...splitFigure(c.specs.tare) },
];

// THE CLEARANCE FIGURES, pulled out of the locked sentence rather than typed beside it.
//
// DELIVERY_ACCESS.clearance in src/data/permitCounties.ts is the site's one statement of what a
// delivery rig needs, and it is prose. The delivery block under the hero photo and the site-check
// strip in section 03 both want the bare figures. Retyping them here would create a second source
// that drifts the first time the sentence is reworded, so each figure is extracted from the one
// string and a miss THROWS at build time: if somebody rewords the locked sentence, this page fails
// the build instead of quietly publishing stale numbers beside the new wording.
function clearanceFigure(name: string, re: RegExp): string {
  const m = DELIVERY_ACCESS.clearance.match(re);
  if (!m || !m[1]) {
    throw new Error(
      `DELIVERY_ACCESS.clearance (src/data/permitCounties.ts) no longer states the ${name} figure ` +
      `in the shape ${re}. Update the pattern in src/pages/shipping-containers-for-sale/[slug].astro ` +
      `to match the new wording rather than typing the figure in.`,
    );
  }
  return m[1];
}
const CLR = {
  rig:      clearanceFigure('truck combination', /roughly a ([a-z-]+ foot) truck combination/),
  approach: clearanceFigure('straight approach', /at least ([\d,]+ feet) of straight approach/),
  width:    clearanceFigure('width clearance',   /([\d,]+ feet) of width clearance/),
  overhead: clearanceFigure('overhead clearance', /([\d,]+ feet) of overhead clearance/),
  ground:   clearanceFigure('ground support',    /support a ([\d,]+ lb) truck/),
};

// ONE comparison data source, now doing both jobs. prod-specs and prod-compare were two bands
// showing overlapping numbers; section 01 is the merged table, so the rows below carry the full
// specification rather than the three-row summary the old compare band used. Best-for cells drop
// the shared CONDITION.blurb tail that containers.ts appends to every compareNote; the condition
// is stated once in the line above the table instead of repeating per column.
function comparisonColumn(pick: (x: Container) => string): Record<string, string> {
  const values: Record<string, string> = {};
  for (const x of containers) values[x.slug] = pick(x);
  return values;
}
const compareRows: { label: string; values: Record<string, string> }[] = [
  { label: 'External',        values: comparisonColumn((x) => x.specs.externalDims) },
  { label: 'Internal',        values: comparisonColumn((x) => x.specs.internalDims) },
  { label: 'Door opening',    values: comparisonColumn((x) => x.specs.doorOpening) },
  { label: 'Cubic capacity',  values: comparisonColumn((x) => x.specs.cubicCap) },
  { label: 'Payload',         values: comparisonColumn((x) => x.specs.payload) },
  { label: 'Tare weight',     values: comparisonColumn((x) => x.specs.tare) },
  { label: 'Best for',        values: comparisonColumn((x) => x.compareNote.replace(CONDITION.blurb, '').trim()) },
];

// SECTION 07, THE FAQ. New to the three product pages on 2026-09-16 and the FAQPage schema source
// for this template: eleven other pages carry FAQPage markup, including the listing page these
// three sit under, so the site's highest-intent commercial pages carried none at all.
//
// NOTHING BELOW IS A NEW CLAIM. Every answer is lifted from copy already published on this site or
// from /terms/, and where a locked string exists it is interpolated rather than retyped:
// DELIVERY_ACCESS.timing (Q2), DELIVERY_ACCESS.clearance (Q7) and CONDITION.blurb (Q4) all come
// from their modules. Order is the review corpus order (see
// UDO Project/.outputs/research/2026-09-14-columbus-review-mining.md), not the order that is
// easiest to answer: delivery cost, date, placement, condition, the warranty remedy, ground,
// access. Three answers are deliberately less comfortable than a competitor's would be. Q3 does
// not promise placement anywhere you want it, it states the terms clause that makes a failed
// delivery the buyer's cost. Q5 names the customer-applied fiberglass patch kit as the whole
// remedy inside the answer. Q1 keeps the 250 mile scope instead of saying delivery is always
// included. There is NO permit question, and no answer states or implies whether a permit is
// needed; the guides row in section 06 still carries the permit link, where the deferral to the
// local authority belongs.
//
// `a` is the plain-text answer and the only thing the schema ever sees. `html` is an optional
// richer rendering for the visible block, so a link in the copy never leaks into JSON-LD.
interface Faq { q: string; a: string; html?: string }
const faqs: Faq[] = [
  {
    q: 'Is delivery included in the price?',
    a: 'Within 250 miles of Cincinnati, yes. We quote all-in on purpose: the container, delivery to your ZIP, and placement on flat ground, in one number, rather than a container price with a freight line arriving later. The figure at the top of this page is a delivered average across the home metros, not a bare unit price with delivery still to come. Past that home region we deliver from regional depot hubs, and the delivery cost depends on the distance from the depot your container ships from, so that one has to be quoted for your address.',
  },
  {
    q: 'How long does delivery actually take?',
    a: `${DELIVERY_ACCESS.timing} Depot inventory is stacked and sequenced rather than staged for a quick pull, and drivers book out several weeks ahead, so exact timing depends on current availability and where you are. Scheduling depends on independent drivers and can shift; that is true of container delivery generally, and Steel Box Direct does not control it.`,
  },
  {
    q: 'Will the driver put it exactly where I want it?',
    a: "Where it lands is decided before delivery is scheduled, not on delivery day. A tilt-bed does not lower the container down: it raises the front of the bed and the box slides off the back while the truck creeps forward, so the container lands in a straight line along the truck's path. Placement is directional, and if you want the doors facing the house, that has to be planned before the truck backs in. So send photos of the route and the placement spot with your quote request, mark the exact spot with stakes, paint or cones at the four corners, and have somebody on site who can point at it and make a decision. Where a site cannot give the truck what it needs, a crane-set delivery places the container instead: that exists precisely for sharp turns, fencelines and soft ground. It is worth knowing what happens if the site will not take it, because it costs money. Under our terms, if delivery cannot be made due to space limitations or an unsuitable environment, for example wet ground, snow, mud, no clear path, graded hills or low bridges, it is the customer's responsibility to cover the transport fee, the return delivery fee, and any third-party costs such as wrecker or tow charges. If there is not adequate space, we confer with you to either call the attempt a failed delivery or agree an alternate suitable location. An hour spent looking at your access now is the cheapest hour in the whole transaction.",
    html: "<p>Where it lands is decided before delivery is scheduled, not on delivery day. A tilt-bed does not lower the container down: it raises the front of the bed and the box slides off the back while the truck creeps forward, so the container lands in a straight line along the truck's path. Placement is directional, and if you want the doors facing the house, that has to be planned before the truck backs in.</p><p>So send photos of the route and the placement spot with your quote request, mark the exact spot with stakes, paint or cones at the four corners, and have somebody on site who can point at it and make a decision. Where a site cannot give the truck what it needs, a crane-set delivery places the container instead: that exists precisely for sharp turns, fencelines and soft ground.</p><p>It is worth knowing what happens if the site will not take it, because it costs money. Under our <a href=\"/terms/#delivery\">terms</a>, if delivery cannot be made due to space limitations or an unsuitable environment, for example wet ground, snow, mud, no clear path, graded hills or low bridges, it is the customer's responsibility to cover the transport fee, the return delivery fee, and any third-party costs such as wrecker or tow charges. If there is not adequate space, we confer with you to either call the attempt a failed delivery or agree an alternate suitable location. An hour spent looking at your access now is the cheapest hour in the whole transaction.</p>",
  },
  {
    q: 'What does Wind and Water Tight mean, and what wear should I expect?',
    a: `${CONDITION.blurb} It is the one grade we sell, in all three sizes, sealed against rain, wind, snow and pests, and sold as-is for storage and on-site use. It spent years at sea and it looks like it. Expect surface rust, patched paint, dents in the corrugation and a previous owner's markings, over weathering (Cor-Ten) steel built to last decades. What you should not expect is daylight through the roof, a floor that gives, or door seals that have gone.`,
  },
  {
    q: 'What happens if it leaks?',
    a: 'There is a limited Lifetime Leak Warranty, and the remedy is the part worth knowing before you buy rather than after. If you discover a leak, we send you an industry-approved equipment patch along with installation instructions, and the patch is installed by you. It is a durable fiberglass-reinforced polyester fabric that bonds to the metal surface, flexible and easy to apply, and it becomes solid when fully cured: roughly five to ten minutes under a UV lamp or direct sunlight, one to two hours in other conditions. Once cured it can be drilled, sanded or painted. That is the entire remedy, and we state it here rather than in fine print, because the remedy is where every warranty argument in this business ends up.',
    html: '<p>There is a limited Lifetime Leak Warranty, and the remedy is the part worth knowing before you buy rather than after. If you discover a leak, we send you an industry-approved equipment patch along with installation instructions, and the patch is installed by you.</p><p>It is a durable fiberglass-reinforced polyester fabric that bonds to the metal surface, flexible and easy to apply, and it becomes solid when fully cured: roughly five to ten minutes under a UV lamp or direct sunlight, one to two hours in other conditions. Once cured it can be drilled, sanded or painted. That is the entire remedy, and we state it here rather than in fine print, because the remedy is where every warranty argument in this business ends up. <a href="/terms/#lifetime-leak-warranty">Read the terms</a></p>',
  },
  {
    q: 'What do I need to set it on?',
    a: 'Level ground that drains, and no slab to pour. A container carries its load at its four corner castings, and when one corner sits low the frame twists slightly; that twist shows up at the door end, because the door opening is the one side of the box with no wall across it, and the result is doors that bind or will not latch fully. Level side to side matters most for door operation, and keeping the container up out of standing water lets the underside dry between rains. Gravel is the most reliable surface because it drains and spreads load. Packed dirt is dependable when dry and much less so when wet. Grass is the one that fools people: turf is a thin mat over topsoil, and topsoil holds water, so a lawn that felt solid underfoot in the morning can rut badly under loaded tires by the afternoon. If you want the container set on blocking, say so in your quote request: blocking changes how the box comes off the truck, and it has to be planned before the driver is on your property rather than decided in your driveway.',
  },
  {
    q: 'Will a truck fit down my driveway?',
    a: `${DELIVERY_ACCESS.clearance} Measure the narrowest point of your route rather than the average: gate posts, a mailbox, a parked truck, the corner of the garage. And look up at the drop spot as well as at the lane, because when the bed tilts the raised end reaches higher than the truck stood driving in.`,
    html: `<p>${DELIVERY_ACCESS.clearance}</p><p>Measure the narrowest point of your route rather than the average: gate posts, a mailbox, a parked truck, the corner of the garage. And look up at the drop spot as well as at the lane, because when the bed tilts the raised end reaches higher than the truck stood driving in. <a href="#clearance">See the clearance figures</a> in section 03.</p>`,
  },
];

// FIG. D1 delivery clearance plate. STILL HIDDEN: plate v1 and v2 were rejected by the owner on
// 2026-08-26 and nothing here un-hides them. The section below is kept, gated, so the owner's
// Gemini illustration drops straight into the right act when it lands. Prompts:
// UDO Project/.outputs/image-prompts/2026-08-26-clearance-plate-prompts.md
// Every number on the plate traces to a published source and NOTHING is estimated (spec: omit
// rather than estimate):
//   - 65 ft truck combination, 100+ ft straight approach (tilt bed), 14 ft overhead,
//     12 ft wide path, 30,000 lb ground: all published on src/pages/delivery/index.astro.
//   - Container length and height: c.specs.externalDims (containers.ts).
// The delivery page's "60 feet average truck length" sidebar stat is deliberately NOT
// drawn: the 65 ft combination is the maneuvering requirement, and two rig figures on
// one plate would read as a contradiction. The tractor, tilt deck, wheels, driveway
// shading, and destination garage are illustration only; no dimension line touches
// any of them.
// Geometry: 9 px per foot inside the 960-wide viewBox. Ground datum at y=184, so the
// 14 ft overhead limit sits at y=58 (184 minus 14*9) and the tilt deck carries the
// container at y=150. The rig spans x=64..649 (585 px = 65 ft to scale). Container
// length and height are the only per-page variables; both scale off c.specs.externalDims.
const PX_PER_FT = 9;
const DECK_TOP = 150; // tilt deck surface the container rides on (illustration height)
const lengthFt = parseInt(c.specs.externalDims, 10); // "20' L x ..." -> 20
const contLenPx = lengthFt * PX_PER_FT;
const contX1 = 645; // container rear sits at the rear of the tilt deck
const contX0 = contX1 - contLenPx;
const contH = Math.round((c.specs.externalDims.includes("9'6") ? 9.5 : 8.5) * PX_PER_FT); // 9'6" HC vs 8'6" std, to scale
const contTop = DECK_TOP - contH;
const contMidY = contTop + contH / 2;
const lenChipW = 62;
const lenChipX = (contX0 + contX1) / 2 - lenChipW / 2;
const lenChipMidX = (contX0 + contX1) / 2;
const plateTitle = `Delivery clearance for the ${c.shortName}: the rig and the room it needs`;
const plateAria = `Side profile of a tilt bed delivery truck carrying a ${c.shortName} container toward a garage: a 65 foot truck and tilt bed combination, a ${lengthFt} foot container riding on the deck, 14 feet of overhead clearance under wires and branches, 100 or more feet of straight approach, a 12 foot wide path, and ground that holds a 30,000 pound truck`;
---

<BaseLayout title={c.seo.title} description={c.seo.description} pageType="product"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Shipping Containers for Sale', path: '/shipping-containers-for-sale/' }, { name: c.name }]}
  schema={{ kind: 'product', container: c, price,
    specs: [
      { k: 'Exterior', v: c.specs.externalDims },
      { k: 'Interior', v: c.specs.internalDims },
      { k: 'Door opening', v: c.specs.doorOpening },
      { k: 'Cubic capacity', v: c.specs.cubicCap },
      { k: 'Condition', v: 'Wind & Water Tight (used)' },
      { k: 'Warranty', v: 'Lifetime Leak, self-applied patch kit' },
      ...(price ? [{ k: nationalPriceLabel, v: formatPrice(price.price) }] : []),
    ],
    faqs: faqs.map((f) => ({ q: f.q, a: f.a })) }}>

  <!-- LISTING HEAD. Desktop is photo left, decision column right; the aside is LAST in the DOM so
       that on a phone it falls below the price rather than pushing it down, and the >=961px grid
       lifts it back into the empty left column under the photo.
       The four trust bullets that used to sit here are gone: each of them is now a band below,
       where it can be argued instead of asserted. The dimensions block replaces the three 11px
       spec chips that used to sit under the H1. The interim photo is a real 40ft, captioned as
       such in containers.ts, shared by all three pages until per-size yard photos land, and it is
       still the only eager image on the page. -->
  <section class="prod-head">
    <div class="wrap">
      <div class="breadcrumb-nav">
        <a href="/shipping-containers-for-sale/">Shipping Containers for Sale</a>
        <span>&rsaquo;</span>
        <span>{c.name}</span>
      </div>
      <div class="listing">
        <h1 class="listing-h1">{c.name}</h1>
        {c.heroPhoto && (
          <figure class="listing-media">
            <div class="listing-frame">
              <Image src={c.heroPhoto.src} alt={c.heroPhoto.alt} width={960} format="webp" loading="eager" fetchpriority="high" />
            </div>
            {c.heroPhoto.caption && <figcaption class="listing-caption">{c.heroPhoto.caption}</figcaption>}
          </figure>
        )}
        <div class="listing-body">
          <p class="listing-lede">{c.tagline}</p>
          {price && (
            <div class="buy-box">
              <p class="buy-box-label">{nationalPriceLabel}</p>
              <p class="buy-box-price">{formatPrice(price.price)}</p>
              <p class="buy-box-disclaimer">Average starting price, not a quote; yours may be more or less. Your ZIP code is a big factor in the delivered price, so for the most accurate number, talk directly to Doug. ({asOfLabel})</p>
              {c.slug === '40-foot-high-cube-container' && (
                <p class="buy-box-note">Supply runs deep right now, so the High Cube average can land below the standard 40ft.</p>
              )}
              <div class="buy-box-ctas">
                <a href="#talk-to-doug" class="btn buy-btn-primary">Have Doug call me <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
              </div>
              <!-- The quote form drops from a second button to a text link, and the whole
                   prod-pricing band drops to the /locations/ line under it. That band's only
                   unique job was the delivered-price-by-ZIP bridge, and a link does that job for
                   the cost of a line. No dollar figure renders anywhere below this block. -->
              <p class="buy-alt">Rather write it all down? <a href={'/quote/?size=' + sizeParam}>Build my full quote</a></p>
              <p class="buy-alt"><a href="/locations/">See the delivered price in your city</a></p>
              <!-- RENT TO OWN. The figure and its condition render in ONE block. That is the whole
                   rule: the headline states an offer, the line under it states what makes the offer
                   true, and neither may ship without the other. Both come from src/data/rtoTerms.ts,
                   so nothing here is typed, and src/lib/compliance/rto-terms-guard.test.ts fails the
                   suite if a later edit types the figure in. -->
              <div class="buy-box-rto">
                <p class="buy-box-rto-offer">
                  Not ready to pay it all at once? Rent to own from <strong>{RTO_TERMS.downPayment} down</strong>.
                </p>
                <p class="buy-box-rto-cond">
                  {RTO_DOWN_CONDITION} Administered by {RTO_TERMS.provider}, an independent third
                  party, and subject to their approval.
                  <a href="/rent-to-own/#down-payment">How rent to own works</a>
                </p>
              </div>
            </div>
          )}

          <!-- THE DIMENSIONS BLOCK. Deliberately built in the same reference grammar as the
               delivery block opposite it: 2.5px ink edge, the head's yellow ground showing
               straight through, no drop shadow, no button. The buy box owns the decision and keeps
               the shadow; this is the data you check the decision against. Every figure comes from
               c.specs through dimRows / dimFigures above; nothing here is typed. -->
