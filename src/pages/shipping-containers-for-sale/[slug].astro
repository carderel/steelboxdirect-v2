---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CallbackForm from '../../components/CallbackForm.astro';
import { Image } from 'astro:assets';
import { containers } from '../../data/containers';
import type { Container } from '../../data/containers';
import { priceBySlug, formatPrice, asOfLabel, nationalPriceLabel } from '../../data/pricing';

// THE VISIBLE DATE STAYS AT MONTH PRECISION, and it is a decision rather than an oversight.
//
// The feed now carries day precision, and effectiveSinceLabel in src/data/pricing.ts renders it, so
// the copy below could say in effect since August 18 instead of as of August 2026. Open Question O4 of
// docs/superpowers/specs/2026-08-17-geo-pricing-feed-design.md proposed exactly that and it is
// unanswered, so the weaker claim ships.
//
// It is not only a sign off question. pricing.asOf is ONE date for all three product pages: see
// nationalEffectiveSince in src/data/pricing.ts, which takes the latest effectiveSince across every
// metro and every SKU. On a day the 20ft moves in one metro and the two 40ft figures do not, that one
// date advances for all three pages, so a day precision sentence on the 40ft pages would name a day on
// which their own figure did not move. Month precision absorbs that. Day precision would not.
//
// So making O4 a yes needs a per SKU change date first, meaning a national effective date computed for
// the SKU being rendered, and then the copy change. Doing the copy change alone would publish a
// sharper number that is wrong more often than the blurry one it replaced.

export function getStaticPaths() {
  return containers.map((c) => ({ params: { slug: c.slug }, props: { container: c } }));
}

interface Props { container: Container }
const { container: c } = Astro.props;
const others = containers.filter((x) => x.slug !== c.slug);
const price = priceBySlug[c.slug];

// Maps each product slug to the quote form's size_preference select value, which the
// quote page already reads from /quote/?size= (see the sizeMap in src/pages/quote/index.astro).
// Keep in sync with the <option> values there and SIZE_LABELS in src/pages/api/submit-quote.ts.
function sizeParamFor(slug: string): string {
  const map: Record<string, string> = {
    '20-foot-shipping-container': '20ft',
    '40-foot-shipping-container': '40ft',
    '40-foot-high-cube-container': '40ft_hc',
  };
  return map[slug] ?? '';
}
const sizeParam = sizeParamFor(c.slug);
---

<BaseLayout title={c.seo.title} description={c.seo.description} pageType="product"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Shipping Containers for Sale', path: '/shipping-containers-for-sale/' }, { name: c.name }]}
  schema={{ kind: 'product', container: c, price,
    specs: [
      { k: 'Exterior', v: c.specs.externalDims },
      { k: 'Interior', v: c.specs.internalDims },
      { k: 'Door opening', v: c.specs.doorOpening },
      { k: 'Cubic capacity', v: c.specs.cubicCap },
      { k: 'Condition', v: 'Wind & Water Tight (used)' },
      { k: 'Warranty', v: 'Lifetime Leak' },
      ...(price ? [{ k: nationalPriceLabel, v: formatPrice(price.price) }] : []),
    ] }}>

  <!-- HERO -->
  <section class="prod-hero">
    <div class="wrap">
      <div class="breadcrumb-nav">
        <a href="/shipping-containers-for-sale/">Shipping Containers for Sale</a>
        <span>›</span>
        <span>{c.name}</span>
      </div>
      <h1 class="big prod-h1">{c.name}</h1>
      <div class="key-specs">
        {c.keySpecs.map((s) => <span class="spec-chip">{s}</span>)}
      </div>
      <p class="lede">{c.tagline}</p>
      {c.heroPhoto && (
        <figure class="prod-photo">
          <Image src={c.heroPhoto.src} alt={c.heroPhoto.alt} width={1400} format="webp" />
        </figure>
      )}
      <!-- Confidence strip: five sourced claims, nothing invented. The price line renders
           entirely from src/data/pricing.ts. The /condition/ link swaps to the T-170 wear
           guide when that page ships. -->
      <ul class="conf-strip" aria-label="Why buyers trust this container">
        {price && (
          <li><strong>{formatPrice(price.price)}</strong> {nationalPriceLabel.toLowerCase()}. Not a quote; yours may be more or less. ({asOfLabel})</li>
        )}
        <li><strong>Wind &amp; Water Tight (used).</strong> Honest cosmetic wear. <a href="/condition/">What that means</a></li>
        <li><strong>Lifetime Leak Warranty</strong> on every container</li>
        <li>Delivered across <strong>Ohio, Indiana, Kentucky + western West Virginia</strong></li>
        <li>Quotes answered within <strong>4 business hours</strong></li>
      </ul>
      <a href={'/quote/?size=' + sizeParam} class="btn prod-cta">Get a Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
    </div>
  </section>

  <!-- PRICING -->
  <section class="prod-pricing">
    <div class="wrap">
      <h2 class="section-title">Used {c.shortName} Shipping Container for Sale</h2>
      <div class="pricing-card">
        <h3 class="m" style="margin-top: 0;">{c.shortName} Shipping Container Price</h3>
        <div class="price-figure">{formatPrice(price.price)}<span>{nationalPriceLabel} · {c.shortName}</span></div>
        <p class="price-disclaimer-text"><strong>This is an average starting price, not a quote.</strong> What you pay can land above or below; it depends mostly on how far we deliver and current market supply. We'll give you a real, all-in number when you request a quote. <em>(Average as of {asOfLabel}.)</em></p>
        {c.slug === '40-foot-high-cube-container' && (
          <p class="hc-supply-note">Supply runs deep right now, so the High Cube average can land below the standard 40ft.</p>
        )}
        <p class="price-bridge">Prices vary by metro, and we publish a dated delivered figure for each one we serve: <a href="/locations/">see the delivered price in your city</a>.</p>
        <a href="/quote/" class="btn">Get a Current Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        <p class="response-note">Most requests answered within 4 business hours.</p>
      </div>
    </div>
  </section>

  <!-- ACTION BLOCK: Doug callback or preselected full quote -->
  <section class="prod-action">
    <div class="wrap">
      <CallbackForm sizeLabel={c.shortName} sizePreference={sizeParam} />
    </div>
  </section>

  <!-- SPECS TABLE -->
  <section class="prod-specs">
    <div class="wrap">
      <h2 class="section-title">Specifications</h2>
      <div class="specs-card">
        <table class="specs-table">
          <tbody>
            <tr><th>External Dimensions</th><td>{c.specs.externalDims}</td></tr>
            <tr><th>Internal Dimensions</th><td>{c.specs.internalDims}</td></tr>
            <tr><th>Door Opening</th><td>{c.specs.doorOpening}</td></tr>
            <tr><th>Payload Capacity</th><td>{c.specs.payload}</td></tr>
            <tr><th>Tare Weight</th><td>{c.specs.tare}</td></tr>
            <tr><th>Cubic Capacity</th><td>{c.specs.cubicCap}</td></tr>
          </tbody>
        </table>
      </div>
        <p class="spec-ref-link">
          Full ISO 668 dimensions for every size are in our
          <a href="/container-reference/#dimensions">Container Reference</a>.
        </p>
    </div>
  </section>

  <!-- SIZE COMPARE -->
  <section class="prod-compare">
    <div class="wrap">
      <h2 class="section-title">How It Compares</h2>
      <div class="compare-card">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              {containers.map((x) => (
                <th class={x.slug === c.slug ? 'current-col' : ''}>
                  {x.slug === c.slug
                    ? <span>{x.shortName}</span>
                    : <a href={`/shipping-containers-for-sale/${x.slug}/`}>{x.shortName}</a>
                  }
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>External</th>
              {containers.map((x) => <td class={x.slug === c.slug ? 'current-col' : ''}>{x.specs.externalDims}</td>)}
            </tr>
            <tr>
              <th>Internal</th>
              {containers.map((x) => <td class={x.slug === c.slug ? 'current-col' : ''}>{x.specs.internalDims}</td>)}
            </tr>
            <tr>
              <th>Capacity</th>
              {containers.map((x) => <td class={x.slug === c.slug ? 'current-col' : ''}>{x.specs.cubicCap}</td>)}
            </tr>
            <tr>
              <th>Best for</th>
              {containers.map((x) => <td class={x.slug === c.slug ? 'current-col' : ''}>{x.compareNote}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="prod-uses">
    <div class="wrap">
      <h2 class="section-title">Common Uses</h2>
      <div class="uses-grid">
        {c.useCases.map((u) => (
          <div class="feature">
            <h4>{u.title}</h4>
            <p>{u.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GUIDE LINKS -->
  <section class="prod-guides">
    <div class="wrap">
      <p class="guides-label">Before you buy: answers to common questions</p>
      <div class="guides-row">
        <a href="/permits/" class="guide-link">Do I need a permit? →</a>
        <a href="/cost/" class="guide-link">What does it cost? →</a>
        <a href="/delivery/" class="guide-link">How is it delivered? →</a>
        <a href="/condition/" class="guide-link">New vs. used condition →</a>
        <a href="/container-reference/#markings" class="guide-link">How to read container markings →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="wrap">
      <div class="cta-box">
        <h2>Ready for a {c.shortName} quote?</h2>
        <p>Tell us your zip code and we'll get you a real number, fast.</p>
        <a href="/quote/" class="btn">Get My Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .prod-hero { padding: 80px 0 64px; background: var(--yellow); border-bottom: 2.5px solid var(--ink); }
  .breadcrumb-nav { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .6; margin-bottom: 24px; display: flex; align-items: center; gap: 8px; }
  .breadcrumb-nav a { color: inherit; text-decoration: none; }
  .breadcrumb-nav a:hover { opacity: 1; }
  .prod-h1 { margin-bottom: 24px; }
  .key-specs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  .spec-chip { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; background: var(--ink); color: var(--yellow); padding: 6px 14px; }
  .lede { font-size: 22px; line-height: 1.4; max-width: 680px; font-weight: 500; margin-bottom: 32px; }
  .prod-cta { margin-top: 8px; }

  /* REAL PHOTO SLOT (renders only when c.heroPhoto is set; no placeholders) */
  .prod-photo { margin: 0 0 28px; max-width: 720px; border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: white; }
  .prod-photo img { display: block; width: 100%; height: auto; }

  /* CONFIDENCE STRIP: mono chips on desktop, stacked list on mobile, ink check markers */
  .conf-strip { list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 12px; max-width: 920px; }
  .conf-strip li { position: relative; font-family: var(--mono); font-size: 12px; line-height: 1.55; letter-spacing: .02em; background: var(--cream); border: 1.5px solid var(--ink); padding: 8px 14px 8px 32px; }
  .conf-strip li::before { content: '✓'; position: absolute; left: 12px; top: 8px; color: var(--ink); font-weight: 700; }
  .conf-strip li strong { font-weight: 700; }
  .conf-strip li a { color: inherit; border-bottom: 1.5px solid var(--ink); font-weight: 600; text-decoration: none; }
  @media (max-width: 720px) {
    .conf-strip { display: block; }
    .conf-strip li { margin-bottom: 8px; }
    .conf-strip li:last-child { margin-bottom: 0; }
  }

  /* SPECS TABLE */
  .prod-specs { padding: 72px 0; background: var(--cream); border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .section-title { font-family: var(--narrow); font-size: 36px; text-transform: uppercase; margin-bottom: 32px; }
  .specs-card { background: white; border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); overflow: hidden; }
  .specs-table { width: 100%; border-collapse: collapse; }
  .specs-table tr { border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .specs-table tr:last-child { border-bottom: none; }
  .specs-table th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .55; text-align: left; padding: 18px 24px; width: 40%; font-weight: 500; }
  .specs-table td { font-family: var(--narrow); font-size: 20px; font-weight: 600; padding: 18px 24px; }
  .spec-ref-link { margin-top: 20px; font-size: 15px; opacity: .85; }
  .spec-ref-link a { border-bottom: 2px solid var(--yellow-d); font-weight: 600; }

  /* COMPARE */
  .prod-compare { padding: 72px 0; background: white; border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .compare-card { background: var(--cream); border: 2.5px solid var(--ink); overflow-x: auto; }
  .compare-table { width: 100%; border-collapse: collapse; min-width: 520px; }
  .compare-table th, .compare-table td { padding: 16px 20px; text-align: left; border-bottom: 1.5px solid rgba(11,15,26,.1); font-size: 14px; }
  .compare-table thead th { font-family: var(--narrow); font-size: 18px; font-weight: 700; text-transform: uppercase; background: var(--cream); }
  .compare-table tbody th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .55; font-weight: 500; background: var(--cream); }
  .compare-table tr:last-child td, .compare-table tr:last-child th { border-bottom: none; }
  .current-col { background: var(--ink); color: var(--yellow); }
  .current-col a { color: var(--yellow); }
  .compare-table a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  /* USE CASES */
  .prod-uses { padding: 72px 0; background: var(--cream); border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .uses-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .feature { border-left: 4px solid var(--yellow); padding-left: 24px; }
  .feature h4 { font-family: var(--narrow); font-size: 22px; text-transform: uppercase; margin-bottom: 10px; }
  .feature p { opacity: .8; line-height: 1.5; font-size: 15px; }

  /* PRICING */
  .prod-pricing { padding: 64px 0; background: white; }
  .pricing-card { background: var(--ink); color: var(--cream); padding: 48px; border: 2.5px solid var(--ink); max-width: 600px; }
  .pricing-card .m { color: var(--yellow); font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 16px; }
  .pricing-card p { font-size: 17px; line-height: 1.6; opacity: .8; margin-bottom: 28px; }
  .price-figure { font-family: var(--narrow); font-size: 72px; font-weight: 800; line-height: .9; letter-spacing: -.03em; margin-bottom: 24px; }
  .price-figure span { display: block; font-family: var(--mono); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; opacity: .6; margin-top: 14px; }
  .price-disclaimer-text { font-size: 15px !important; line-height: 1.6; opacity: .92 !important; border-left: 4px solid var(--yellow); padding-left: 16px; margin-bottom: 24px !important; }
  .price-disclaimer-text strong { color: var(--yellow); }
  .price-disclaimer-text em { font-style: italic; opacity: .7; font-size: 13px; }
  .hc-supply-note { font-family: var(--mono); font-size: 11px !important; line-height: 1.55; letter-spacing: .02em; opacity: .55 !important; margin-bottom: 24px !important; }
  .price-bridge { font-family: var(--mono); font-size: 11px !important; line-height: 1.55; letter-spacing: .02em; opacity: .7 !important; margin-bottom: 24px !important; }
  .price-bridge a { color: var(--yellow); border-bottom: 1.5px solid currentColor; font-weight: 600; }
  .response-note { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .45; margin-top: 16px; margin-bottom: 0; }

  /* ACTION BLOCK */
  .prod-action { padding: 64px 0 72px; background: var(--cream); border-top: 1.5px solid rgba(11,15,26,.1); }

  /* GUIDE LINKS */
  .prod-guides { padding: 48px 0; background: var(--ink); border-bottom: 1.5px solid rgba(255,255,255,.1); }
  .guides-label { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--yellow); margin-bottom: 20px; }
  .guides-row { display: flex; flex-wrap: wrap; gap: 16px; }
  .guide-link { font-family: var(--narrow); font-size: 17px; font-weight: 600; color: var(--cream); text-decoration: none; border-bottom: 2px solid rgba(255,255,255,.25); padding-bottom: 2px; transition: border-color .15s; }
  .guide-link:hover { border-color: var(--yellow); color: var(--yellow); }

  /* CTA */
  .cta-section { padding: 64px 0 80px; background: var(--cream); }
  .cta-box { background: var(--ink); color: var(--cream); padding: 64px; text-align: center; border: 2.5px solid var(--ink); box-shadow: 12px 12px 0 var(--yellow); }
  .cta-box h2 { font-family: var(--narrow); font-size: 48px; text-transform: uppercase; margin-bottom: 16px; }
  .cta-box p { font-size: 18px; opacity: .8; margin-bottom: 40px; }

  @media (max-width: 768px) {
    .uses-grid { grid-template-columns: 1fr; }
    .cta-box { padding: 40px 24px; }
    .cta-box h2 { font-size: 32px; }
    .pricing-card { padding: 32px 24px; }
  }
</style>
