  /* ============================================================================
     03. DELIVERY DATE AND PLACEMENT, with the clearance figures
     ============================================================================ */
  .deliver-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .dcard { border: 2.5px solid var(--ink); background: var(--cream); padding: 24px; }
  .dcard h3 { font-family: var(--narrow); font-size: 21px; text-transform: uppercase; margin: 0 0 12px; }
  .dcard p { font-size: 15.5px; line-height: 1.6; margin: 0 0 14px; }
