  <!-- 07. FAQ, and the FAQPage schema source for this template. Not an accordion: a collapsed FAQ
       shows nothing in a screenshot and nothing to a skimming reader, and this page's whole thesis
       is that the proof is visible without being asked for. -->
  <section class="prod-faq" id="faq">
    <div class="wrap">
      <div class="band-head"><span class="band-no">07</span><span class="band-kicker">The seven questions buyers actually ask</span></div>
