  .buy-box-rto-cond a { border-bottom: 1.5px solid var(--ink); white-space: nowrap; }

  /* ---- THE DELIVERY BLOCK (left column, under the photo) ---- */
  .prod-aside { border: 2.5px solid var(--ink); background: transparent; margin: 26px 0 0; }
  .qa-head { display: flex; align-items: center; gap: 10px; padding: 9px 13px; border-bottom: 2px solid var(--ink); font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .qa-tag { background: var(--ink); color: var(--yellow); padding: 3px 7px; flex: none; }
  .qa-title { opacity: .72; }
  .qa-body { padding: 0 13px; }
  .qa-item { padding: 19px 0; border-bottom: 1.5px solid rgba(11,15,26,.22); }
  .qa-item:last-child { border-bottom: 0; }
  .qa-k { display: block; font-family: var(--mono); font-size: 10.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; opacity: .62; margin-bottom: 7px; }
  .qa-item p { font-size: 15.5px; line-height: 1.62; margin: 0; }
  .qa-item a { font-weight: 700; border-bottom: 2px solid var(--ink); }
