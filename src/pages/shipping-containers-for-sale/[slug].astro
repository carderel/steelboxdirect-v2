---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CallbackForm from '../../components/CallbackForm.astro';
import { Image } from 'astro:assets';
import { containers } from '../../data/containers';
import type { Container } from '../../data/containers';
import { CONDITION } from '../../data/condition';
import { priceBySlug, formatPrice, asOfLabel, nationalPriceLabel } from '../../data/pricing';
import { RTO_TERMS, RTO_DOWN_CONDITION } from '../../data/rtoTerms';

// THE VISIBLE DATE STAYS AT MONTH PRECISION, and it is a decision rather than an oversight.
//
// The feed now carries day precision, and effectiveSinceLabel in src/data/pricing.ts renders it, so
// the copy below could say in effect since August 18 instead of as of August 2026. Open Question O4 of
// docs/superpowers/specs/2026-08-17-geo-pricing-feed-design.md proposed exactly that and it is
// unanswered, so the weaker claim ships.
//
// It is not only a sign off question. pricing.asOf is ONE date for all three product pages: see
// nationalEffectiveSince in src/data/pricing.ts, which takes the latest effectiveSince across every
// metro and every SKU. On a day the 20ft moves in one metro and the two 40ft figures do not, that one
// date advances for all three pages, so a day precision sentence on the 40ft pages would name a day on
// which their own figure did not move. Month precision absorbs that. Day precision would not.
//
// So making O4 a yes needs a per SKU change date first, meaning a national effective date computed for
// the SKU being rendered, and then the copy change. Doing the copy change alone would publish a
// sharper number that is wrong more often than the blurry one it replaced.

export function getStaticPaths() {
  return containers.map((c) => ({ params: { slug: c.slug }, props: { container: c } }));
}

interface Props { container: Container }
const { container: c } = Astro.props;
const others = containers.filter((x) => x.slug !== c.slug);
const price = priceBySlug[c.slug];
// Clearance plate hidden pending the owner-approved illustration; flip to re-enable.
const SHOW_CLEARANCE_PLATE = false;

// Maps each product slug to the quote form's size_preference select value, which the
// quote page already reads from /quote/?size= (see the sizeMap in src/pages/quote/index.astro).
// Keep in sync with the <option> values there and SIZE_LABELS in src/pages/api/submit-quote.ts.
function sizeParamFor(slug: string): string {
  const map: Record<string, string> = {
    '20-foot-shipping-container': '20ft',
    '40-foot-shipping-container': '40ft',
    '40-foot-high-cube-container': '40ft_hc',
  };
  return map[slug] ?? '';
}
const sizeParam = sizeParamFor(c.slug);

// ONE comparison data source: the desktop table and the mobile cards both map over
// compareRows, so the two presentations cannot diverge. Best-for cells drop the shared
// CONDITION.blurb tail that containers.ts appends to every compareNote; the condition
// is stated once in the line above the comparison instead of repeating per column.
function comparisonColumn(pick: (x: Container) => string): Record<string, string> {
  const values: Record<string, string> = {};
  for (const x of containers) values[x.slug] = pick(x);
  return values;
}
const compareRows: { label: string; values: Record<string, string> }[] = [
  { label: 'External', values: comparisonColumn((x) => x.specs.externalDims) },
  { label: 'Internal', values: comparisonColumn((x) => x.specs.internalDims) },
  { label: 'Capacity', values: comparisonColumn((x) => x.specs.cubicCap) },
  { label: 'Best for', values: comparisonColumn((x) => x.compareNote.replace(CONDITION.blurb, '').trim()) },
];
// Mobile cards lead with the container this page sells.
const compareOrder = [c, ...others];

// FIG. D1 delivery clearance plate. Every number on the plate traces to a published
// source and NOTHING is estimated (spec: omit rather than estimate):
//   - 65 ft truck combination, 100+ ft straight approach (tilt bed), 14 ft overhead,
//     12 ft wide path, 30,000 lb ground: all published on src/pages/delivery/index.astro.
//   - Container length and height: c.specs.externalDims (containers.ts).
// The delivery page's "60 feet average truck length" sidebar stat is deliberately NOT
// drawn: the 65 ft combination is the maneuvering requirement, and two rig figures on
// one plate would read as a contradiction. The tractor, tilt deck, wheels, driveway
// shading, and destination garage are illustration only; no dimension line touches
// any of them.
// Geometry: 9 px per foot inside the 960-wide viewBox. Ground datum at y=184, so the
// 14 ft overhead limit sits at y=58 (184 minus 14*9) and the tilt deck carries the
// container at y=150. The rig spans x=64..649 (585 px = 65 ft to scale). Container
// length and height are the only per-page variables; both scale off c.specs.externalDims.
const PX_PER_FT = 9;
const DECK_TOP = 150; // tilt deck surface the container rides on (illustration height)
const lengthFt = parseInt(c.specs.externalDims, 10); // "20' L × ..." -> 20
const contLenPx = lengthFt * PX_PER_FT;
const contX1 = 645; // container rear sits at the rear of the tilt deck
const contX0 = contX1 - contLenPx;
const contH = Math.round((c.specs.externalDims.includes("9'6") ? 9.5 : 8.5) * PX_PER_FT); // 9'6" HC vs 8'6" std, to scale
const contTop = DECK_TOP - contH;
const contMidY = contTop + contH / 2;
const lenChipW = 62;
const lenChipX = (contX0 + contX1) / 2 - lenChipW / 2;
const lenChipMidX = (contX0 + contX1) / 2;
const plateTitle = `Delivery clearance for the ${c.shortName}: the rig and the room it needs`;
const plateAria = `Side profile of a tilt bed delivery truck carrying a ${c.shortName} container toward a garage: a 65 foot truck and tilt bed combination, a ${lengthFt} foot container riding on the deck, 14 feet of overhead clearance under wires and branches, 100 or more feet of straight approach, a 12 foot wide path, and ground that holds a 30,000 pound truck`;
---

<BaseLayout title={c.seo.title} description={c.seo.description} pageType="product"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Shipping Containers for Sale', path: '/shipping-containers-for-sale/' }, { name: c.name }]}
  schema={{ kind: 'product', container: c, price,
    specs: [
      { k: 'Exterior', v: c.specs.externalDims },
      { k: 'Interior', v: c.specs.internalDims },
      { k: 'Door opening', v: c.specs.doorOpening },
      { k: 'Cubic capacity', v: c.specs.cubicCap },
      { k: 'Condition', v: 'Wind & Water Tight (used)' },
      { k: 'Warranty', v: 'Lifetime Leak' },
      ...(price ? [{ k: nationalPriceLabel, v: formatPrice(price.price) }] : []),
    ] }}>

  <!-- LISTING HERO (owner brief 2026-08-25): one dense Amazon-style module instead of a
       scattered stack. Desktop is photo left, decision column right. Mobile keeps the
       owner's exact order via DOM order alone: H1 + chips, photo, bullets, buy box.
       The four bullets are the old confidence strip minus its price line; the price
       moved into the buy box so it is stated once, disclaimer adjacent, all from
       src/data/pricing.ts. The /condition/ link swaps to the T-170 wear guide when
       that page ships. The interim photo is a real 40ft, captioned as such in
       containers.ts, shared by all three pages until per-size yard photos land. -->
  <section class="prod-hero">
    <div class="wrap">
      <div class="breadcrumb-nav">
        <a href="/shipping-containers-for-sale/">Shipping Containers for Sale</a>
        <span>›</span>
        <span>{c.name}</span>
      </div>
      <div class="listing">
        <h1 class="listing-h1">{c.name}</h1>
        <div class="key-specs">
          {c.keySpecs.map((s) => <span class="spec-chip">{s}</span>)}
        </div>
        {c.heroPhoto && (
          <figure class="listing-media">
            <div class="listing-frame">
              <Image src={c.heroPhoto.src} alt={c.heroPhoto.alt} width={960} format="webp" loading="eager" fetchpriority="high" />
            </div>
            {c.heroPhoto.caption && <figcaption class="listing-caption">{c.heroPhoto.caption}</figcaption>}
          </figure>
        )}
        <div class="listing-body">
          <p class="listing-lede">{c.tagline}</p>
          <ul class="listing-bullets" aria-label="Why buyers trust this container">
            <li><strong>Wind &amp; Water Tight (used).</strong> Honest cosmetic wear. <a href="/condition/">What that means</a></li>
            <li><strong>Lifetime Leak Warranty</strong> on every container</li>
            <li>Delivered across <strong>Ohio, Indiana, Kentucky + western West Virginia</strong> <em class="buy-bullet-note">Outside the home region? We deliver nationwide from depot hubs.</em></li>
            <li>Quotes answered within <strong>4 business hours</strong></li>
          </ul>
          {price && (
            <div class="buy-box">
              <p class="buy-box-label">{nationalPriceLabel}</p>
              <p class="buy-box-price">{formatPrice(price.price)}</p>
              <p class="buy-box-disclaimer">Average starting price, not a quote; yours may be more or less. Your ZIP code is a big factor in the delivered price, so for the most accurate number, talk directly to Doug. ({asOfLabel})</p>
              {c.slug === '40-foot-high-cube-container' && (
                <p class="buy-box-note">Supply runs deep right now, so the High Cube average can land below the standard 40ft.</p>
              )}
              <div class="buy-box-ctas">
                <a href="#talk-to-doug" class="btn buy-btn-primary">Have Doug call me <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
                <a href={'/quote/?size=' + sizeParam} class="btn buy-btn-secondary">Build my full quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
              </div>
              <!-- RENT TO OWN. Placed BELOW the two primary CTAs rather than directly under
                   .buy-box-disclaimer, for two reasons. The .buy-box-note negative top margin is
                   coupled to the disclaimer and only the High Cube renders it, so an insert between
                   the two breaks that page's spacing alone, which is the kind of regression nobody
                   sees. And the monthly path is the secondary route: it belongs after the buyer has
                   been offered the call and the quote, not in front of them.
                   The figure and its condition render in ONE block. That is the whole rule: the
                   headline states an offer, the line under it states what makes the offer true, and
                   neither may ship without the other. Both come from src/data/rtoTerms.ts, so
                   nothing here is typed, and src/lib/compliance/rto-terms-guard.test.ts fails the
                   suite if a later edit types the figure in. -->
              <div class="buy-box-rto">
                <p class="buy-box-rto-offer">
                  Not ready to pay it all at once? Rent to own from <strong>{RTO_TERMS.downPayment} down</strong>.
                </p>
                <p class="buy-box-rto-cond">
                  {RTO_DOWN_CONDITION} Administered by {RTO_TERMS.provider}, an independent third
                  party, and subject to their approval.
                  <a href="/rent-to-own/#down-payment">How rent to own works</a>
                </p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING: slimmed 2026-08-25. The big average figure moved into the hero buy box,
       so repeating it here was noise; this section keeps the one job the buy box cannot
       do, the delivered-price-by-ZIP pitch and its /locations/ bridge. No dollar figure
       renders here, so no disclaimer is needed here; the JSON-LD Product offer and the
       QuickFacts price bind through the schema prop above and are unchanged. -->
  <section class="prod-pricing">
    <div class="wrap">
      <h2 class="section-title">Used {c.shortName} Shipping Container for Sale</h2>
      <div class="pricing-card">
        <h3 class="m" style="margin-top: 0;">What a {c.shortName} actually costs you</h3>
        <p class="price-pitch">The average above is a national figure, not your number. What you pay rides mostly on how far we deliver and current market supply, so prices vary by metro, and we publish a dated delivered figure for each one we serve: <a href="/locations/">see the delivered price in your city</a>.</p>
        <a href="/quote/" class="btn">Get a Current Quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
        <p class="response-note">Most requests answered within 4 business hours.</p>
      </div>
    </div>
  </section>

  <!-- ACTION BLOCK: Doug callback or preselected full quote. The id is the hero
       buy box's "Have Doug call me" anchor target. -->
  <section class="prod-action" id="talk-to-doug">
    <div class="wrap">
      <CallbackForm sizeLabel={c.shortName} sizePreference={sizeParam} />
    </div>
  </section>

  <!-- SPECS TABLE -->
  <section class="prod-specs">
    <div class="wrap">
      <h2 class="section-title">Specifications</h2>
      <div class="specs-card">
        <table class="specs-table">
          <tbody>
            <tr><th>External Dimensions</th><td>{c.specs.externalDims}</td></tr>
            <tr><th>Internal Dimensions</th><td>{c.specs.internalDims}</td></tr>
            <tr><th>Door Opening</th><td>{c.specs.doorOpening}</td></tr>
            <tr><th>Payload Capacity</th><td>{c.specs.payload}</td></tr>
            <tr><th>Tare Weight</th><td>{c.specs.tare}</td></tr>
            <tr><th>Cubic Capacity</th><td>{c.specs.cubicCap}</td></tr>
          </tbody>
        </table>
      </div>
        <p class="spec-ref-link">
          Full ISO 668 dimensions for every size are in our
          <a href="/container-reference/#dimensions">Container Reference</a>.
        </p>
    </div>
  </section>

  <!-- SIZE COMPARE -->
  <section class="prod-compare">
    <div class="wrap">
      <h2 class="section-title">How It Compares</h2>
      <p class="compare-condition">All three sizes are {CONDITION.blurb}</p>
      <div class="compare-desktop">
        <div class="compare-card">
          <table class="compare-table">
            <thead>
              <tr>
                <th></th>
                {containers.map((x) => (
                  <th class={x.slug === c.slug ? 'current-col' : ''}>
                    {x.slug === c.slug
                      ? <span>{x.shortName}</span>
                      : <a href={`/shipping-containers-for-sale/${x.slug}/`}>{x.shortName}</a>
                    }
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {compareRows.map((row) => (
                <tr>
                  <th>{row.label}</th>
                  {containers.map((x) => <td class={x.slug === c.slug ? 'current-col' : ''}>{row.values[x.slug]}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="compare-cards">
        {compareOrder.map((x) => (
          <article class={'compare-mcard' + (x.slug === c.slug ? ' is-current' : '')}>
            <header class="compare-mcard-head">
              {x.slug === c.slug
                ? <span class="compare-mcard-name">{x.shortName}</span>
                : <a class="compare-mcard-name" href={`/shipping-containers-for-sale/${x.slug}/`}>{x.shortName}</a>
              }
              {x.slug === c.slug && <span class="compare-mcard-badge">This page</span>}
            </header>
            <dl class="compare-mcard-list">
              {compareRows.map((row) => (
                <div class="compare-mcard-row">
                  <dt>{row.label}</dt>
                  <dd>{row.values[x.slug]}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLEARANCE SECTION HIDDEN 2026-08-26 per owner: plate v1 and v2 rejected. It returns
       when the owner's Gemini illustration lands with code-overlaid dimensions. Prompts:
       UDO Project/.outputs/image-prompts/2026-08-26-clearance-plate-prompts.md -->
  {SHOW_CLEARANCE_PLATE && (
  <section class="prod-clearance">
    <div class="wrap">
      <h2 class="section-title">Will It Fit Down Your Driveway?</h2>
      <figure class="clr-fig">
        <div class="clr-fig-head" aria-hidden="true"><span class="clr-fig-no">FIG. D1</span><span class="clr-fig-title">Delivery clearance · {c.shortName}</span></div>
        <div class="clr-fig-scroll" role="region" aria-label={`Delivery clearance drawing for the ${c.shortName}, scrolls sideways on small screens`} tabindex="0">
        <svg viewBox="0 0 960 284" role="img" aria-label={plateAria}>
          <title>{plateTitle}</title>
          <defs>
            <pattern id="clrfig-corr" width="11" height="10" patternUnits="userSpaceOnUse">
              <path d="M3.5 0 V10 M7 0 V10" stroke="#0B0F1A" stroke-width="1" opacity=".22" fill="none"></path>
            </pattern>
            <pattern id="clrfig-hatch" width="7" height="7" patternUnits="userSpaceOnUse">
              <path d="M-1 8 L8 -1" stroke="#0B0F1A" stroke-width="1" opacity=".3" fill="none"></path>
            </pattern>
          </defs>
          <!-- 14 ft overhead limit: dashed ceiling, dimensioned at the right edge with
               extension lines off the ceiling and the ground datum -->
          <text x="28" y="46" font-size="13" opacity=".65">OVERHEAD LIMIT · WIRES + BRANCHES</text>
          <line x1="28" y1="58" x2="876" y2="58" stroke="currentColor" stroke-width="1.25" stroke-dasharray="7 5" opacity=".8"></line>
          <line x1="888" y1="58" x2="944" y2="58" stroke="currentColor" stroke-width="1" opacity=".7"></line>
          <line x1="888" y1="184" x2="944" y2="184" stroke="currentColor" stroke-width="1" opacity=".7"></line>
          <line x1="930" y1="58" x2="930" y2="184" stroke="currentColor" stroke-width="1"></line>
          <line x1="926" y1="62" x2="934" y2="54" stroke="currentColor" stroke-width="1.25"></line>
          <line x1="926" y1="188" x2="934" y2="180" stroke="currentColor" stroke-width="1.25"></line>
          <rect x="904" y="109" width="52" height="24" fill="var(--cream)" stroke="currentColor" stroke-width="1"></rect>
          <text x="930" y="126" font-size="15" font-weight="700" text-anchor="middle">14 FT</text>
          <!-- Ground: solid datum with driveway shading band -->
          <rect x="28" y="184" width="856" height="12" fill="url(#clrfig-hatch)"></rect>
          <line x1="28" y1="196" x2="884" y2="196" stroke="currentColor" stroke-width="1" opacity=".35"></line>
          <line x1="28" y1="184" x2="884" y2="184" stroke="currentColor" stroke-width="2"></line>
          <!-- Destination garage at the right edge: outline only, no dimension attached -->
          <path d="M700 184 V116 L758 76 L816 116 V184" fill="#fff" stroke="currentColor" stroke-width="2.5"></path>
          <rect x="722" y="122" width="72" height="62" fill="none" stroke="currentColor" stroke-width="1.25"></rect>
          <line x1="722" y1="137.5" x2="794" y2="137.5" stroke="currentColor" stroke-width="1" opacity=".5"></line>
          <line x1="722" y1="153" x2="794" y2="153" stroke="currentColor" stroke-width="1" opacity=".5"></line>
          <line x1="722" y1="168.5" x2="794" y2="168.5" stroke="currentColor" stroke-width="1" opacity=".5"></line>
          <!-- The rig, illustration only: wheels first so the frame, cab, and deck tuck
               over them; steer axle + drive tandem on the tractor, tandem on the tilt bed -->
          <circle cx="94" cy="169" r="15" fill="#fff" stroke="currentColor" stroke-width="2.5"></circle>
          <circle cx="94" cy="169" r="4.5" fill="currentColor"></circle>
          <circle cx="170" cy="169" r="15" fill="#fff" stroke="currentColor" stroke-width="2.5"></circle>
          <circle cx="170" cy="169" r="4.5" fill="currentColor"></circle>
          <circle cx="204" cy="169" r="15" fill="#fff" stroke="currentColor" stroke-width="2.5"></circle>
          <circle cx="204" cy="169" r="4.5" fill="currentColor"></circle>
          <circle cx="584" cy="169" r="15" fill="#fff" stroke="currentColor" stroke-width="2.5"></circle>
          <circle cx="584" cy="169" r="4.5" fill="currentColor"></circle>
          <circle cx="618" cy="169" r="15" fill="#fff" stroke="currentColor" stroke-width="2.5"></circle>
          <circle cx="618" cy="169" r="4.5" fill="currentColor"></circle>
          <rect x="64" y="156" width="172" height="6" fill="currentColor"></rect>
          <path d="M64 156 V131 L72 123 H104 L118 97 H154 V156 Z" fill="var(--cream)" stroke="currentColor" stroke-width="2.5"></path>
          <path d="M119 101 L108 121 H130 V101 Z" fill="currentColor"></path>
          <rect x="135" y="101" width="14" height="19" fill="currentColor"></rect>
          <line x1="131" y1="100" x2="131" y2="152" stroke="currentColor" stroke-width="1" opacity=".55"></line>
          <rect x="157" y="108" width="5" height="48" fill="currentColor"></rect>
          <rect x="196" y={DECK_TOP} width="453" height="11" fill="var(--cream)" stroke="currentColor" stroke-width="2.5"></rect>
          <line x1="200" y1={DECK_TOP + 5.5} x2="645" y2={DECK_TOP + 5.5} stroke="currentColor" stroke-width="1" opacity=".3"></line>
          <circle cx="641" cy="164" r="3.5" fill="currentColor"></circle>
          <!-- The container, to scale, with corrugation and corner castings -->
          <rect x={contX0} y={contTop} width={contLenPx} height={contH} fill="var(--yellow)" stroke="currentColor" stroke-width="2.5"></rect>
          <rect x={contX0 + 2} y={contTop + 2} width={contLenPx - 4} height={contH - 4} fill="url(#clrfig-corr)"></rect>
          <rect x={contX0 + 2} y={contTop + 2} width="7" height="7" fill="currentColor"></rect>
          <rect x={contX1 - 9} y={contTop + 2} width="7" height="7" fill="currentColor"></rect>
          <rect x={contX0 + 2} y={contTop + contH - 9} width="7" height="7" fill="currentColor"></rect>
          <rect x={contX1 - 9} y={contTop + contH - 9} width="7" height="7" fill="currentColor"></rect>
          <!-- Container length dimension (from c.specs.externalDims) -->
          <line x1={contX0 + 2} y1={contMidY} x2={contX1 - 2} y2={contMidY} stroke="currentColor" stroke-width="1"></line>
          <line x1={contX0 - 4} y1={contMidY + 4} x2={contX0 + 4} y2={contMidY - 4} stroke="currentColor" stroke-width="1.25"></line>
          <line x1={contX1 - 4} y1={contMidY + 4} x2={contX1 + 4} y2={contMidY - 4} stroke="currentColor" stroke-width="1.25"></line>
          <rect x={lenChipX} y={contMidY - 12} width={lenChipW} height="24" fill="var(--cream)" stroke="currentColor" stroke-width="1"></rect>
          <text x={lenChipMidX} y={contMidY + 5} font-size="15" font-weight="700" text-anchor="middle">{lengthFt} FT</text>
          <!-- 65 ft truck combination: extension lines drop from the rig extremes -->
          <line x1="64" y1="200" x2="64" y2="228" stroke="currentColor" stroke-width="1" opacity=".7"></line>
          <line x1="649" y1="200" x2="649" y2="228" stroke="currentColor" stroke-width="1" opacity=".7"></line>
          <line x1="64" y1="222" x2="649" y2="222" stroke="currentColor" stroke-width="1"></line>
          <line x1="60" y1="226" x2="68" y2="218" stroke="currentColor" stroke-width="1.25"></line>
          <line x1="645" y1="226" x2="653" y2="218" stroke="currentColor" stroke-width="1.25"></line>
          <rect x="198" y="210" width="317" height="24" fill="var(--cream)" stroke="currentColor" stroke-width="1"></rect>
          <text x="356.5" y="227" text-anchor="middle"><tspan font-size="15" font-weight="700">65 FT</tspan><tspan dx="10" font-size="13" opacity=".65">TRUCK + TILT BED COMBINATION</tspan></text>
          <!-- 100+ ft straight approach on its own datum; the break symbol shows it
               running past the drawing -->
          <line x1="28" y1="266" x2="944" y2="266" stroke="currentColor" stroke-width="1"></line>
          <line x1="24" y1="270" x2="32" y2="262" stroke="currentColor" stroke-width="1.25"></line>
          <line x1="940" y1="270" x2="948" y2="262" stroke="currentColor" stroke-width="1.25"></line>
          <rect x="848" y="257" width="18" height="18" fill="#fff"></rect>
          <path d="M849 271 l6 -7 l6 14 l6 -7" fill="none" stroke="currentColor" stroke-width="1.25"></path>
          <rect x="232" y="254" width="336" height="24" fill="var(--cream)" stroke="currentColor" stroke-width="1"></rect>
          <text x="400" y="271" text-anchor="middle"><tspan font-size="15" font-weight="700">100+ FT</tspan><tspan dx="10" font-size="13" opacity=".65">STRAIGHT APPROACH FOR TILT BED</tspan></text>
        </svg>
        </div>
        <div class="clr-fig-foot">
          <span class="clr-fig-foot-tag">SITE CHECK</span>
