  .qa-foot-k { display: inline-block; background: var(--yellow); color: var(--ink); padding: 2px 7px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; margin-right: 6px; }
  .qa-foot a { color: var(--yellow); border-bottom: 1.5px solid var(--yellow); font-weight: 700; white-space: nowrap; }

  /* ---- THE DIMENSIONS BLOCK (right column, under the buy box) ----
     Same reference grammar as the delivery block opposite: 2.5px ink edge, the head's
     yellow ground showing through, no drop shadow, no button. The only thing allowed to
     shout is the numbers, which is why the L/W/H strings are broken out of their sentences
     into aligned tabular columns: the point of the row is that a buyer can read 8' against
     7'8" straight down. */
  .dims { border: 2.5px solid var(--ink); background: transparent; max-width: 480px; margin: 26px 0 0; }
  .dims-head { display: flex; align-items: center; gap: 10px; padding: 9px 13px; border-bottom: 2px solid var(--ink); font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .dims-tag { background: var(--ink); color: var(--yellow); padding: 3px 7px; flex: none; }
  .dims-title { opacity: .72; }
  .dims-tbl { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; table-layout: fixed; }
  .dims-tbl thead th { font-family: var(--mono); font-size: 9.5px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; opacity: .5; text-align: right; padding: 7px 10px 0; }
  .dims-tbl thead th:last-child { padding-right: 13px; }
  .dims-tbl tbody tr { border-top: 1.5px solid rgba(11,15,26,.22); }
  .dims-rowlab { text-align: left; padding: 10px 8px 10px 13px; font-weight: 400; width: 41%; }
  .dims-rowlab b { display: block; font-family: var(--mono); font-size: 10.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; opacity: .7; }
  .dims-rowlab span { display: block; font-size: 11.5px; line-height: 1.35; opacity: .58; margin-top: 4px; }
  .dims-tbl td { text-align: right; padding: 10px; font-family: var(--narrow); font-size: 26px; font-weight: 700; line-height: 1; letter-spacing: -.015em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dims-tbl td:last-child { padding-right: 13px; }
  .dims-na { opacity: .26; font-weight: 400; }
  .dims-foot { display: flex; border-top: 2px solid var(--ink); }
  .dims-fig { flex: 1 1 0; min-width: 0; padding: 9px 12px; border-left: 1.5px solid rgba(11,15,26,.22); font-variant-numeric: tabular-nums; }
  .dims-fig:first-child { border-left: 0; }
  .dims-fig-k { display: block; font-family: var(--mono); font-size: 9.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; opacity: .58; margin-bottom: 5px; white-space: nowrap; }
  .dims-fig-v { display: block; font-family: var(--narrow); font-size: 20px; font-weight: 700; line-height: 1; letter-spacing: -.015em; white-space: nowrap; }
  .dims-fig-v i { font-style: normal; font-family: var(--mono); font-size: 9.5px; font-weight: 500; letter-spacing: .05em; opacity: .6; margin-left: 4px; text-transform: uppercase; }
  /* The jump is the same dark closing bar the delivery block uses, so it reads as this
     block's footer rather than as another call to action. */
  .dims-jump { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 13px; border-top: 2px solid var(--ink); background: var(--ink); color: var(--cream); font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; transition: background .15s, color .15s; }
  .dims-jump span { color: var(--yellow); flex: none; }
  .dims-jump:hover, .dims-jump:focus-visible { background: var(--yellow); color: var(--ink); }
  .dims-jump:hover span, .dims-jump:focus-visible span { color: var(--ink); }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (min-width: 961px) {
    .listing { grid-template-columns: minmax(0, 45fr) minmax(0, 55fr); grid-template-rows: auto auto 1fr; grid-template-areas: "media h1" "media body" "aside body"; column-gap: 52px; }
    .listing-h1 { grid-area: h1; }
    .listing-media { grid-area: media; align-self: start; margin: 6px 0 0; }
    .listing-body { grid-area: body; align-self: start; }
    /* The aside is last in the DOM so a phone gets it below the price rather than above it;
       on desktop the grid lifts it back under the photo. The extra top margin is spacing,
       not stretching: the block is set to the size its content wants and the column gap that
       remains under it is deliberate. */
    .prod-aside { grid-area: aside; align-self: start; margin: 50px 0 0; }
  }

  /* Smooth travel for the in-page anchors, and enough scroll margin that the sticky header
     never lands on a section head. Page-scoped stylesheet, so the rule ships only with this
     template. */
  :global(html) { scroll-behavior: smooth; }
  #act-one, #act-two, #act-three, #size-compare, #condition,
  #delivery-date, #clearance, #talk-to-doug, #real-company, #faq { scroll-margin-top: 80px; }

  /* ============================================================================
     ACT MARKERS. Not a new device: the .band-head grammar promoted to full width
     and set on its own yellow, so a chapter break is the only place on the page
     where the ink rule doubles up. The 5px top rule lands against the 2.5px
     bottom rule of whatever ended the previous act, which makes it the heaviest
     horizontal line in the document.
     ============================================================================ */
  .act { background: var(--yellow); border-top: 5px solid var(--ink); border-bottom: 2.5px solid var(--ink); padding: 22px 0 20px; }
  .act-row { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .act-no { font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; background: var(--ink); color: var(--yellow); padding: 5px 9px; flex: none; }
  .act-title { font-family: var(--narrow); font-size: clamp(25px, 3.4vw, 34px); font-weight: 800; text-transform: uppercase; letter-spacing: -.015em; line-height: 1; margin: 0; }
  .act-sub { font-family: var(--mono); font-size: 11.5px; line-height: 1.75; max-width: 780px; margin: 11px 0 0; opacity: .72; }
  /* Act one lands on the 3D viewer's dark slab. An ink bar over a dark band is not a
     boundary, which is the whole reason the act bands are yellow, so the heaviest line in
     the document is drawn in cream in the one place it would otherwise disappear. */
  .prod-3d + .act { border-top-color: var(--cream); }

  /* ============================================================================
     BAND CHROME. Each numbered section carries the same head, so the page reads
     as an ordered argument rather than a pile of sections.
     ============================================================================ */
  .section-title { font-family: var(--narrow); font-size: clamp(26px, 4vw, 36px); text-transform: uppercase; margin: 0 0 26px; font-weight: 800; letter-spacing: -.01em; line-height: 1.05; }
  .band { padding: 64px 0; border-bottom: 2.5px solid var(--ink); }
  .band-ink { background: var(--ink); color: var(--cream); }
  .band-cream { background: var(--cream); }
  .band-white { background: white; }
  .band-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 8px; flex-wrap: wrap; }
  .band-no { font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .14em; background: var(--ink); color: var(--yellow); padding: 5px 9px; }
  .band-ink .band-no { background: var(--yellow); color: var(--ink); }
  .band-kicker { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; opacity: .55; }
  .band-lede { font-size: 17px; line-height: 1.6; max-width: 720px; margin: 0 0 30px; opacity: .85; }
  .band-ink .section-title { color: var(--cream); }

  /* ============================================================================
     01. SPECIFICATIONS AND COMPARE, MERGED
     ============================================================================ */
  .prod-specs { padding: 64px 0; background: white; border-bottom: 2.5px solid var(--ink); }
  .prod-specs .band-head { margin-bottom: 10px; }
  .cmp-note { font-family: var(--mono); font-size: 12px; line-height: 1.6; opacity: .75; max-width: 700px; margin: -12px 0 24px; }
  .cmp-scroll { overflow-x: auto; border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: var(--cream); }
  .cmp { width: 100%; border-collapse: collapse; min-width: 640px; }
  .cmp th, .cmp td { padding: 14px 18px; text-align: left; border-bottom: 1.5px solid rgba(11,15,26,.12); font-size: 14.5px; }
  .cmp thead th { font-family: var(--narrow); font-size: 18px; font-weight: 700; text-transform: uppercase; background: var(--cream); }
  .cmp tbody th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; opacity: .55; font-weight: 500; background: var(--cream); width: 20%; }
  .cmp tr:last-child td, .cmp tr:last-child th { border-bottom: none; }
  .cur { background: var(--ink); color: var(--yellow); }
  /* The header cell needs its own rule, and this is a real fix rather than a duplicate.
     `.cmp thead th` and `.cmp tbody th` are two classes and two elements deep, so they outrank
     the single class on `.cur` and win the background. The current column's HEAD therefore
     inherited .cur's yellow text on the header's cream ground, which is yellow on cream: the
     page's worst contrast pairing, on the one cell that tells a reader which column is theirs.
     The old prod-compare table shipped the same collision and the mockup inherited it. */
  .cmp thead th.cur, .cmp tbody th.cur { background: var(--ink); color: var(--yellow); }
  .cur a { color: var(--yellow); }
  .cmp a { text-decoration: underline; text-underline-offset: 3px; }
  .spec-ref-link { margin-top: 20px; font-size: 15px; opacity: .85; }
