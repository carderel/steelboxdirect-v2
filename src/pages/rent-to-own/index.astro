---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { composeRentalStance } from '../../data/rentalStance';
import { RTO_TERMS, RTO_DOWN_CONDITION, rtoEffectiveDateLabel } from '../../data/rtoTerms';
import imgHero from '../../assets/photos/rent-to-own/rent-to-own-shipping-container-home-gravel-pad-hero.jpg';
import imgApplication from '../../assets/photos/rent-to-own/rent-to-own-conex-application-kitchen-table.jpg';
import imgSeasons from '../../assets/photos/rent-to-own/rent-to-own-shipping-container-through-seasons.jpg';
import imgPainting from '../../assets/photos/rent-to-own/rent-to-own-container-owner-painting-customizing.jpg';
import imgLocking from '../../assets/photos/rent-to-own/rent-to-own-shipping-container-owner-locking-doors.jpg';
import imgComparison from '../../assets/photos/rent-to-own/rent-to-own-container-vs-self-storage-comparison.jpg';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Rent to Own', path: '/rent-to-own/' }];

// Single source of truth: this array feeds BOTH the visible FAQ list below
// and the FAQPage JSON-LD (via the schema prop → buildPageSchema).
const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: "What's the difference between renting and rent-to-own?",
    ...composeRentalStance({
      linkRentToOwn: false,
      context:
        'Renting is open ended: you pay every month for as long as you keep the container, and '
        + 'when you stop paying, it goes back on a truck and you keep nothing. Rent-to-own has a '
        + 'finish line built into it. Pick 12, 24, 36, or 48 months, complete the term, and the '
        + 'same Wind & Water Tight container with the same Lifetime Leak Warranty is yours. If '
        + 'your need has an end date on it, renting from somebody else may be the better fit, and '
        + 'we list the rental companies we could verify in this region.',
      contextHtml:
        'Renting is open ended: you pay every month for as long as you keep the container, and '
        + 'when you stop paying, it goes back on a truck and you keep nothing. Rent-to-own has a '
        + 'finish line built into it. Pick 12, 24, 36, or 48 months, complete the term, and the '
        + 'same Wind &amp; Water Tight container with the same Lifetime Leak Warranty is yours. If '
        + 'your need has an end date on it, renting from somebody else may be the better fit, and '
        + 'we list <a href="/container-rental-guide/">the rental companies we could verify</a> in '
        + 'this region.',
    }),
  },
  {
    q: 'Is approval guaranteed?',
    a: "No. Approval decisions are made by an independent third party that administers the program and the final decision is theirs, independent of Steel Box Direct. There is no traditional credit check, but every application is reviewed, and we can't promise an outcome. What we can promise: we'll get your quote and your application in front of them fast, and keep you posted.",
  },
  {
    q: 'Who is the third party application administrator?',
    a: "We currently use My Container Rental as the independent third party that administers the rent-to-own program. They review applications, make the approval decisions, and service the rent-to-own agreement. Steel Box Direct handles your quote and your delivery; My Container Rental handles the program itself.",
  },
  {
    q: 'Do my payments build toward ownership?',
    a: "Yes, that's the point of rent-to-own, the same arrangement you'll also hear called lease to own or rent to buy. Complete your chosen term (12, 24, 36, or 48 months) and the container belongs to you. Unlike self-storage rent, the payments aren't money out the window; they're steps toward owning a steel asset that sits on your property.",
  },
  {
    q: 'What condition are rent-to-own containers?',
    a: "The same single grade as every container we sell: Wind & Water Tight (used), which means structurally sound and weather-tight, with surface rust that's purely cosmetic. The Lifetime Leak Warranty applies to rent-to-own units just like purchased ones.",
  },
  {
    q: 'How fast is delivery on a rent-to-own container?',
    a: "For rent-to-own, delivery is scheduled after your application is approved by the independent third party that administers the program. From there it works like any other order: almost all deliveries take about two weeks, and we'll give you an honest window before you commit. Then you'll hear from us at every step until it's on your property.",
  },
  // Composed from src/data/rtoTerms.ts, never typed, because this answer carries a dollar figure.
  // Written to stand on its own with no pronoun pointing back at the page: it feeds the FAQPage
  // JSON-LD, and an answer engine lifts it out of the page and shows it with no page around it.
  {
    q: 'How much is the down payment on a rent-to-own shipping container?',
    a: `As of ${rtoEffectiveDateLabel()}, ${RTO_TERMS.provider} sets the rent-to-own down payment `
      + `at ${RTO_TERMS.downPayment} on standard containers delivered within `
      + `${RTO_TERMS.distanceLimitMiles} miles of the depot the container ships from. Beyond that `
      + `distance the down payment is ${RTO_TERMS.remoteDownPayment}. Modified and specialty units `
      + `also require ${RTO_TERMS.remoteDownPayment}, though Steel Box Direct sells only standard `
      + 'containers. Rent-to-own is administered by an independent third party and remains subject '
      + 'to their approval.',
  },
];
---

<BaseLayout
  pageType="guide"
  title="Rent to Own Shipping Containers in Ohio, Indiana & Kentucky | Steel Box Direct"
  description="Rent to own a shipping container over 12, 24, 36, or 48 months. Fixed monthly payments, delivery included in your quote, and the container is yours at the end of the term. No traditional credit check; every application is reviewed by an independent administrator. Serving OH, IN & KY."
  datePublished="2026-07-30"
  dateModified="2026-07-30"
  breadcrumbs={crumbs}
  schema={{ kind: 'useCase', audience: 'rent-to-own container buyers',
    title: 'Rent-to-Own Shipping Containers',
    serviceType: 'Rent-to-own shipping container program',
    areaServed: ['Ohio', 'Indiana', 'Kentucky'],
    specs: [
      { k: 'Terms', v: '12 / 24 / 36 / 48 months' },
      { k: 'Credit', v: 'No traditional credit check' },
      { k: 'Warranty', v: 'Lifetime Leak, applies to RTO' },
      { k: 'Delivery', v: 'About two weeks after approval' },
    ],
    faqs: faqs.map((f) => ({ q: f.q, a: f.a })) }}
>
  <!-- 1. HERO -->
  <div class="rto-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="sh rto-eyebrow">
        <span class="idx">§ RTO</span>
        <span class="nm">Decision: Ownership Path</span>
        <span class="tg">Program Guide</span>
      </div>
      <h1 class="big rto-headline">Rent to Own.<br><em>No Traditional Credit&nbsp;Check.</em></h1>
      <p class="rto-lede">
        Own a Wind &amp; Water Tight container over 12, 24, 36, or 48 months through our rent-to-own
        shipping containers program, sometimes called lease to own or rent to buy. Fixed monthly
        payments, delivery included in your quote, and when the last payment clears the container is
        yours.
      </p>
      <figure class="rto-fig rto-hero-fig" data-img-slot="hero">
        <Image class="rto-fig-img" src={imgHero} width={1800} format="webp" loading="eager"
          alt="Used wind and water tight shipping container settled on a gravel pad beside a rural workshop at evening, kept as the owner's own storage" />
        <figcaption class="rto-fig-tag m">Photo · A used Wind &amp; Water Tight container on its own gravel pad</figcaption>
      </figure>
    </div>
  </div>

  <!-- 2. HOW IT WORKS -->
  <section class="rto-how">
    <div class="wrap">
      <div class="rto-sh">
        <span class="m">How It Works</span>
        <h2 class="rto-h2">Four steps to a container on your property</h2>
      </div>
      <div class="rto-step-grid">
        <div class="step-card" style="border-left-color: var(--yellow-d);">
          <span class="step-num m">Step 01</span>
          <h3>Get your quote from Steel Box Direct</h3>
          <p>Tell us your size and delivery zip. You get one all-in delivered number, and you tell us you want the rent-to-own option. No obligation at this point.</p>
        </div>
        <div class="step-card" style="border-left-color: var(--c3-deliver);">
          <span class="step-num m">Step 02</span>
          <h3>Fill out the rent to own conex application</h3>
          <p class="step-approval-note">There's no traditional credit check, each application is reviewed by an independent program administrator (not by Steel Box Direct) and the final decision is theirs.</p>
          <div class="step-tag step-tag-soft m">Subject to third-party approval</div>
          <figure class="rto-fig rto-step-fig" data-img-slot="application">
            <Image class="rto-fig-img" src={imgApplication} width={1000} format="webp"
              alt="Person filling out a rent to own container application on a phone at a kitchen table, with a used shipping container visible outside the window" />
            <figcaption class="rto-fig-tag m">Photo · Applying from the kitchen table</figcaption>
          </figure>
        </div>
        <div class="step-card" style="border-left-color: var(--c4-cost);">
          <span class="step-num m">Step 03</span>
          <h3>You get an answer either way</h3>
          <p>Every application gets a decision. Whether it's approved or not, we contact you with the outcome and your next step.</p>
        </div>
        <div class="step-card" style="border-left-color: var(--c2-cond);">
          <span class="step-num m">Step 04</span>
          <h3>After approval, delivery</h3>
          <p>Once your application is approved, delivery works like any other order and we'll coordinate with you on delivery. Almost all deliveries take about two weeks, and we'll give you an honest window before you commit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. TERMS -->
  <section class="rto-terms">
    <div class="wrap">
      <div class="rto-sh rto-sh-dark">
        <span class="m">Pick Your Term</span>
        <h2 class="rto-h2">Four terms. One destination: you own it.</h2>
      </div>
      <div class="rto-term-grid">
        <div class="term-chip">
          <span class="term-num">12</span>
          <span class="term-unit m">Months</span>
          <p>The shortest term: own the container in a year.</p>
        </div>
        <div class="term-chip">
          <span class="term-num">24</span>
          <span class="term-unit m">Months</span>
          <p>Two years: the middle path most buyers picture first.</p>
        </div>
        <div class="term-chip">
          <span class="term-num">36</span>
          <span class="term-unit m">Months</span>
          <p>Three years of smaller steps toward the same steel box.</p>
        </div>
        <div class="term-chip">
          <span class="term-num">48</span>
          <span class="term-unit m">Months</span>
          <p>The longest term the program offers, with the most room to spread out the payoff.</p>
        </div>
      </div>
      <figure class="rto-fig rto-fig-wide rto-fig-dark" data-img-slot="seasons">
        <Image class="rto-fig-img" src={imgSeasons} width={1600} format="webp"
          alt="Used shipping container on a gravel pad in winter snow, shown in the same spot where it stands year round on a rural property" />
        <figcaption class="rto-fig-tag m">Photo · The same spot, month after month</figcaption>
      </figure>
      <p class="rto-term-note m">Every term · no traditional credit check · subject to third-party approval</p>
      <figure class="rto-fig rto-fig-wide rto-fig-dark" data-img-slot="ownership">
        <Image class="rto-fig-img" src={imgPainting} width={1600} format="webp"
          alt="Hands repainting the corrugated side of a used shipping container on a rural property, the kind of change only an owner would make" />
        <figcaption class="rto-fig-tag m">Photo · Yours to repaint at the end of the term</figcaption>
      </figure>
    </div>
  </section>

  <!-- 3b. DOWN PAYMENT
       The anchor every RtoDownPaymentCta on the site points at, so this block has to answer the
       question the CTA raises: what the down payment is, and what has to be true to get it. Every
       figure is interpolated from src/data/rtoTerms.ts; nothing here is typed.

       It says nothing about applications, and that is deliberate. Doug's 2026-08-28 memo says no
       application or special approval is needed, the owner checked and found that everything
       observable still requires one, and he ruled that this page keeps the wording it has. So the
       approval copy in step 02, the term note, and the comparison row all stand untouched, and this
       block adds no claim that contradicts them. -->
  <section class="rto-down" id="down-payment">
    <div class="wrap">
      <div class="rto-sh">
        <span class="m">Down Payment</span>
        <h2 class="rto-h2">What you put down to start</h2>
      </div>
      <div class="down-grid">
        <div class="down-plate">
          <span class="down-figure">{RTO_TERMS.downPayment}</span>
          <span class="down-figure-note m">Down on a standard container</span>
        </div>
        <div class="down-body">
          <p class="down-lede">{RTO_DOWN_CONDITION}</p>
          <p>
            {RTO_TERMS.provider}, the independent third party that administers the program, sets that
            down payment on rent-to-own agreements from {rtoEffectiveDateLabel()} forward. It replaces
            the percentage down payment the program asked for before that date, so a quote you were
            given earlier may show the old figure.
          </p>
          <p>
            The {RTO_TERMS.distanceLimitMiles} miles is measured from the depot your container ships
            from, not from our office. Containers move out of depots all over the country, so being a
            long way from Ohio does not by itself put you in the higher tier. Give us your delivery ZIP
            and we will tell you which depot serves it.
          </p>
          <p class="down-carveout">
            Modified and specialty units, the side openers and the container offices, stay at
            {RTO_TERMS.remoteDownPayment} down whatever the distance. Steel Box Direct sells one thing,
            standard Wind &amp; Water Tight containers, so nothing in our catalog sits in that tier.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. IS IT RIGHT FOR YOU: COMPARISON -->
  <section class="rto-compare">
    <div class="wrap">
      <div class="rto-sh">
        <span class="m">Is Rent-to-Own Right for You?</span>
        <h2 class="rto-h2">Rent-to-own vs. buying outright vs. self-storage</h2>
      </div>
      <table class="rto-table">
        <caption class="rto-table-caption">Three ways to get storage, compared on what actually matters at the end.</caption>
        <thead>
          <tr>
            <th scope="col" class="rt-rowhead"><span class="m">Compare</span></th>
            <th scope="col" class="rt-rto"><span class="rt-kicker m">Program</span><span class="rt-title">Rent-to-own</span></th>
            <th scope="col"><span class="rt-kicker m">Purchase</span><span class="rt-title">Buy outright</span></th>
            <th scope="col"><span class="rt-kicker m">Rental</span><span class="rt-title">Monthly self-storage</span></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Ownership at the end</th>
            <td class="is-rto" data-label="Rent-to-own">Yes: finish your term and the container is yours</td>
            <td data-label="Buy outright">Yes: yours on day one</td>
            <td data-label="Self-storage">No: you never own the unit</td>
          </tr>
          <tr>
            <th scope="row">Upfront cost</th>
            <td class="is-rto" data-label="Rent-to-own">Lowest to start, spread across your term</td>
            <td data-label="Buy outright">One payment up front</td>
            <td data-label="Self-storage">Low to start, but it never ends</td>
          </tr>
          <tr>
            <th scope="row">Credit requirement</th>
            <td class="is-rto" data-label="Rent-to-own">No traditional credit check, application reviewed by an independent third party</td>
            <td data-label="Buy outright">None: pay in full</td>
            <td data-label="Self-storage">Varies by facility</td>
          </tr>
          <tr>
            <th scope="row">If you stop paying</th>
            <td class="is-rto" data-label="Rent-to-own">You don't keep the container; your agreement with the independent program administrator sets the terms</td>
            <td data-label="Buy outright">Nothing to stop: you already own it</td>
            <td data-label="Self-storage">You move out and keep nothing</td>
          </tr>
          <tr>
            <th scope="row">End state</th>
            <td class="is-rto" data-label="Rent-to-own">A Wind &amp; Water Tight container on your property, with the Lifetime Leak Warranty</td>
            <td data-label="Buy outright">Same container, same warranty, just paid all at once</td>
            <td data-label="Self-storage">An ongoing bill and an empty unit to hand back</td>
          </tr>
        </tbody>
      </table>
      <p class="rto-compare-note">Deciding between renting and owning at all, rather than between two ways to own? The rent vs buy calculator totals a rental over the months you need it and shows <a href="/container-rent-vs-buy-calculator/">what renting would have cost by then</a>.</p>
      <figure class="rto-fig rto-fig-wide" data-img-slot="comparison">
        <Image class="rto-fig-img" src={imgComparison} width={1600} format="webp"
          alt="Used shipping container on a private gravel pad in the foreground with a row of self-storage unit doors visible in the distance" />
        <figcaption class="rto-fig-tag m">Photo · A container on your property, self-storage across the road</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. TRUST STRIP -->
  <section class="rto-trust">
    <div class="wrap">
      <div class="rto-trust-grid">
        <div class="trust-cell">
          <span class="trust-k m">Condition</span>
          <span class="trust-v">One grade: Wind &amp; Water Tight</span>
        </div>
        <div class="trust-cell">
          <span class="trust-k m">Warranty</span>
          <span class="trust-v">Lifetime Leak Warranty applies to rent-to-own units</span>
        </div>
        <div class="trust-cell">
          <span class="trust-k m">Ownership</span>
          <span class="trust-v">Family-owned</span>
        </div>
        <div class="trust-cell">
          <span class="trust-k m">The program</span>
          <span class="trust-v">Authorised independent agent of Freedom Conex · program administered by an independent third party</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="rto-faq">
    <div class="wrap">
      <div class="rto-sh">
        <span class="m">Common Questions</span>
        <h2 class="rto-h2">Rent-to-own, answered straight</h2>
      </div>
      <div class="rto-faq-list">
        {faqs.map((f) => (
          <div class="rto-faq-item">
            <h3>{f.q}</h3>
            {f.html ? <p set:html={f.html} /> : <p>{f.a}</p>}
          </div>
        ))}
      </div>
      <figure class="rto-fig rto-fig-wide" data-img-slot="lockup">
        <Image class="rto-fig-img" src={imgLocking} width={1600} format="webp"
          alt="Hands closing the door handles and padlock on a used wind and water tight shipping container at dusk on a gravel drive" />
        <figcaption class="rto-fig-tag m">Photo · Locking up your own box at the end of the day</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. CTA -->
  <section class="rto-cta">
    <div class="wrap rto-cta-inner">
      <p class="m rto-cta-kicker">Start the process</p>
      <h2>Get your quote and pick rent-to-own when you do.</h2>
      <p class="rto-cta-body">Tell us your size and delivery zip and choose the rent-to-own option on the form. We'll get you an all-in delivered number, then point you to the application.</p>
      <div class="rto-cta-btns">
        <a href="/quote/?pay=rto" class="btn rto-btn-yellow">Start My Rent-to-Own Quote →</a>
        <a href="/shipping-containers-for-sale/" class="btn-ghost rto-ghost">Browse containers first</a>
      </div>
    </div>
  </section>

  <style>
    /* ---- HERO ---- */
    .rto-hero {
      background: var(--yellow);
      color: var(--ink);
      padding: 64px 0 72px;
      border-bottom: 2.5px solid var(--ink);
    }
    .rto-eyebrow {
      display: inline-flex; align-items: center; gap: 14px;
      border: 2px solid var(--ink); padding: 8px 14px; margin-top: 24px;
      font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    }
    .rto-eyebrow .idx { font-weight: 700; }
    .rto-eyebrow .tg { opacity: .6; }
    .rto-headline {
      font-family: var(--narrow); font-weight: 700; text-transform: uppercase;
      font-size: clamp(44px, 7.5vw, 104px); line-height: 1.02; letter-spacing: -.02em;
      margin: 32px 0 0;
    }
    .rto-headline em {
      font-style: normal; background: var(--ink); color: var(--yellow);
      padding: 0 .1em; box-decoration-break: clone; -webkit-box-decoration-break: clone;
    }
    .rto-lede {
      font-size: clamp(18px, 2vw, 22px); line-height: 1.5; font-weight: 500;
      max-width: 760px; margin: 36px 0 0;
    }

    /* ---- SHARED SECTION HEADER ---- */
    .rto-sh { border-top: 4px solid var(--ink); padding-top: 18px; margin-bottom: 40px; }
    .rto-sh .m { display: block; opacity: .55; margin-bottom: 10px; }
    .rto-sh-dark { border-top-color: var(--yellow); }
    .rto-sh-dark .m { color: var(--yellow); opacity: 1; }
    .rto-h2 {
      font-family: var(--narrow); font-weight: 700; text-transform: uppercase;
      font-size: clamp(30px, 4.5vw, 48px); line-height: 1; letter-spacing: -.01em; margin: 0;
    }

    /* ---- HOW IT WORKS ---- */
    .rto-how { padding: 72px 0; background: var(--cream); border-bottom: 1.5px solid rgba(11,15,26,.1); }
    .rto-step-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .step-card {
      background: white; border: 2px solid var(--ink); border-left: 8px solid var(--ink);
      padding: 32px; box-shadow: 8px 8px 0 var(--ink);
    }
    .step-num { display: block; opacity: .5; margin-bottom: 12px; font-weight: 700; }
    .step-card h3 {
      font-family: var(--narrow); font-weight: 700; font-size: 26px;
      text-transform: uppercase; line-height: 1.05; margin: 0 0 12px;
    }
    .step-card p { font-size: 16px; line-height: 1.55; opacity: .85; margin: 0; }
    .step-tag {
      display: inline-block; margin-top: 16px; padding: 4px 8px;
      background: var(--ink); color: var(--cream); font-weight: 500;
    }
    /* Step 2 approval framing, deliberately downplayed per owner spec:
       smaller font, no background, low-contrast #b1aca3 (owner-chosen) */
    .step-card p.step-approval-note { font-size: 14px; color: #b1aca3; opacity: 1; }
    .step-tag.step-tag-soft { background: none; color: #b1aca3; font-size: 10px; padding: 0; }

    /* ---- TERMS ---- */
    .rto-terms { padding: 72px 0; background: var(--ink); color: var(--cream); }
    .rto-terms .rto-h2 { color: var(--cream); }
    .rto-term-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .term-chip {
      background: var(--cream); color: var(--ink); border: 2.5px solid var(--ink);
      padding: 28px 24px; box-shadow: 8px 8px 0 var(--yellow);
      display: flex; flex-direction: column;
    }
    .term-num { font-family: var(--narrow); font-weight: 700; font-size: 64px; line-height: .9; }
    .term-unit { display: block; margin-top: 6px; opacity: .55; font-weight: 700; }
    .term-chip p { font-size: 14.5px; line-height: 1.5; opacity: .82; margin: 16px 0 0; }
    .rto-term-note { margin: 40px 0 0; color: var(--cream); opacity: .6; letter-spacing: .08em; line-height: 1.7; }

    /* ---- DOWN PAYMENT ----
       Cream between the dark terms section and the white comparison table, so the page keeps its
       alternation. scroll-margin-top matches .prod-action: this id is jumped to from other pages
       and the sticky header would otherwise sit on the heading. */
    .rto-down { padding: 72px 0; background: var(--cream); border-bottom: 1.5px solid rgba(11,15,26,.1); scroll-margin-top: 76px; }
    .down-grid { display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 40px; align-items: start; }
    .down-plate {
      background: white; border: 2.5px solid var(--ink); box-shadow: 8px 8px 0 var(--yellow);
      padding: 28px 24px; display: flex; flex-direction: column;
    }
    .down-figure { font-family: var(--narrow); font-weight: 700; font-size: 72px; line-height: .9; letter-spacing: -.02em; }
