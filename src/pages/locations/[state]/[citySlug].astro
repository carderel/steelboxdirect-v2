---
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cities } from '../../../data/cities';
import type { City } from '../../../data/cities';
import { centroidBySlug } from '../../../data/geoCentroids';
import { geoPricing, geoSkuKeys, type GeoSkuKey } from '../../../data/geoPricing';
import { pricing, formatPrice, effectiveSinceLabel } from '../../../data/pricing';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { state: c.stateSlug, citySlug: c.slug }, props: { city: c } }));
}

interface Props { city: City }
const { city: c } = Astro.props;

const deliveryFaqAnswer =
  c.region === 'home'
    ? `We serve ${c.delivery.counties.join(', ')} with flat-fee delivery from Cincinnati, Ohio.`
    : `We serve ${c.delivery.counties.join(', ')} with delivery from a depot in the ${c.city} area through our supplier network.`;

// THE PRICE BLOCK, and the two conditions under which any of it renders.
//
// Every figure below comes from src/data/geoPricing.ts, the module the daily harvest rewrites, and
// not one of them is typed on this page. Two things have to hold. The metro needs its publish flag
// set in src/data/geoCentroids.ts, which is the per metro kill switch and the only human owned half
// of the pair. And the feed needs a record for that metro at all, which is the gate that does the
// real work here, because it is an ABSENCE rather than a setting: before the first harvest run every
// metro is unpriced, so every city page renders exactly what it rendered before this block existed,
// and nothing had to be remembered to make that true.
//
// A metro with no centroid entry renders no price rather than throwing. A build that dies over one
// missing metro dies unattended at five in the morning, and the place that error belongs is
// geoCentroids.test.ts, which already fails on a missing entry with the slug in the message.
const centroid = centroidBySlug[c.slug];
const metroPrices = centroid && centroid.publish ? geoPricing[c.slug] : undefined;

// Display wording per size, on the same pattern as the rent vs buy calculator: the approved copy
// wording for the keys we sell, falling back to the label in pricing.ts so a fourth SKU renders a
// correct line rather than an empty one.
const SIZE_DISPLAY: Record<string, string> = {
  '20ftCargo': '20ft',
  '40ftStandard': '40ft standard',
  '40ftStandardHC': '40ft high cube',
};

interface PriceLine {
  label: string;
  delivered: number;
  pickup: number | null;
  pickupMiles: number | null;
}

// A size the metro cannot supply is dropped rather than shown, because a figure for something that
// cannot be delivered is not a price, it is the memory of one.
const priceLines: PriceLine[] = metroPrices
  ? geoSkuKeys
      .filter((k: GeoSkuKey) => metroPrices.skus[k].available)
      .map((k: GeoSkuKey) => {
        const sku = metroPrices.skus[k];
        return {
          label: SIZE_DISPLAY[k] ?? pricing[k].label,
          delivered: sku.delivered,
          pickup: sku.pickup,
          pickupMiles:
            sku.pickupDistanceMiles === null ? null : Math.round(sku.pickupDistanceMiles),
        };
      })
  : [];

const showPrice = priceLines.length > 0;

// One date for the block, and it is the LATEST change among the figures on display rather than the
// earliest. Every figure shown has held since that date, so one sentence is true of all of them.
// The earliest would claim the newest figure had held longer than it has, which overstates
// stability, and a date per figure would put three dates in a block whose job is to state a number
// plainly. Understating how long a price has held is the conservative direction of the two.
//
// This same date is handed to BaseLayout as dateModified. Stated honestly, that is INERT today: the
// city branch of the schema builder emits Service, FAQPage, WebPage and BreadcrumbList, none of
// which carries a date, so nothing renders from it. It is passed anyway because the alternative is
// worse. The moment that branch gains a dated node it would fall through to the March 2026 default
// that the guide branch uses, and a page whose visible copy states one date while its graph states
// another is the contradiction this whole workstream exists to avoid. The prop costs one line and
// removes that failure mode in advance.
const priceEffectiveSince = metroPrices
  ? geoSkuKeys
      .filter((k: GeoSkuKey) => metroPrices.skus[k].available)
      .map((k: GeoSkuKey) => metroPrices.skus[k].effectiveSince)
      .reduce((latest, date) => (date.localeCompare(latest) > 0 ? date : latest), '')
  : '';

const priceZip = centroid ? centroid.zip : '';

// Pickup is a different quantity, not the delivered figure with the delivery taken back off: the
// live feed returns pickup unit prices that are sometimes HIGHER than the delivery unit price for
// the same size. So the page publishes both numbers and refuses the subtraction. A reader who wants
// the difference can take it, and the difference they take will be right, which is more than any
// rule this page could state about it would be.
const pickupLines = priceLines.filter(
  (line): line is PriceLine & { pickup: number } => line.pickup !== null,
);

// The QuickFacts payload, handed over only when there is a figure to hand over. Absence is the
// signal: it is what tells the builder to print no price cells and to leave the price disclaimer
// off, so no second condition is written there. The headline figure is the first line on display,
// which is the smallest size the metro can supply.
const cityPrice = showPrice
  ? {
      zip: priceZip,
      delivered: priceLines[0].delivered,
      sizeLabel: priceLines[0].label,
      effectiveSince: priceEffectiveSince,
    }
  : undefined;
---

<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  pageType="guide"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Locations', path: '/locations/' },
    { name: c.state },
    { name: c.city },
  ]}
  dateModified={priceEffectiveSince || undefined}
  schema={{ kind: 'city', city: c, faqs: [
    { q: `Do you deliver shipping containers to ${c.city}, ${c.state}?`, a: `Yes. We deliver to ${c.delivery.counties.join(', ')} and surrounding areas. ${c.delivery.body}` },
    { q: `What areas near ${c.city} do you serve?`, a: deliveryFaqAnswer },
    { q: `How quickly can I get a container quote in ${c.city}?`, a: c.cta.body },
  ], ...(cityPrice ? { price: cityPrice } : {}) }}
>

  <section class="local-hero">
    <div class="wrap">
      <div class="sh local_hero_eyebrow">
        <span class="idx">Region</span>
        <span class="nm">{c.eyebrow}</span>
        <span class="tg">Local Delivery Expert</span>
      </div>
      <h1 class="big local_hero_headline">Shipping &amp; Storage Containers<br>in <em>{c.city}.</em></h1>
      <p class="lede local_hero_lede">{c.lede}</p>
    </div>
  </section>

  {showPrice && (
    <section class="local-price">
      <div class="wrap">
        <div class="price-band">
          <div class="m local_price_label">Delivered price</div>
          <h2 class="local_price_headline">What a container costs in {c.city}.</h2>

          <ul class="price-lines">
            {priceLines.map((line) => (
              <li class="local_price_line">
                <span class="local_price_figure">{formatPrice(line.delivered)}</span>
                <span class="local_price_scope">delivered to {priceZip} for a {line.label}</span>
              </li>
            ))}
          </ul>

          <p class="local_price_allin">
            That is the container and the delivery together, with nothing added later.
            {priceLines.length > 1 ? ' These prices have' : ' This price has'} been in effect since {effectiveSinceLabel(priceEffectiveSince)}.
          </p>
          <p class="local_price_hedge">
            Your ZIP will be different from the one we price from, and delivery distance is most of
            what moves the number, so call and we will run yours.
          </p>

          {pickupLines.length > 0 && (
            <details class="local-pickup">
              <summary>Would you rather pick it up yourself?</summary>
              <div class="local_pickup_body">
                <p>
                  If you would rather collect it yourself, we can do that. Pickup is priced
                  differently from delivery and it is not the delivery fee taken back off, so here
                  are both numbers side by side.
                </p>
                <ul class="pickup-lines">
                  {pickupLines.map((line) => (
                    <li class="local_pickup_line">
                      <span class="local_pickup_size">{line.label}</span>
                      <span class="local_pickup_figures">
                        {formatPrice(line.delivered)} delivered, or {formatPrice(line.pickup)} collected
                        {line.pickupMiles !== null && <> from a yard about {line.pickupMiles} miles out</>}.
                      </span>
                    </li>
                  ))}
                </ul>
                <p>
                  Which sizes are sitting at a nearby yard changes week to week, and the closest yard
                  for one size is not always the closest yard for another. Call and we will check what
                  is there and tell you where it is before you commit to the drive.
                </p>
              </div>
            </details>
          )}
        </div>
      </div>
    </section>
  )}

  {c.region === 'depot' && (
    <section class="local-bridge">
      <div class="wrap">
        <div class="bridge-band">
          <div class="m local_bridge_label">How we serve {c.city}</div>
          <p class="local_bridge_body">
            Steel Box Direct is a family-run dealer headquartered near Cincinnati — Ohio, Indiana, and Kentucky are our home delivery region. {c.city} is one of the markets we fulfill through our supplier network, from a depot right in the area: same containers, same Lifetime Leak Warranty, same person handling your quote. Sourcing from a local yard instead of hauling steel across the country keeps freight short — and short freight is what keeps our pricing structure low.
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="local-details">
    <div class="wrap">
      <div class="grid local_details_grid">

        <div class="card local_details_delivery_card">
          <div class="m local_card_label">Delivery Areas</div>
          <h3 class="local_card_headline">{c.delivery.headline}</h3>
          <p class="local_card_body">{c.delivery.body}</p>
          <ul class="check-list local_card_county_list">
            {c.delivery.counties.map((county) => <li>{county}</li>)}
          </ul>
        </div>

        <div class="card local_details_card_2">
          <iframe
            class="local-map"
            src={`https://www.openstreetmap.org/export/embed.html?bbox=${c.map.bbox}&layer=mapnik&marker=${c.map.marker}`}
            title={c.map.title}
            loading="lazy"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

  <section class="local-content">
    <div class="wrap">
      <div class="row">
        <div class="main-col local_content_main">
          <h2>{c.content.h2}</h2>
          <p>{c.content.intro}</p>
          {c.content.features.map((f) => (
            <div class="feature local_feature">
              <h3 class="local_feature_headline">{f.title}</h3>
              <p class="local_feature_body">{f.body}</p>
            </div>
          ))}
        </div>
        <aside class="side-col local_content_sidebar">
          <div class="m-card local_stats_card">
            <div class="m">Local Stats</div>
            {c.stats.map((s) => (
              <div class="stat local_stat">
                <span class="v local_stat_value">{s.value}</span>
                <span class="l local_stat_label">{s.label}</span>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="local-uses">
    <div class="wrap">
      <div class="m local_uses_label">Common uses in {c.city}</div>
      <p class="local_uses_intro">{c.usesIntro}</p>
      <div class="uses-grid">
        {c.commonUses.map((u) => (
          <a class="use-card" href={`/for/${u.persona}/`}>
            <span class="use-label">{u.label}</span>
            <span class="use-persona">For {u.persona} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="local-zoning">
    <div class="wrap">
      <div class="m local_zoning_label">Permits &amp; zoning</div>
      <p class="local_zoning_note">Zoning and permit rules are set by your local authority and are the buyer's responsibility to confirm before you buy. Start with the offices below:</p>
      <ul class="zoning-list">
        {c.zoning.map((z) => (
          <li>
            <a href={z.url} target="_blank" rel="noopener nofollow">{z.county} — {z.office}</a>
          </li>
        ))}
      </ul>
      <p class="local_zoning_zips">Primary ZIPs served: {c.primaryZips.join(' · ')}</p>
    </div>
  </section>

  <section class="cta-section">
    <div class="wrap">
      <div class="cta-box local_cta_box">
        <h2 class="local_cta_headline">{c.cta.headline}</h2>
        <p class="local_cta_body">{c.cta.body}</p>
        <a href="/quote/" class="btn local_cta_btn">
          Get My Local Quote
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .big { font-family: var(--narrow); font-weight: 700; font-size: clamp(48px, 10vw, 80px); line-height: .9; letter-spacing: -.02em; text-transform: uppercase; margin: 0; }
  .big em { font-style: italic; font-weight: 700; }
  .sh { display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: center; padding: 18px 0; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); margin-bottom: 72px; }
  .sh .idx { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: .08em; text-transform: uppercase; }
  .sh .nm { font-family: var(--narrow); font-weight: 700; font-size: 22px; text-transform: uppercase; letter-spacing: -.01em; }
  .sh .tg { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: .08em; text-transform: uppercase; opacity: .55; text-align: right; }

  .local-hero { padding: 120px 0 80px; background: var(--yellow); border-bottom: 2.5px solid var(--ink); }
  .lede { font-size: 24px; line-height: 1.4; max-width: 800px; margin-top: 32px; font-weight: 500; }

  .local-price { padding: 72px 0 64px; background: white; border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .price-band { max-width: 880px; }
  .local_price_label { margin-bottom: 12px; }
  .local_price_headline { font-family: var(--narrow); font-weight: 700; font-size: clamp(30px, 5vw, 44px); text-transform: uppercase; letter-spacing: -.01em; line-height: .95; margin: 0 0 28px; }
  .price-lines { list-style: none; padding: 0; margin: 0 0 28px; border-top: 2.5px solid var(--ink); }
  .local_price_line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; padding: 16px 0; border-bottom: 1.5px solid rgba(11,15,26,.15); }
  .local_price_figure { font-family: var(--narrow); font-weight: 700; font-size: 40px; line-height: 1; letter-spacing: -.02em; }
  .local_price_scope { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; opacity: .72; }
  .local_price_allin { font-size: 18px; line-height: 1.5; font-weight: 500; margin: 0 0 10px; }
  .local_price_hedge { font-size: 16px; line-height: 1.6; margin: 0; opacity: .8; max-width: 720px; }
  .local-pickup { margin-top: 28px; border-left: 4px solid var(--yellow); padding-left: 20px; }
  .local-pickup summary { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .local_pickup_body { margin-top: 14px; }
  .local_pickup_body p { font-size: 15px; line-height: 1.6; opacity: .85; margin: 0 0 14px; max-width: 720px; }
  .pickup-lines { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 8px; }
  .local_pickup_line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .local_pickup_size { font-family: var(--narrow); font-weight: 700; font-size: 16px; text-transform: uppercase; min-width: 110px; }
  .local_pickup_figures { font-size: 15px; line-height: 1.5; }

  .local-bridge { padding: 56px 0; background: white; border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .bridge-band { border-left: 4px solid var(--yellow); padding-left: 24px; max-width: 860px; }
  .local_bridge_label { margin-bottom: 12px; }
  .local_bridge_body { font-size: 17px; line-height: 1.6; margin: 0; opacity: .85; }

  .local-details { padding: 96px 0; background: var(--cream); border-bottom: 1.5px solid rgba(11,15,26,.1); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .card { background: white; border: 2.5px solid var(--ink); padding: 40px; box-shadow: 8px 8px 0 var(--ink); }
  .card h3 { font-family: var(--narrow); font-size: 32px; text-transform: uppercase; margin: 16px 0; }

  .check-list { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .check-list li { font-family: var(--mono); font-size: 11px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; letter-spacing: .05em; }
  .check-list li::before { content: "✓"; color: var(--c4-cost); font-weight: 800; }

  .local_details_card_2 { padding: 0; overflow: hidden; }
  .local-map { width: 100%; height: 100%; min-height: 320px; display: block; border: none; }

  .local-content { padding: 96px 0; background: white; }
  .row { display: grid; grid-template-columns: 2fr 1fr; gap: 80px; }
  .main-col h2 { font-family: var(--narrow); font-size: 40px; text-transform: uppercase; margin-bottom: 24px; }
  .feature { margin-top: 40px; border-left: 4px solid var(--yellow); padding-left: 24px; }
  .feature h3 { font-family: var(--narrow); font-size: 22px; text-transform: uppercase; margin-bottom: 8px; }
  .feature p { opacity: .8; line-height: 1.5; }

  .m-card { background: var(--ink); color: white; padding: 32px; border: 2.5px solid var(--ink); }
  .m-card .m { color: var(--yellow); margin-bottom: 24px; }
  .stat { margin-bottom: 24px; }
  .stat:last-child { margin-bottom: 0; }
  .stat .v { display: block; font-family: var(--narrow); font-size: 44px; font-weight: 700; color: var(--yellow); line-height: 1; }
  .stat .l { font-family: var(--mono); font-size: 10px; text-transform: uppercase; opacity: .6; letter-spacing: .1em; margin-top: 4px; display: block; }

  .cta-section { padding: 80px 0 120px; background: var(--cream); }
  .cta-box { background: var(--ink); color: var(--cream); padding: 64px; text-align: center; border: 2.5px solid var(--ink); box-shadow: 12px 12px 0 var(--yellow); }
  .cta-box h2 { font-family: var(--narrow); font-size: 48px; text-transform: uppercase; margin-bottom: 16px; }
  .cta-box p { font-size: 18px; opacity: .8; margin-bottom: 40px; }

  @media (max-width: 960px) { .row { grid-template-columns: 1fr; gap: 48px; } }
  @media (max-width: 768px) {
    .sh { grid-template-columns: auto 1fr; row-gap: 6px; }
    .sh .tg { grid-column: 1 / -1; text-align: left; opacity: .5; }
    .grid { grid-template-columns: 1fr; }
    .card h3 { font-size: 24px; }
    .cta-box { padding: 40px 24px; }
    .cta-box h2 { font-size: 32px; }
    .local-bridge { padding: 40px 0; }
    .local_bridge_body { font-size: 15px; }
  }

  .local-uses { padding: 80px 0; background: var(--cream); border-top: 1.5px solid rgba(11,15,26,.1); }
  .local_uses_intro { font-size: 18px; line-height: 1.5; max-width: 760px; margin: 12px 0 32px; }
  .uses-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .use-card { display: flex; flex-direction: column; gap: 8px; background: white; border: 2.5px solid var(--ink); padding: 20px; box-shadow: 6px 6px 0 var(--ink); transition: transform .15s, box-shadow .15s; }
  .use-card:hover { transform: translate(-2px,-2px); box-shadow: 8px 8px 0 var(--yellow); }
  .use-label { font-family: var(--narrow); font-weight: 700; font-size: 18px; text-transform: uppercase; line-height: 1.05; }
  .use-persona { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; opacity: .6; }
  .local-zoning { padding: 80px 0; background: white; border-top: 1.5px solid rgba(11,15,26,.1); }
  .zoning-list { list-style: none; padding: 0; margin: 16px 0 24px; display: grid; gap: 10px; }
  .zoning-list a { font-family: var(--mono); font-size: 13px; border-bottom: 1.5px solid currentColor; padding-bottom: 2px; }
  .zoning-list a:hover { color: var(--c5-permits); }
  .local_zoning_zips { font-family: var(--mono); font-size: 12px; opacity: .7; }

  @media (max-width: 768px) {
    .local-price { padding: 48px 0 44px; }
    .local_price_figure { font-size: 32px; }
    .local_price_allin { font-size: 16px; }
    .local_pickup_size { min-width: 0; }
  }
</style>
